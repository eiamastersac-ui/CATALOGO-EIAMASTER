---
import { ctaFinal, marca } from '../datos/clinica.js';
import Icono from '../componentes/Icono.astro';
---

<section class="dr-ctaf">
  <div class="dr-wrap dr-ctaf__grid">
    <div class="dr-ctaf__texto dr-reveal">
      <h2>{ctaFinal.titulo}</h2>
      <p>{ctaFinal.sub}</p>
      <ul class="dr-ctaf__checks">
        {ctaFinal.checks.map((c: string) => (
          <li><Icono nombre="check" size={16} /> {c}</li>
        ))}
      </ul>
      <div class="dr-ctaf__acciones">
        <a href="#preguntas" class="dr-btn dr-btn--navy">{ctaFinal.cta1}</a>
        <a href={marca.whatsappHref} target="_blank" rel="noopener" class="dr-ctaf__whats">
          <Icono nombre="whatsapp" size={16} /> {ctaFinal.cta2}
        </a>
      </div>
    </div>

    <div class="dr-ctaf__foto dr-reveal dr-reveal--2">
      <img src={ctaFinal.img} alt="Equipo de tu tienda.com Red Dental" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .dr-ctaf {
    background: var(--dr-tinta);
  }

  .dr-ctaf__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    min-height: 26rem;
  }

  .dr-ctaf__texto {
    padding-block: clamp(2.5rem, 6vw, 3.5rem);
    padding-right: clamp(1.5rem, 4vw, 3rem);
  }

  .dr-ctaf__texto h2 {
    color: #fff;
    font-size: clamp(1.7rem, 3.6vw, 2.4rem);
    margin-bottom: 1rem;
  }

  .dr-ctaf__texto p {
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 1.5rem;
  }

  .dr-ctaf__checks {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }

  .dr-ctaf__checks li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: #fff;
    font-weight: 600;
    font-size: 0.92rem;
  }

  .dr-ctaf__checks svg {
    color: var(--dr-azul);
    background: rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    padding: 0.2rem;
    box-sizing: content-box;
    flex-shrink: 0;
  }

  .dr-ctaf__acciones {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .dr-ctaf__whats {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: underline;
  }

  .dr-ctaf__foto {
    height: 100%;
    min-height: 22rem;
  }

  .dr-ctaf__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 780px) {
    .dr-ctaf__grid {
      grid-template-columns: 1fr;
    }

    .dr-ctaf__texto {
      padding-right: 0;
    }

    .dr-ctaf__foto {
      order: -1;
      aspect-ratio: 16 / 9;
      min-height: 0;
    }
  }
</style>
