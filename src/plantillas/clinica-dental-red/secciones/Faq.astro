---
import { faq } from '../datos/clinica.js';
import Icono from '../componentes/Icono.astro';

interface Pregunta {
  p: string;
  r: string;
}
const lista = faq as Pregunta[];
---

<section class="dr-seccion dr-wrap" id="preguntas">
  <div class="dr-cab dr-centro dr-reveal">
    <span class="dr-kicker dr-centro">Preguntas frecuentes</span>
    <h2 class="dr-titulo dr-centro">Resolvemos tus dudas</h2>
  </div>

  <div class="dr-faq dr-reveal dr-reveal--2">
    {lista.map((f: Pregunta) => (
      <details class="dr-faq__item">
        <summary>
          {f.p}
          <span class="dr-faq__toggle">
            <span class="dr-faq__mas"><Icono nombre="mas" size={16} /></span>
            <span class="dr-faq__menos"><Icono nombre="menos" size={16} /></span>
          </span>
        </summary>
        <p>{f.r}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .dr-cab {
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
  }

  .dr-faq {
    max-width: 44rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .dr-faq__item {
    border: 1.5px solid var(--dr-linea);
    border-radius: var(--dr-pill);
    padding: 1.1rem 1.5rem;
    transition: border-color 0.2s ease;
  }

  .dr-faq__item[open] {
    border-color: var(--dr-navy);
    border-radius: 20px;
  }

  .dr-faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 700;
    font-size: 0.94rem;
    color: var(--dr-tinta);
    cursor: pointer;
    list-style: none;
  }

  .dr-faq__item summary::-webkit-details-marker {
    display: none;
  }

  .dr-faq__toggle {
    flex-shrink: 0;
    color: var(--dr-navy);
  }

  .dr-faq__menos {
    display: none;
  }

  .dr-faq__item[open] .dr-faq__mas {
    display: none;
  }

  .dr-faq__item[open] .dr-faq__menos {
    display: block;
  }

  .dr-faq__item p {
    color: var(--dr-texto);
    font-size: 0.87rem;
    margin-top: 0.9rem;
  }
</style>
