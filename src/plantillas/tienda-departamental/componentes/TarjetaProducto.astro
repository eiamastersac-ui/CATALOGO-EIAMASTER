---
import { soles } from '../datos/nordstrom.js';

interface Producto {
  nombre: string;
  marca: string;
  precio: number;
  antes?: number;
  img: string;
  popular?: boolean;
}
const { producto } = Astro.props as { producto: Producto };
---

<article class="nd-prod">
  <div class="nd-prod__media">
    <button type="button" class="nd-prod__fav" aria-label="Agregar a favoritos">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s-7-4.35-9.5-8.5C.8 9 2 5 6 5c2 0 3.5 1.2 4 2.5C10.5 6.2 12 5 14 5c4 0 5.2 4 3.5 7.5C19 16.65 12 21 12 21z"></path></svg>
    </button>
    <img src={producto.img} alt={producto.nombre} loading="lazy" decoding="async" />
    <button type="button" class="nd-btn nd-btn--oscuro nd-prod__add">Add to Bag</button>
  </div>
  <div class="nd-prod__body">
    {producto.popular && <p class="nd-prod__tag">Popular</p>}
    <p class="nd-prod__marca">{producto.marca}</p>
    <h3 class="nd-prod__nombre">{producto.nombre}</h3>
    <p class="nd-prod__precio">
      <b>{soles(producto.precio)}</b>
      {producto.antes && <s>{soles(producto.antes)}</s>}
    </p>
  </div>
</article>

<style>
  .nd-prod {
    display: flex;
    flex-direction: column;
  }

  .nd-prod__media {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--nd-gris-claro);
    overflow: hidden;
  }

  .nd-prod__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nd-prod__fav {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    z-index: 1;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #fff;
    display: grid;
    place-items: center;
  }

  .nd-prod__fav.is-on {
    color: var(--nd-rojo);
  }

  .nd-prod__add {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.75rem;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .nd-prod:hover .nd-prod__add {
    opacity: 1;
    transform: translateY(0);
  }

  .nd-prod__add.is-ok {
    background: #2c8a4d;
  }

  .nd-prod__body {
    padding-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .nd-prod__tag {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--nd-gris);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 0.15rem;
  }

  .nd-prod__marca {
    font-size: 0.82rem;
    font-weight: 700;
  }

  .nd-prod__nombre {
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--nd-gris);
  }

  .nd-prod__precio {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    margin-top: 0.2rem;
  }

  .nd-prod__precio b {
    font-size: 0.85rem;
  }

  .nd-prod__precio s {
    color: var(--nd-gris);
    font-size: 0.76rem;
  }

  @media (max-width: 700px) {
    .nd-prod__add {
      opacity: 1;
      transform: none;
      position: static;
      margin-top: 0.5rem;
      width: 100%;
    }
  }
</style>
