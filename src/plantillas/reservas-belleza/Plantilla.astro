---
import './estilos.css';

import Cabecera from './secciones/Cabecera.astro';
import Hero from './secciones/Hero.astro';
import Recomendado from './secciones/Recomendado.astro';
import Apps from './secciones/Apps.astro';
import Ventajas from './secciones/Ventajas.astro';
import Ciudades from './secciones/Ciudades.astro';
import Blog from './secciones/Blog.astro';
import PiePagina from './secciones/PiePagina.astro';
import ModalReserva from './secciones/ModalReserva.astro';
---

<div class="tpl-reservas-belleza">
  <Cabecera />
  <main>
    <Hero />
    <Recomendado />
    <Apps />
    <Ventajas />
    <Ciudades />
    <Blog />
  </main>
  <PiePagina />
  <ModalReserva />
</div>
