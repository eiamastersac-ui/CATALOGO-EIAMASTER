---
import { blog, u } from '../datos/reservas.js';
---

<section class="rb-blog" id="blog">
  <div class="rb-wrap">
    <h2 class="rb-h2 rb-blog__tit">Recomendado para ti</h2>
    <div class="rb-blog__carril">
      <button type="button" class="rb-flecha rb-flecha--prev" id="rb-blog-prev" aria-label="Anterior" disabled>
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
      </button>
      <div class="rb-fila rb-blog__fila" id="rb-blog-fila">
        {blog.map((b: { t: string; img: string }) => (
          <a href="#blog" class="rb-post">
            <span class="rb-post__foto"><img src={u(b.img, 720, 405)} alt={b.t} loading="lazy" /></span>
            <span class="rb-post__t">{b.t}</span>
          </a>
        ))}
      </div>
      <button type="button" class="rb-flecha rb-flecha--next" id="rb-blog-next" aria-label="Siguiente">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </button>
    </div>
  </div>
</section>

<script>
  const fila = document.getElementById('rb-blog-fila');
  const prev = document.getElementById('rb-blog-prev') as HTMLButtonElement | null;
  const next = document.getElementById('rb-blog-next') as HTMLButtonElement | null;
  const upd = () => {
    if (!fila || !prev || !next) return;
    prev.disabled = fila.scrollLeft < 8;
    next.disabled = fila.scrollLeft + fila.clientWidth >= fila.scrollWidth - 8;
  };
  const paso = () => (fila?.clientWidth || 600) * 0.66;
  prev?.addEventListener('click', () => fila?.scrollBy({ left: -paso(), behavior: 'smooth' }));
  next?.addEventListener('click', () => fila?.scrollBy({ left: paso(), behavior: 'smooth' }));
  fila?.addEventListener('scroll', upd, { passive: true });
  window.addEventListener('resize', upd);
  upd();
</script>

<style>
  .rb-blog { padding: 70px 0 110px; scroll-margin-top: var(--rb-hdr); }
  .rb-blog__tit { margin-bottom: 30px; }
  .rb-blog__carril { position: relative; }
  .rb-blog__carril .rb-blog__fila { grid-auto-columns: calc((100% - 32px) / 3); }
  .rb-post {
    display: flex;
    flex-direction: column;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 4px 14px rgba(0,0,0,.1);
    overflow: hidden;
  }
  .rb-post__foto { display: block; aspect-ratio: 16 / 9; overflow: hidden; }
  .rb-post__foto img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
  .rb-post:hover .rb-post__foto img { transform: scale(1.05); }
  .rb-post__t {
    padding: 18px 20px 22px;
    font-size: .98rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .rb-blog__carril .rb-flecha { top: 26%; }
  @media (max-width: 900px) {
    .rb-blog__carril .rb-blog__fila { grid-auto-columns: calc((100% - 16px) / 2); }
  }
  @media (max-width: 600px) {
    .rb-blog__carril .rb-blog__fila { grid-auto-columns: 85%; }
    .rb-blog__carril .rb-flecha { display: none; }
  }
</style>
