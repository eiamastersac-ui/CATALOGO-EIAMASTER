---
import { ventajas, u } from '../datos/reservas.js';
---

<section class="rb-vent" aria-label="Por qué reservar online">
  <div class="rb-wrap">
    {ventajas.map((v: { titulo: string; parrafos: string[]; cierre: string; img: string; alt: string }, i: number) => (
      <div class={`rb-vent__fila${i % 2 === 1 ? ' rb-vent__fila--inv' : ''}`}>
        <div class="rb-vent__tx">
          <h3>{v.titulo}</h3>
          {v.parrafos.map((p: string) => <p>{p}</p>)}
          {v.cierre && <p><strong>{v.cierre}</strong></p>}
        </div>
        <figure class="rb-vent__foto">
          <img src={u(v.img, 760, 900)} alt={v.alt} loading="lazy" />
          <span class="rb-vent__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        </figure>
      </div>
    ))}
  </div>
</section>

<style>
  .rb-vent { padding: 40px 0 0; }
  .rb-vent__fila {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 40px;
    margin-top: 110px;
  }
  .rb-vent__fila--inv .rb-vent__tx { order: 2; }
  .rb-vent__fila--inv .rb-vent__foto { order: 1; }
  .rb-vent__tx { padding: 32px; }
  .rb-vent__tx h3 {
    margin-bottom: 56px;
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.12;
  }
  .rb-vent__tx p {
    font-size: 1.1rem;
    line-height: 1.65;
    max-width: 520px;
  }
  .rb-vent__tx p + p { margin-top: 1.4em; }
  .rb-vent__foto {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 376px;
    aspect-ratio: 376 / 440;
    border-radius: 14px;
    overflow: hidden;
  }
  .rb-vent__foto img { width: 100%; height: 100%; object-fit: cover; }
  .rb-vent__num {
    position: absolute;
    left: 14px;
    bottom: 12px;
    padding: 4px 10px;
    border-radius: 999px;
    background: #fff;
    font-size: .78rem;
    font-weight: 800;
    border: 2px solid var(--rb-cian);
  }
  @media (max-width: 860px) {
    .rb-vent__fila { grid-template-columns: 1fr; gap: 20px; margin-top: 56px; }
    .rb-vent__fila--inv .rb-vent__tx { order: 1; }
    .rb-vent__fila--inv .rb-vent__foto { order: 2; }
    .rb-vent__tx { padding: 0; }
    .rb-vent__tx h3 { margin-bottom: 20px; }
  }
</style>
