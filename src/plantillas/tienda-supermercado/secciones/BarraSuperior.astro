---
import { barraMensaje } from '../datos/saludable.js';
---

<div class="sa-barra">
  <p>{barraMensaje}</p>
</div>

<style>
  .sa-barra {
    background: var(--sa-oro);
    color: #fff;
    text-align: center;
    padding-block: 0.55rem;
  }

  .sa-barra p {
    font-family: var(--sa-display);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.01em;
    padding-inline: 1rem;
  }
</style>
