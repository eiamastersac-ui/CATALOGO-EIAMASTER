---
import { marca } from '../datos/saludable.js';
---

<section class="sa-wrap">
  <div class="sa-filtro">
    <svg class="sa-filtro__hoja" width="70" height="90" viewBox="0 0 70 90" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M35 5C10 20 5 55 35 85C65 55 60 20 35 5Z"></path>
      <path d="M35 10v70"></path>
    </svg>

    <div class="sa-filtro__cuerpo">
      <span class="sa-filtro__lupa" aria-hidden="true">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </span>
      <div>
        <p class="sa-filtro__kicker">Filtro de selección</p>
        <p class="sa-filtro__texto">Leímos todas las etiquetas, para quedarnos solo con lo mejor</p>
        <a href="#lo-nuevo" class="sa-btn sa-btn--claro">ver más aquí</a>
        <p class="sa-filtro__marca">{marca.nombre} {marca.sub}</p>
      </div>
    </div>

    <svg class="sa-filtro__semillas" width="90" height="90" viewBox="0 0 90 90" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M20 20c30 0 50 20 50 50" stroke-dasharray="2 6"></path>
      <ellipse cx="70" cy="15" rx="6" ry="10" transform="rotate(30 70 15)"></ellipse>
      <ellipse cx="55" cy="10" rx="5" ry="8" transform="rotate(-10 55 10)"></ellipse>
    </svg>
  </div>
</section>

<style>
  .sa-filtro {
    position: relative;
    background: linear-gradient(120deg, var(--sa-rojo), #a5203c);
    color: #fff;
    border-radius: 4px;
    padding: clamp(1.5rem, 4vw, 2.25rem) clamp(1.5rem, 5vw, 4rem);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    min-height: 140px;
  }

  .sa-filtro__hoja {
    position: absolute;
    left: clamp(0.5rem, 3vw, 2rem);
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.25);
    display: none;
  }

  .sa-filtro__semillas {
    position: absolute;
    right: clamp(0.5rem, 3vw, 2rem);
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.3);
    display: none;
  }

  .sa-filtro__cuerpo {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    text-align: left;
    flex-wrap: wrap;
    justify-content: center;
  }

  .sa-filtro__lupa {
    flex-shrink: 0;
  }

  .sa-filtro__kicker {
    font-family: var(--sa-display);
    font-weight: 900;
    font-size: 1.1rem;
    text-transform: uppercase;
  }

  .sa-filtro__texto {
    font-family: var(--sa-display);
    font-weight: 700;
    font-size: clamp(1rem, 2.2vw, 1.3rem);
    text-transform: uppercase;
    margin: 0.35rem 0 0.9rem;
    max-width: 30ch;
  }

  .sa-filtro__marca {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-top: 0.6rem;
    opacity: 0.85;
  }

  @media (min-width: 760px) {
    .sa-filtro__hoja,
    .sa-filtro__semillas {
      display: block;
    }
  }
</style>
