---
import { soles } from '../datos/saludable.js';

interface Producto {
  marca: string;
  nombre: string;
  precio: number;
  antes?: number;
  img: string;
  nuevo?: boolean;
  advertencia?: string;
}
const { producto } = Astro.props as { producto: Producto };
const descuento = producto.antes ? Math.round((1 - producto.precio / producto.antes) * 100) : null;
---

<article class="sa-prod" data-nombre={producto.nombre.toLowerCase()} data-precio={producto.precio}>
  <div class="sa-prod__media">
    {producto.nuevo && <span class="sa-prod__badge">Lo Nuevo</span>}
    {descuento && <span class="sa-prod__desc">-{descuento}%</span>}
    {producto.advertencia && <span class="sa-octagono">{producto.advertencia}</span>}
    <button type="button" class="sa-prod__fav" aria-label="Agregar a favoritos">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M12 21s-7-4.5-9.5-9C.5 8 2 4 6 4c2 0 3.5 1 6 3.5C14.5 5 16 4 18 4c4 0 5.5 4 3.5 8-2.5 4.5-9.5 9-9.5 9Z"></path>
      </svg>
    </button>
    <img src={producto.img} alt={producto.nombre} loading="lazy" decoding="async" />
  </div>
  <div class="sa-prod__body">
    <p class="sa-prod__marca">{producto.marca}</p>
    <h3 class="sa-prod__nombre">{producto.nombre}</h3>
    <p class="sa-prod__precio">
      <b>{soles(producto.precio)}</b>
      {producto.antes && <s>{soles(producto.antes)}</s>}
    </p>
    <div class="sa-prod__qty" role="group" aria-label="Cantidad">
      <button type="button" class="sa-qty__b" data-step="-1" aria-label="Quitar uno">-</button>
      <span class="sa-qty__n">1</span>
      <button type="button" class="sa-qty__b" data-step="1" aria-label="Agregar uno">+</button>
    </div>
    <button type="button" class="sa-btn sa-btn--negro sa-prod__add">Agregar</button>
  </div>
</article>

<style>
  .sa-prod[hidden] {
    display: none;
  }

  .sa-prod {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--sa-linea);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }

  .sa-prod:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px -22px rgba(0, 0, 0, 0.4);
  }

  .sa-prod__media {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--sa-crema);
  }

  .sa-prod__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sa-prod__badge {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    background: var(--sa-oro);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.22rem 0.6rem;
    z-index: 1;
  }

  .sa-prod__desc {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    background: var(--sa-rojo);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.22rem 0.5rem;
    z-index: 1;
  }

  .sa-octagono {
    position: absolute;
    bottom: 0.6rem;
    right: 0.6rem;
    z-index: 1;
  }

  .sa-prod__fav {
    position: absolute;
    bottom: 0.6rem;
    left: 0.6rem;
    z-index: 1;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #fff;
    display: grid;
    place-items: center;
    color: var(--sa-tinta);
    box-shadow: 0 4px 10px -4px rgba(0, 0, 0, 0.4);
  }

  .sa-prod__body {
    padding: 0.9rem 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .sa-prod__marca {
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sa-gris);
  }

  .sa-prod__nombre {
    font-size: 0.85rem;
    font-weight: 600;
    min-height: 2.5em;
  }

  .sa-prod__precio {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }

  .sa-prod__precio b {
    color: var(--sa-tinta);
    font-size: 1.05rem;
    font-weight: 800;
  }

  .sa-prod__precio s {
    color: var(--sa-gris);
    font-size: 0.78rem;
  }

  .sa-prod__qty {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .sa-qty__b {
    width: 28px;
    height: 28px;
    background: var(--sa-crema);
    color: var(--sa-tinta);
    font-weight: 700;
    line-height: 1;
    display: grid;
    place-items: center;
  }

  .sa-qty__b:hover {
    background: var(--sa-linea);
  }

  .sa-qty__n {
    min-width: 1.4ch;
    text-align: center;
    font-weight: 600;
  }

  .sa-prod__add {
    margin-top: auto;
    width: 100%;
    border-radius: 0;
  }

  .sa-prod__add.is-ok {
    background: var(--sa-oro);
  }
</style>
