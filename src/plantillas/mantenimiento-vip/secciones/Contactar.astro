---
import { contacto, paquetes, tiposVehiculo, sedes, marca, soles } from '../datos/mantenimiento.js';
import Icono from '../componentes/Icono.astro';

type Paquete = { id: string; t: string; precios: Record<string, number> };
---

<section class="mv-con mv-seccion" id="contactar">
  <div class="mv-wrap mv-con__wrap">
    <h2 class="mv-con__h2 mv-reveal">{contacto.titulo}</h2>
    <p class="mv-con__h3 mv-reveal">{contacto.sub}</p>
    <p class="mv-con__p mv-reveal">{contacto.texto}</p>

    <div class="mv-con__caja mv-reveal">
      <p class="mv-con__barra">{contacto.barra}</p>

      <form class="mv-con__form" id="mv-form" novalidate data-wa={`51${marca.telCrudo}`}>
        <label class="mv-f mv-f--2">
          <span>Nombres y apellidos</span>
          <input type="text" name="nombres" required autocomplete="name" />
        </label>
        <label class="mv-f">
          <span>Modelo</span>
          <input type="text" name="modelo" required placeholder="Ej. Yaris" />
        </label>
        <label class="mv-f">
          <span>Marca</span>
          <select name="marca" required>
            <option value="">Elige</option>
            {contacto.marcas.map((m: string) => <option>{m}</option>)}
          </select>
        </label>
        <label class="mv-f mv-f--2">
          <span>Número de teléfono</span>
          <input type="tel" name="telefono" required inputmode="tel" pattern="[0-9 ]{9,11}" placeholder="9XX XXX XXX" autocomplete="tel" />
        </label>
        <label class="mv-f mv-f--2">
          <span>Email</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <label class="mv-f mv-f--2">
          <span>Paquete</span>
          <select name="paquete" id="mv-f-paquete">
            {paquetes.map((p: Paquete) => (
              <option value={p.id} selected={p.id === 'mayor'}>{p.t}</option>
            ))}
          </select>
        </label>
        <label class="mv-f mv-f--2">
          <span>Tipo de vehículo</span>
          <select name="tipo" id="mv-f-tipo">
            {tiposVehiculo.map((t: { id: string; t: string }) => <option value={t.id}>{t.t}</option>)}
          </select>
        </label>
        <label class="mv-f mv-f--2">
          <span>Sede</span>
          <select name="sede">
            {sedes.map((s: { t: string }) => <option>{s.t}</option>)}
          </select>
        </label>
        <label class="mv-f mv-f--2">
          <span>Fecha preferida</span>
          <input type="date" name="fecha" id="mv-f-fecha" />
        </label>

        <p class="mv-con__estimado" id="mv-estimado" aria-live="polite">
          Precio estimado: <b data-precios={JSON.stringify(Object.fromEntries(paquetes.map((p: Paquete) => [p.id, p.precios])))}>{soles(paquetes[1].precios.sedan)}</b>
        </p>

        <p class="mv-con__legal">
          Autorizo el tratamiento de mis datos personales para finalidades informativas y comerciales, conforme a la política de privacidad. Sin mi autorización, no podrán comunicarse conmigo.
        </p>

        <label class="mv-con__check">
          <input type="checkbox" name="tyc" required />
          <span>Aceptar TyC</span>
        </label>

        <p class="mv-con__error" id="mv-form-error" hidden>Completa los campos marcados y acepta los términos.</p>

        <button type="submit" class="mv-cta mv-con__enviar">
          <span>Contactar<br />con un asesor</span>
        </button>
      </form>

      <div class="mv-con__ok" id="mv-form-ok" hidden>
        <span class="mv-con__ok-ico"><Icono nombre="check" size={30} trazo={2.6} /></span>
        <h3>¡Listo, <span id="mv-ok-nombre">cliente</span>!</h3>
        <p>Separamos tu <b id="mv-ok-paquete">mantenimiento mayor</b> con el descuento especial. Un asesor te llamará en menos de 30 minutos (horario {marca.horario}).</p>
        <div class="mv-con__ok-acc">
          <a href="#" target="_blank" rel="noopener" class="mv-btn-linea" id="mv-ok-wa">
            <Icono nombre="whatsapp" size={18} /> Confirmar por WhatsApp
          </a>
          <button type="button" class="mv-con__otra" id="mv-ok-otra">Registrar otro auto</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('mv-form') as HTMLFormElement | null;
  const ok = document.getElementById('mv-form-ok');
  const err = document.getElementById('mv-form-error');
  const est = document.querySelector<HTMLElement>('#mv-estimado b');
  const fecha = document.getElementById('mv-f-fecha') as HTMLInputElement | null;
  const telWa = form?.dataset.wa ?? '';
  const precios = JSON.parse(est?.dataset.precios ?? '{}') as Record<string, Record<string, number>>;
  const fmt = (n: number) => 'S/ ' + Number(n).toLocaleString('es-PE', { maximumFractionDigits: 0 });

  // fecha minima = manana
  if (fecha) {
    const d = new Date();
    d.setDate(d.getDate() + 1);
    fecha.min = d.toISOString().slice(0, 10);
  }

  function estimar() {
    if (!form || !est) return;
    const paq = (form.elements.namedItem('paquete') as HTMLSelectElement).value;
    const tipo = (form.elements.namedItem('tipo') as HTMLSelectElement).value;
    const v = precios[paq]?.[tipo];
    if (v) est.textContent = fmt(v);
  }
  form?.addEventListener('change', estimar);
  estimar();

  form?.addEventListener('submit', (e: SubmitEvent) => {
    e.preventDefault();
    if (!form) return;
    const campos = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]'));
    let valido = true;
    campos.forEach((c) => {
      const bien = c.checkValidity();
      c.closest('.mv-f, .mv-con__check')?.classList.toggle('is-error', !bien);
      if (!bien) valido = false;
    });
    if (err) err.hidden = valido;
    if (!valido) {
      form.querySelector<HTMLElement>('.is-error input, .is-error select')?.focus();
      return;
    }

    const datos = new FormData(form);
    const paqSel = form.elements.namedItem('paquete') as HTMLSelectElement;
    const tipoSel = form.elements.namedItem('tipo') as HTMLSelectElement;
    const paqTxt = paqSel.options[paqSel.selectedIndex]?.text ?? '';
    const nombre = String(datos.get('nombres') ?? '').trim().split(' ')[0];
    const nom = document.getElementById('mv-ok-nombre');
    const paqEl = document.getElementById('mv-ok-paquete');
    if (nom) nom.textContent = nombre || 'cliente';
    if (paqEl) paqEl.textContent = paqTxt.toLowerCase();

    // El mensaje de WhatsApp solo lleva datos del servicio (no datos personales)
    const msg = `Hola, quiero confirmar mi cita: ${paqTxt} para ${datos.get('marca')} ${datos.get('modelo')} (${tipoSel.options[tipoSel.selectedIndex]?.text}) en ${datos.get('sede')}${datos.get('fecha') ? ' el ' + datos.get('fecha') : ''}.`;
    const wa = document.getElementById('mv-ok-wa') as HTMLAnchorElement | null;
    if (wa) wa.href = `https://wa.me/${telWa}?text=${encodeURIComponent(msg)}`;

    form.hidden = true;
    if (ok) ok.hidden = false;
    ok?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  form?.addEventListener('input', (e: Event) => {
    (e.target as HTMLElement).closest('.is-error')?.classList.remove('is-error');
  });

  document.getElementById('mv-ok-otra')?.addEventListener('click', () => {
    form?.reset();
    estimar();
    if (form) form.hidden = false;
    if (ok) ok.hidden = true;
  });
</script>

<style>
  .mv-con__wrap {
    text-align: center;
  }

  .mv-con__h2 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 900;
    text-transform: uppercase;
  }

  .mv-con__h3 {
    font-size: clamp(1.3rem, 3vw, 2rem);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.1;
  }

  .mv-con__p {
    max-width: 46ch;
    margin: 0.8rem auto 0;
    font-size: 1rem;
  }

  .mv-con__caja {
    max-width: 560px;
    margin: 2.2rem auto 0;
    text-align: left;
  }

  .mv-con__barra {
    padding: 0.9rem 1rem;
    background: var(--mv-rojo);
    border-radius: 6px 6px 0 0;
    text-align: center;
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    font-weight: 700;
    text-transform: uppercase;
  }

  .mv-con__form {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.9rem 1rem;
    margin-top: 1.6rem;
  }

  .mv-con__form[hidden] {
    display: none;
  }

  .mv-f {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-weight: 600;
    font-size: 0.95rem;
    min-width: 0;
  }

  .mv-f--2 {
    grid-column: span 2;
  }

  .mv-f input,
  .mv-f select {
    width: 100%;
    height: 42px;
    padding: 0 0.8rem;
    border-radius: 7px;
    border: 1.5px solid transparent;
    background: #6f6f6f;
    color: #fff;
    font-size: 0.92rem;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease;
    color-scheme: dark;
  }

  .mv-f input::placeholder {
    color: #bdbdbd;
  }

  .mv-f input:focus,
  .mv-f select:focus {
    border-color: #fff;
    background: #7a7a7a;
  }

  .mv-f.is-error input,
  .mv-f.is-error select {
    border-color: var(--mv-rojo);
  }

  .mv-con__estimado {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 1rem;
    border: 1px dashed #555;
    border-radius: 8px;
    font-size: 0.9rem;
    color: var(--mv-humo);
  }

  .mv-con__estimado b {
    font-size: 1.3rem;
    color: #fff;
  }

  .mv-con__legal {
    grid-column: 1 / -1;
    text-align: center;
    font-size: 0.78rem;
    line-height: 1.45;
    margin-top: 0.4rem;
  }

  .mv-con__check {
    grid-column: 1 / -1;
    justify-self: center;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .mv-con__check input {
    width: 18px;
    height: 18px;
    accent-color: var(--mv-rojo);
  }

  .mv-con__check.is-error span {
    color: var(--mv-rojo);
  }

  .mv-con__error {
    grid-column: 1 / -1;
    text-align: center;
    color: #ff5a78;
    font-size: 0.85rem;
  }

  .mv-con__enviar {
    grid-column: 1 / -1;
    justify-self: center;
    margin-top: 0.4rem;
    font-size: 0.95rem;
    padding: 0.7rem 2.4rem;
  }

  .mv-con__ok {
    margin-top: 1.6rem;
    padding: 2rem 1.6rem;
    background: var(--mv-card);
    border-radius: 0 0 12px 12px;
    text-align: center;
  }

  .mv-con__ok-ico {
    display: inline-grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--mv-ok);
    color: #fff;
  }

  .mv-con__ok h3 {
    margin-top: 1rem;
    font-size: 1.6rem;
    text-transform: uppercase;
  }

  .mv-con__ok p {
    margin-top: 0.6rem;
    color: var(--mv-humo);
  }

  .mv-con__ok p b {
    color: #fff;
  }

  .mv-con__ok-acc {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 1.4rem;
  }

  .mv-con__otra {
    font-size: 0.85rem;
    text-decoration: underline;
    color: var(--mv-humo);
  }

  @media (max-width: 520px) {
    .mv-con__form {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
