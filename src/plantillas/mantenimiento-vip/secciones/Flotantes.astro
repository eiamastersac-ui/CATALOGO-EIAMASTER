---
import { waHref, telHref } from '../datos/mantenimiento.js';
import Icono from '../componentes/Icono.astro';
---

<a href={waHref} target="_blank" rel="noopener" class="mv-wa" aria-label="Escríbenos por WhatsApp">
  <span class="mv-wa__tip" id="mv-wa-tip">¿Cotizamos tu mantenimiento?</span>
  <Icono nombre="whatsapp" size={30} />
</a>

<!-- Barra de cita en movil: aparece al salir del hero, se oculta sobre el formulario -->
<div class="mv-barra" id="mv-barra">
  <a href={telHref} class="mv-barra__tel" aria-label="Llamar"><Icono nombre="telefono" size={20} /></a>
  <a href="#contactar" class="mv-barra__cita">Quiero una cita · 20% dscto</a>
</div>

<script>
  const tip = document.getElementById('mv-wa-tip');
  window.setTimeout(() => tip?.classList.add('is-visible'), 3000);
  window.setTimeout(() => tip?.classList.remove('is-visible'), 9000);

  const barra = document.getElementById('mv-barra');
  const hero = document.querySelector('.tpl-mantenimiento-vip #inicio');
  const form = document.querySelector('.tpl-mantenimiento-vip #contactar');
  if (barra && 'IntersectionObserver' in window) {
    const vis = new Map<Element, boolean>();
    const io = new IntersectionObserver((entradas) => {
      for (const e of entradas) vis.set(e.target, e.isIntersecting);
      const ocultar = [...vis.values()].some(Boolean);
      barra.classList.toggle('is-visible', !ocultar);
    }, { threshold: 0.05 });
    if (hero) io.observe(hero);
    if (form) io.observe(form);
  }
</script>

<style>
  .mv-wa {
    position: fixed;
    right: 1.4rem;
    bottom: 1.4rem;
    z-index: 250;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--mv-whats);
    color: #fff;
    display: grid;
    place-items: center;
    box-shadow: 0 14px 30px -12px rgba(0, 0, 0, 0.7);
    transition: transform 0.2s ease;
  }

  .mv-wa:hover {
    transform: scale(1.07);
  }

  .mv-wa__tip {
    position: absolute;
    right: 68px;
    top: 50%;
    translate: 0 -50%;
    padding: 0.55rem 0.85rem;
    border-radius: 8px;
    background: #fff;
    color: var(--mv-negro);
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 12px 26px -14px rgba(0, 0, 0, 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .mv-wa:hover .mv-wa__tip,
  .mv-wa__tip.is-visible {
    opacity: 1;
  }

  .mv-barra {
    display: none;
  }

  @media (max-width: 700px) {
    .mv-wa {
      width: 52px;
      height: 52px;
      right: 1rem;
      bottom: 1rem;
    }
    .mv-wa__tip {
      display: none;
    }
    .mv-barra {
      position: fixed;
      left: 1rem;
      right: 78px;
      bottom: 1rem;
      z-index: 240;
      display: flex;
      gap: 0.5rem;
      height: 52px;
      translate: 0 150%;
      transition: translate 0.35s ease;
    }
    .mv-barra.is-visible {
      translate: 0 0;
    }
    .mv-barra__tel {
      flex-shrink: 0;
      width: 52px;
      display: grid;
      place-items: center;
      border-radius: 8px;
      background: var(--mv-negro);
      border: 1px solid var(--mv-linea);
    }
    .mv-barra__cita {
      flex: 1;
      display: grid;
      place-items: center;
      border-radius: 8px;
      background: var(--mv-rojo);
      font-weight: 800;
      font-size: 0.85rem;
      text-transform: uppercase;
      box-shadow: 0 12px 26px -12px rgba(0, 0, 0, 0.8);
    }
  }
</style>
