---
import { marcasAuto } from '../datos/mantenimiento.js';
// Marquee infinito: la lista se duplica y el track se desplaza -50%.
const lista = [...marcasAuto, ...marcasAuto];
---

<section class="mv-marcas" id="marcas" aria-label="Marcas que atendemos">
  <h2 class="mv-marcas__t">Marcas que atendemos</h2>
  <div class="mv-marcas__viewport">
    <ul class="mv-marcas__track">
      {lista.map((m: string, i: number) => (
        <li aria-hidden={i >= marcasAuto.length ? 'true' : undefined}>{m}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .mv-marcas {
    background: var(--mv-panel);
    padding-block: 2.6rem 2.8rem;
  }

  .mv-marcas__t {
    text-align: center;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .mv-marcas__viewport {
    margin-top: 1.8rem;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .mv-marcas__track {
    display: flex;
    width: max-content;
    animation: mv-marquee 38s linear infinite;
  }

  .mv-marcas__viewport:hover .mv-marcas__track {
    animation-play-state: paused;
  }

  .mv-marcas__track li {
    padding-inline: clamp(1.4rem, 3vw, 2.6rem);
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #8c8c8c;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .mv-marcas__track li:hover {
    color: #fff;
  }

  @keyframes mv-marquee {
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mv-marcas__track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
      justify-content: center;
    }
  }
</style>
