import Importancia from './secciones/Importancia.astro';
import Marcas from './secciones/Marcas.astro';
import Servicios from './secciones/Servicios.astro';
import Paquetes from './secciones/Paquetes.astro';
import Beneficios from './secciones/Beneficios.astro';
import Testimonios from './secciones/Testimonios.astro';
import Promos from './secciones/Promos.astro';
import Faq from './secciones/Faq.astro';
import Contactar from './secciones/Contactar.astro';
import Sedes from './secciones/Sedes.astro';
