---
import { marca, footerCols } from '../datos/doctorlabs.js';
import Icono from '../componentes/Icono.astro';
---

<footer class="dl-footer">
  <div class="dl-wrap dl-footer__top">
    <div class="dl-footer__marca">
      <span class="dl-footer__wordmark">{marca.nombre.toUpperCase()} CONSULTAS</span>
      <a href="#contacto" class="dl-btn dl-btn--outline dl-btn--sm">
        <Icono nombre="whatsapp" size={15} />
        Whatsapp
      </a>
    </div>

    <div class="dl-footer__col">
      <h4>Enlaces</h4>
      <ul>
        {footerCols.enlaces.map((e: { t: string; href: string }) => (
          <li><a href={e.href}>{e.t}</a></li>
        ))}
      </ul>
    </div>

    <div class="dl-footer__col">
      <h4>Visítanos</h4>
      <ul class="dl-footer__redes">
        {footerCols.redes.map((r: string) => (
          <li><a href="#top">{r}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="dl-wrap dl-footer__legal">
    <span class="dl-footer__reclamos">Libro de reclamaciones DIGITAL</span>
    <span>© {new Date().getFullYear()} {marca.nombre}. Todos los derechos reservados.</span>
  </div>

  <div class="dl-footer__gigante" aria-hidden="true">tutienda.com</div>
</footer>

<style>
  .dl-footer {
    position: relative;
    background: var(--dl-morado-oscuro);
    color: #fff;
    overflow: hidden;
    padding-top: clamp(3rem, 7vw, 4.5rem);
  }

  .dl-footer__top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .dl-footer__marca {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.3rem;
  }

  .dl-footer__wordmark {
    font-family: var(--dl-display);
    font-weight: 800;
    font-size: clamp(1.4rem, 3vw, 2rem);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .dl-footer__col h4 {
    color: #fff;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1.1rem;
  }

  .dl-footer__col ul {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .dl-footer__col a {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.78);
  }

  .dl-footer__col a:hover {
    color: var(--dl-turquesa);
  }

  .dl-footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding-block: 1.6rem;
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.65);
    position: relative;
    z-index: 2;
  }

  .dl-footer__reclamos {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--dl-pill);
    font-weight: 700;
    color: #fff;
  }

  .dl-footer__gigante {
    font-family: var(--dl-display);
    font-weight: 800;
    font-size: clamp(4rem, 16vw, 11rem);
    line-height: 1;
    text-align: center;
    letter-spacing: -0.02em;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: clamp(0.5rem, 3vw, 1.5rem);
    user-select: none;
  }

  @media (max-width: 820px) {
    .dl-footer__top {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
