---
import { especialidades } from '../datos/doctorlabs.js';

interface Esp {
  t: string;
  img: string;
  href: string;
}
const lista = especialidades as Esp[];
---

<section class="dl-seccion dl-seccion--panel" id="cardiologia">
  <div class="dl-wrap">
    <div class="dl-especialidades__intro dl-reveal">
      <span class="dl-kicker">Servicios especializados</span>
      <h2 class="dl-titulo">Servicios especializados para mejorar tu salud</h2>
      <p class="dl-parrafo">
        Somos un centro especializado en cardiología, ecografías, laboratorio clínico y rayos X, con doctores
        enfocados en garantizar un servicio profesional y humanitario.
      </p>
    </div>

    <div class="dl-especialidades__grid">
      {lista.map((e: Esp, i: number) => (
        <a href={e.href} class={`dl-especialidades__card dl-reveal dl-reveal--d${i}`}>
          <img src={e.img} alt={e.t} loading="lazy" />
          <span class="dl-especialidades__scrim" aria-hidden="true"></span>
          <span class="dl-especialidades__t">{e.t}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .dl-especialidades__intro {
    max-width: 42rem;
    margin-bottom: 2.5rem;
  }

  .dl-especialidades__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .dl-especialidades__card {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    border-radius: 16px;
    overflow: hidden;
  }

  .dl-especialidades__card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .dl-especialidades__card:hover img {
    transform: scale(1.06);
  }

  .dl-especialidades__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(91, 30, 105, 0) 40%, rgba(60, 15, 70, 0.85) 100%);
  }

  .dl-especialidades__t {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.1rem;
    text-align: center;
    color: #fff;
    font-family: var(--dl-display);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding-inline: 0.5rem;
  }

  @media (max-width: 820px) {
    .dl-especialidades__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .dl-especialidades__grid {
      grid-template-columns: 1fr;
    }
    .dl-especialidades__card {
      aspect-ratio: 16 / 10;
    }
  }
</style>
