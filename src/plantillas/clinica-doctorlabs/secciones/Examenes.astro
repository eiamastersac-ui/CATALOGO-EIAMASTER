---
import { examenes } from '../datos/doctorlabs.js';

interface Ex {
  t: string;
  img: string;
}
const lista = examenes as Ex[];
---

<section class="dl-seccion" id="laboratorio">
  <div class="dl-wrap">
    <div class="dl-examenes__intro dl-reveal">
      <span class="dl-kicker">Catálogo</span>
      <h2 class="dl-titulo">Exámenes y servicios más solicitados</h2>
      <p class="dl-parrafo">
        Un vistazo a los estudios que realizamos con mayor frecuencia entre nuestras cuatro especialidades.
      </p>
    </div>

    <div class="dl-examenes__grid">
      {lista.map((e: Ex, i: number) => (
        <article class={`dl-examenes__card dl-reveal dl-reveal--d${i % 4}`}>
          <img src={e.img} alt={e.t} loading="lazy" />
          <span class="dl-examenes__scrim" aria-hidden="true"></span>
          <span class="dl-examenes__t">{e.t}</span>
        </article>
      ))}
    </div>

    <div class="dl-examenes__cta dl-reveal">
      <a href="#contacto" class="dl-btn dl-btn--morado">Reservar cita</a>
    </div>
  </div>
</section>

<style>
  #laboratorio.dl-seccion {
    padding-bottom: 2.5rem;
  }

  .dl-examenes__intro {
    max-width: 42rem;
    margin-bottom: 2.5rem;
  }

  .dl-examenes__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.9rem;
  }

  .dl-examenes__card {
    position: relative;
    aspect-ratio: 3 / 3.4;
    border-radius: 14px;
    overflow: hidden;
  }

  .dl-examenes__card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dl-examenes__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(200deg, rgba(139, 58, 158, 0.15) 10%, rgba(139, 58, 158, 0.55) 55%, rgba(214, 82, 140, 0.85) 100%);
  }

  .dl-examenes__t {
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.9rem;
    color: #fff;
    font-family: var(--dl-display);
    font-weight: 700;
    font-size: 0.76rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-align: center;
    line-height: 1.3;
  }

  .dl-examenes__cta {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }

  @media (max-width: 820px) {
    .dl-examenes__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 560px) {
    .dl-examenes__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
