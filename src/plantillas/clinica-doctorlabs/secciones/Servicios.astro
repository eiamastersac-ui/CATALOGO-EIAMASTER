---
import { nuestrosServicios } from '../datos/doctorlabs.js';
import Icono from '../componentes/Icono.astro';

interface Tarjeta {
  icono: string;
  t: string;
  d: string;
}
const tarjetas = nuestrosServicios.tarjetas as Tarjeta[];
---

<section class="dl-seccion" id="servicios">
  <div class="dl-wrap dl-servicios__grid">
    <div class="dl-servicios__texto dl-reveal">
      <span class="dl-kicker">{nuestrosServicios.kicker}</span>
      <h2 class="dl-titulo">{nuestrosServicios.titulo}</h2>
      <p class="dl-parrafo">{nuestrosServicios.parrafo}</p>
      <img class="dl-servicios__foto" src={nuestrosServicios.img} alt="Consulta médica en curso" loading="lazy" />
    </div>

    <div class="dl-servicios__tarjetas">
      {tarjetas.map((t: Tarjeta, i: number) => (
        <article class={`dl-servicios__card dl-reveal dl-reveal--d${i}`}>
          <span class="dl-servicios__icono">
            <Icono nombre={t.icono} size={22} />
          </span>
          <h3>{t.t}</h3>
          <p>{t.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .dl-servicios__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }

  .dl-servicios__foto {
    margin-top: 1.8rem;
    border-radius: 18px;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .dl-servicios__tarjetas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }

  .dl-servicios__card {
    background: var(--dl-morado);
    color: #fff;
    border-radius: 18px;
    padding: 1.6rem 1.4rem;
  }

  .dl-reveal--d1 { transition-delay: 0.08s; }
  .dl-reveal--d2 { transition-delay: 0.16s; }
  .dl-reveal--d3 { transition-delay: 0.24s; }

  .dl-servicios__icono {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.16);
    margin-bottom: 1rem;
  }

  .dl-servicios__card h3 {
    color: #fff;
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
  }

  .dl-servicios__card p {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .dl-servicios__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .dl-servicios__tarjetas {
      grid-template-columns: 1fr;
    }
  }
</style>
