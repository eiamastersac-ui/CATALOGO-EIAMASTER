---
import { doctora } from '../datos/clinica.js';
---

<section class="bq-doctora" id="doctora">
  <div class="bq-wrap bq-doctora__grid">
    <div class="bq-doctora__foto bq-reveal">
      <img src={doctora.img} alt={doctora.kicker} loading="lazy" />
    </div>
    <div class="bq-doctora__texto bq-reveal bq-reveal--2">
      <span class="bq-kicker">{doctora.kicker}</span>
      <h2 class="bq-titulo">{doctora.titulo}</h2>
      <p>{doctora.p}</p>
      <a href="#servicios" class="bq-btn bq-btn--dorado">{doctora.cta}</a>
    </div>
  </div>
</section>

<style>
  .bq-doctora {
    padding-block: clamp(3rem, 7vw, 5rem);
    background: linear-gradient(180deg, var(--bq-crema) 0%, var(--bq-blanco) 100%);
  }

  .bq-doctora__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  .bq-doctora__foto {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }

  .bq-doctora__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bq-doctora__texto p {
    margin-bottom: 1.75rem;
    max-width: 48ch;
    font-size: 0.96rem;
  }

  @media (max-width: 780px) {
    .bq-doctora__grid {
      grid-template-columns: 1fr;
    }

    .bq-doctora__foto {
      max-width: 20rem;
      margin-inline: auto;
    }
  }
</style>
