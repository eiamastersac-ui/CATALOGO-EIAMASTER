---
interface Props {
  fotos: string[];
  alt?: string;
}
const { fotos, alt = '' } = Astro.props as Props;
---

<div class="rc-collage" data-cantidad={fotos.length}>
  {fotos.map((f) => (
    <div class="rc-collage__marco">
      <img src={f} alt={alt} loading="lazy" />
    </div>
  ))}
</div>

<style>
  .rc-collage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }

  .rc-collage[data-cantidad="1"] {
    grid-template-columns: 1fr;
  }

  .rc-collage[data-cantidad="3"] > :first-child {
    grid-column: span 2;
  }

  .rc-collage__marco {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .rc-collage__marco::after {
    content: "";
    position: absolute;
    inset: 10px;
    border: 1.5px solid var(--rc-rojo);
    opacity: 0.55;
    pointer-events: none;
  }

  .rc-collage__marco img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
