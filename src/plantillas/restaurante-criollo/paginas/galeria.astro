---
import Marco from '../componentes/Marco.astro';
import BannerPagina from '../componentes/BannerPagina.astro';
import { galeriaCategorias, galeriaFotos } from '../datos/restaurante.js';

export const titulo = 'Galería de Fotos | tu tienda.com';
export const descripcion = 'Fotos del salón, la cocina, nuestros platos y eventos de tu tienda.com.';

interface Foto {
  cat: string;
  img: string;
}
const categorias = galeriaCategorias as string[];
const fotos = galeriaFotos as Foto[];
---

<Marco>
  <BannerPagina titulo="Galería de Fotos" />

  <section class="rc-seccion">
    <div class="rc-wrap">
      <div class="rc-gal__filtros" id="rc-gal-filtros">
        {categorias.map((c, i) => (
          <button type="button" class:list={['rc-gal__filtro', { 'is-activo': i === 0 }]} data-cat={c}>{c}</button>
        ))}
      </div>

      <div class="rc-gal__grid" id="rc-gal-grid">
        {fotos.map((f) => (
          <figure class="rc-gal__item" data-cat={f.cat}>
            <img src={f.img} alt={f.cat} loading="lazy" />
          </figure>
        ))}
      </div>

      <p class="rc-gal__vacio" id="rc-gal-vacio" hidden>No hay fotos en esta categoría todavía.</p>
    </div>
  </section>
</Marco>

<script>
  const botones = document.querySelectorAll<HTMLButtonElement>('#rc-gal-filtros .rc-gal__filtro');
  const items = document.querySelectorAll<HTMLElement>('#rc-gal-grid .rc-gal__item');
  const vacio = document.getElementById('rc-gal-vacio');

  botones.forEach((btn) => {
    btn.addEventListener('click', () => {
      botones.forEach((b) => b.classList.remove('is-activo'));
      btn.classList.add('is-activo');

      const cat = btn.dataset.cat;
      let visibles = 0;
      items.forEach((item) => {
        const coincide = cat === 'Todos' || item.dataset.cat === cat;
        item.hidden = !coincide;
        if (coincide) visibles += 1;
      });
      if (vacio) vacio.hidden = visibles > 0;
    });
  });
</script>

<style>
  .rc-gal__filtros {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .rc-gal__filtro {
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--rc-linea);
    border-radius: var(--rc-pill);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--rc-texto);
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .rc-gal__filtro.is-activo,
  .rc-gal__filtro:hover {
    background: var(--rc-rojo);
    border-color: var(--rc-rojo);
    color: #fff;
  }

  .rc-gal__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .rc-gal__grid[hidden] {
    display: none;
  }

  .rc-gal__item {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 4px;
  }

  .rc-gal__item[hidden] {
    display: none;
  }

  .rc-gal__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .rc-gal__item:hover img {
    transform: scale(1.06);
  }

  .rc-gal__vacio {
    text-align: center;
    margin-top: 2rem;
  }

  @media (max-width: 860px) {
    .rc-gal__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
