---
import Marco from '../componentes/Marco.astro';
import BannerPagina from '../componentes/BannerPagina.astro';
import CollageFotos from '../componentes/CollageFotos.astro';
import { historia, marca } from '../datos/restaurante.js';

export const titulo = 'Nuestra Historia | tu tienda.com';
export const descripcion = 'Cómo nació tu tienda.com, restaurante criollo familiar con más de una década de tradición.';

const parrafos = historia.parrafos as string[];
const fotos = historia.fotos as string[];
---

<Marco>
  <BannerPagina titulo="Nuestra Historia" />

  <section class="rc-seccion">
    <div class="rc-wrap rc-hist__grid">
      <div class="rc-reveal">
        <span class="rc-kicker" style="text-align:left">{marca.nombre}</span>
        <span class="rc-regla" style="margin-left:0"></span>
        <p style="margin-top:1.1rem">{parrafos[0]}</p>
      </div>
      <div class="rc-reveal">
        <CollageFotos fotos={fotos} alt="Historia de tu tienda.com" />
      </div>
    </div>
  </section>

  <section class="rc-seccion" style="background:var(--rc-crema);padding-block:clamp(2.5rem,6vw,4rem)">
    <div class="rc-wrap rc-hist__cierre rc-reveal">
      <div class="rc-hist__foto">
        <img src={historia.chefImg} alt="Chef de tu tienda.com" loading="lazy" />
      </div>
      <div>
        <p>{parrafos[1]}</p>
        <p style="margin-top:1.1rem">{parrafos[2]}</p>
      </div>
    </div>
  </section>
</Marco>

<style>
  .rc-hist__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .rc-hist__cierre {
    display: grid;
    grid-template-columns: 0.7fr 1fr;
    gap: clamp(2rem, 5vw, 3rem);
    align-items: center;
  }

  .rc-hist__foto {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 4px;
  }

  .rc-hist__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 780px) {
    .rc-hist__grid,
    .rc-hist__cierre {
      grid-template-columns: 1fr;
    }
  }
</style>
