---
import Marco from '../componentes/Marco.astro';
import BannerPagina from '../componentes/BannerPagina.astro';
import Icono from '../componentes/Icono.astro';
import { sedes } from '../datos/restaurante.js';

export const titulo = 'Nuestras Casas | tu tienda.com';
export const descripcion = 'Casa Miraflores y Casa La Molina: direcciones, teléfonos y horarios de tu tienda.com.';

interface Sede {
  id: string;
  nombre: string;
  direccion: string;
  telefono: string;
  correo: string;
  img: string;
}
const lista = sedes as Sede[];
---

<Marco>
  <BannerPagina titulo="Nuestras Casas" />

  {lista.map((s, i) => (
    <section class="rc-seccion rc-sede" id={s.id} style={i % 2 === 1 ? 'background:var(--rc-crema)' : ''}>
      <div class:list={['rc-wrap', 'rc-sede__grid', { 'rc-sede__grid--inv': i % 2 === 1 }]}>
        <div class="rc-reveal">
          <span class="rc-kicker" style="text-align:left">{s.nombre}</span>
          <span class="rc-regla" style="margin-left:0"></span>
          <ul class="rc-sede__datos">
            <li><Icono nombre="mapa" size={16} /> {s.direccion}</li>
            <li><Icono nombre="telefono" size={16} /> {s.telefono}</li>
            <li><Icono nombre="correo" size={16} /> {s.correo}</li>
          </ul>
        </div>
        <div class="rc-reveal rc-sede__foto">
          <img src={s.img} alt={s.nombre} loading="lazy" />
        </div>
      </div>
    </section>
  ))}
</Marco>

<style>
  .rc-sede__grid {
    display: grid;
    grid-template-columns: 0.8fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .rc-sede__grid--inv {
    direction: rtl;
  }

  .rc-sede__grid--inv > * {
    direction: ltr;
  }

  .rc-sede__datos {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-top: 1.2rem;
  }

  .rc-sede__datos li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .rc-sede__datos svg {
    color: var(--rc-rojo);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .rc-sede__foto {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 4px;
  }

  .rc-sede__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 780px) {
    .rc-sede__grid,
    .rc-sede__grid--inv {
      grid-template-columns: 1fr;
      direction: ltr;
    }

    .rc-sede__foto {
      order: -1;
    }
  }
</style>
