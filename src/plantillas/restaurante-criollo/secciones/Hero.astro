---
import { hero } from '../datos/restaurante.js';
import Icono from '../componentes/Icono.astro';

const slides = hero.slides as string[];
---

<section class="rc-hero">
  <div class="rc-hero__track" id="rc-hero-track">
    {slides.map((img: string, i: number) => (
      <div class="rc-hero__slide">
        <img src={img} alt={hero.titulo} loading={i === 0 ? 'eager' : 'lazy'} />
      </div>
    ))}
  </div>
  <span class="rc-hero__scrim" aria-hidden="true"></span>

  <div class="rc-wrap rc-hero__body">
    <h1 class="rc-hero__titulo">{hero.titulo}</h1>
    <p class="rc-hero__sub">{hero.kicker}</p>
    <span class="rc-regla" style="filter:brightness(0) invert(1)"></span>
    <div class="rc-hero__cta">
      <a href={hero.cta2.href} class="rc-btn rc-btn--rojo">{hero.cta2.t}</a>
      <a href={hero.cta1.href} class="rc-btn rc-btn--linea">{hero.cta1.t}</a>
    </div>
  </div>

  {slides.length > 1 && (
    <>
      <button type="button" class="rc-hero__flecha rc-hero__flecha--izq" id="rc-hero-prev" aria-label="Anterior">
        <Icono nombre="flechaIzq" size={22} />
      </button>
      <button type="button" class="rc-hero__flecha rc-hero__flecha--der" id="rc-hero-next" aria-label="Siguiente">
        <Icono nombre="flechaDer" size={22} />
      </button>
      <div class="rc-hero__dots" id="rc-hero-dots">
        {slides.map((_: string, i: number) => (
          <button type="button" class="rc-hero__dot" data-idx={i} aria-label={`Ir a la diapositiva ${i + 1}`}></button>
        ))}
      </div>
    </>
  )}
</section>

<script>
  const track = document.getElementById('rc-hero-track');
  const dots = document.querySelectorAll<HTMLButtonElement>('#rc-hero-dots .rc-hero__dot');
  const total = track ? track.children.length : 0;
  let idx = 0;
  let temporizador: ReturnType<typeof setInterval> | undefined;

  function marcarDot() {
    dots.forEach((d, i) => d.classList.toggle('is-activo', i === idx));
  }

  function ir(n: number) {
    if (!track || total < 2) return;
    idx = (n + total) % total;
    track.style.transform = `translateX(-${idx * 100}%)`;
    marcarDot();
  }

  function autoplay() {
    temporizador = setInterval(() => ir(idx + 1), 6000);
  }

  if (total > 1) {
    marcarDot();
    autoplay();

    document.getElementById('rc-hero-prev')?.addEventListener('click', () => {
      ir(idx - 1);
      clearInterval(temporizador);
      autoplay();
    });
    document.getElementById('rc-hero-next')?.addEventListener('click', () => {
      ir(idx + 1);
      clearInterval(temporizador);
      autoplay();
    });
    dots.forEach((d) => d.addEventListener('click', () => {
      ir(Number(d.dataset.idx));
      clearInterval(temporizador);
      autoplay();
    }));

    const hero = track?.closest('.rc-hero');
    hero?.addEventListener('mouseenter', () => clearInterval(temporizador));
    hero?.addEventListener('mouseleave', autoplay);
  }
</script>

<style>
  .rc-hero {
    position: relative;
    height: clamp(540px, 78vh, 740px);
    overflow: hidden;
    background: var(--rc-tinta);
  }

  .rc-hero__track {
    display: flex;
    height: 100%;
    transition: transform 0.7s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .rc-hero__slide {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
  }

  .rc-hero__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rc-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(15, 11, 9, 0.8) 0%, rgba(15, 11, 9, 0.25) 45%, rgba(15, 11, 9, 0.55) 100%);
  }

  .rc-hero__body {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .rc-hero__titulo {
    font-family: var(--rc-font-script);
    font-weight: 400;
    color: #fff;
    font-size: clamp(2.4rem, 6.5vw, 4.4rem);
    max-width: 22ch;
  }

  .rc-hero__sub {
    color: rgba(255, 255, 255, 0.92);
    font-weight: 600;
    letter-spacing: 0.03em;
    margin-top: 0.6rem;
  }

  .rc-hero__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .rc-hero__flecha {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    z-index: 3;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    display: grid;
    place-items: center;
    transition: background 0.2s ease;
  }

  .rc-hero__flecha:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  .rc-hero__flecha--izq {
    left: clamp(0.8rem, 3vw, 2rem);
  }

  .rc-hero__flecha--der {
    right: clamp(0.8rem, 3vw, 2rem);
  }

  .rc-hero__dots {
    position: absolute;
    bottom: 1.6rem;
    left: 50%;
    translate: -50% 0;
    z-index: 3;
    display: flex;
    gap: 0.5rem;
  }

  .rc-hero__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.45);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .rc-hero__dot.is-activo {
    background: var(--rc-rojo);
    transform: scale(1.2);
  }

  @media (max-width: 640px) {
    .rc-hero__flecha {
      display: none;
    }
  }
</style>
