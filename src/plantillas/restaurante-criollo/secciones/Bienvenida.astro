---
import { bienvenida } from '../datos/restaurante.js';
import CollageFotos from '../componentes/CollageFotos.astro';

const parrafos = bienvenida.parrafos as string[];
const fotos = bienvenida.fotos as string[];
---

<section class="rc-seccion rc-bienv">
  <div class="rc-wrap rc-bienv__grid">
    <div class="rc-reveal">
      <span class="rc-kicker" style="text-align:left">{bienvenida.titulo1}</span>
      <h2 class="rc-titulo" style="font-family:var(--rc-font);text-transform:uppercase;font-size:clamp(1.3rem,2.4vw,1.7rem);letter-spacing:.04em">{bienvenida.titulo2}</h2>
      <span class="rc-regla" style="margin-left:0"></span>
      {parrafos.map((p) => <p style="margin-top:1.1rem;max-width:46ch">{p}</p>)}
      <a href={bienvenida.ctaHref} class="rc-btn rc-btn--rojo" style="margin-top:1.6rem">{bienvenida.cta}</a>
    </div>

    <div class="rc-reveal">
      <CollageFotos fotos={fotos} alt={bienvenida.titulo2} />
    </div>
  </div>
</section>

<style>
  .rc-bienv__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (max-width: 780px) {
    .rc-bienv__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
