---
import { marca, footerCols } from '../datos/boniteza.js';
---

<div class="bz-wrap bz-lr">
  <a href="#" class="bz-lr__link">
    <span aria-hidden="true">&#128214;</span> Libro de reclamaciones
  </a>
</div>

<footer class="bz-foot">
  <div class="bz-wrap bz-foot__grid">
    <div class="bz-foot__col">
      <h3>Contacto</h3>
      <p>
        WhatsApp: {marca.tel}<br />
        Horario de atención:<br />
        {marca.horario}<br />
        Correo: {marca.correo}
      </p>
    </div>

    {footerCols.map((col: { t: string; links: string[] }) => (
      <nav class="bz-foot__col" aria-label={col.t}>
        <h3>{col.t}</h3>
        <ul>
          {col.links.map((l: string) => <li><a href="#">{l}</a></li>)}
        </ul>
      </nav>
    ))}

    <div class="bz-foot__col bz-foot__news">
      <h3>Suscríbete aquí</h3>
      <p>Déjanos tu correo para enviarte información.</p>
      <form class="bz-foot__news-form" onsubmit="return false">
        <input type="email" placeholder="Correo electrónico" aria-label="Correo electrónico" required />
        <button type="submit" aria-label="Suscribirme">&rarr;</button>
      </form>
      <div class="bz-foot__redes" aria-label="Redes sociales">
        <a href="#" aria-label="Instagram">&#9678;</a>
        <a href="#" aria-label="Facebook">f</a>
        <a href="#" aria-label="TikTok">&#9835;</a>
        <a href="#" aria-label="YouTube">&#9654;</a>
      </div>
    </div>
  </div>

  <div class="bz-wrap bz-foot__base">
    <span>{marca.nombre} {marca.sub} — Todos los derechos reservados 2026</span>
  </div>
</footer>

<style>
  .bz-lr {
    display: flex;
    justify-content: center;
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }

  .bz-lr__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--bz-gris);
    flex-direction: column;
    text-align: center;
  }

  .bz-foot {
    background: var(--bz-lila-palido);
    border-top: 1px solid var(--bz-linea);
  }

  .bz-foot__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1.3fr;
    gap: 2.5rem;
    padding-block: 2.5rem 1.75rem;
  }

  .bz-foot__col h3 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--bz-morado);
    margin-bottom: 0.9rem;
  }

  .bz-foot__col p {
    font-size: 0.82rem;
    color: var(--bz-gris);
    line-height: 1.8;
  }

  .bz-foot__col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .bz-foot__col a {
    font-size: 0.82rem;
    color: var(--bz-gris);
  }

  .bz-foot__col a:hover {
    color: var(--bz-magenta);
  }

  .bz-foot__news-form {
    display: flex;
    align-items: center;
    border: 1.5px solid var(--bz-tinta);
    margin-block: 0.9rem 1rem;
  }

  .bz-foot__news-form input {
    flex: 1;
    border: none;
    background: none;
    outline: none;
    padding: 0.65rem 0.9rem;
    font-size: 0.82rem;
  }

  .bz-foot__news-form button {
    width: 42px;
    align-self: stretch;
    background: var(--bz-tinta);
    color: #fff;
  }

  .bz-foot__redes {
    display: flex;
    gap: 0.5rem;
  }

  .bz-foot__redes a {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border: 1px solid var(--bz-linea);
    color: var(--bz-morado);
    font-weight: 700;
    font-size: 0.8rem;
  }

  .bz-foot__redes a:hover {
    background: var(--bz-morado);
    color: #fff;
  }

  .bz-foot__base {
    border-top: 1px solid var(--bz-linea);
    padding-block: 1rem;
    text-align: center;
    font-size: 0.74rem;
    color: var(--bz-gris);
  }

  @media (max-width: 820px) {
    .bz-foot__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .bz-foot__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
