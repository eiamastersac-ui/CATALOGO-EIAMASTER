---
import { institucionalImg, textoSeo, marca } from '../datos/boniteza.js';
---

<section class="bz-seccion bz-wrap" id="nosotros">
  <div class="bz-nos">
    <img src={institucionalImg} alt={`${marca.nombre} ${marca.sub}`} loading="lazy" />
    <p class="bz-nos__texto">
      Somos una tienda online de belleza en Perú. Encuentra maquillaje, cosmética y
      cuidado capilar profesional: shampoos, acondicionadores, aceites y mascarillas
      de las mejores marcas para tu rutina diaria.
    </p>
  </div>

  <div class="bz-seo">
    {textoSeo.map((b: { t: string; p: string }) => (
      <div class="bz-seo__col">
        <h3>{b.t}</h3>
        <p>{b.p}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .bz-nos {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    min-height: clamp(220px, 26vw, 320px);
    display: flex;
    align-items: flex-end;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .bz-nos img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bz-nos__texto {
    position: relative;
    z-index: 1;
    color: #fff;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    max-width: 40rem;
    font-size: clamp(0.95rem, 1.6vw, 1.15rem);
    background: linear-gradient(0deg, rgba(32, 15, 51, 0.78), transparent 90%);
    width: 100%;
  }

  .bz-seo {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  .bz-seo__col h3 {
    font-size: 1rem;
    margin-bottom: 0.75rem;
    color: var(--bz-morado);
  }

  .bz-seo__col p {
    font-size: 0.85rem;
    color: var(--bz-gris);
  }

  @media (max-width: 820px) {
    .bz-seo {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
