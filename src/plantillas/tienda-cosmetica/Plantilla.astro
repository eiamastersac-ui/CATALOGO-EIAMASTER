---
import './estilos.css';

import BarraSuperior from './secciones/BarraSuperior.astro';
import Cabecera from './secciones/Cabecera.astro';
import HeroCarrusel from './secciones/HeroCarrusel.astro';
import MasVendidos from './secciones/MasVendidos.astro';
import CategoriasBanners from './secciones/CategoriasBanners.astro';
import Marcas from './secciones/Marcas.astro';
import SobreNosotros from './secciones/SobreNosotros.astro';
import Testimonios from './secciones/Testimonios.astro';
import PiePagina from './secciones/PiePagina.astro';
import WidgetsFlotantes from './secciones/WidgetsFlotantes.astro';
