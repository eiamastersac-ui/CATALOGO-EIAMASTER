---
import './estilos.css';

import Cabecera from './secciones/Cabecera.astro';
import Hero from './secciones/Hero.astro';
import Nosotros from './secciones/Nosotros.astro';
import Beneficios from './secciones/Beneficios.astro';
import Servicios from './secciones/Servicios.astro';
import Opiniones from './secciones/Opiniones.astro';
import Visitanos from './secciones/Visitanos.astro';
import PiePagina from './secciones/PiePagina.astro';
import Flotantes from './secciones/Flotantes.astro';
import AvisoCookies from './secciones/AvisoCookies.astro';
import RevelarScroll from './componentes/RevelarScroll.astro';
---

<div class="tpl-barberia-caballeros">
  <span id="top"></span>
  <Cabecera />
  <main>
    <Hero />
    <Nosotros />
    <Beneficios />
    <Servicios />
    <Opiniones />
    <Visitanos />
  </main>
  <PiePagina />
  <AvisoCookies />
  <Flotantes />
  <RevelarScroll />
</div>
