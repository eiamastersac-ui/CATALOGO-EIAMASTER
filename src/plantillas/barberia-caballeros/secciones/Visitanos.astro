---
import { visitanos } from '../datos/barberia.js';
import Icono from '../componentes/Icono.astro';
---

<section class="bc-vis" id="visitanos">
  <p class="bc-vis__fondo" aria-hidden="true">
    {visitanos.fondo.map((l: string) => <span>{l}</span>)}
  </p>

  <div class="bc-vis__txt bc-reveal">
    <h2 class="bc-vis__titulo">{visitanos.titulo}</h2>
    <p class="bc-vis__sub">
      {visitanos.sub.map((l: string) => <span>{l}</span>)}
    </p>
    <button type="button" class="bc-btn bc-btn--oscuro" data-abrir-chat="Hola, quiero reservar una cita">
      <span class="bc-btn__txt">{visitanos.cta}</span>
      <span class="bc-btn__fl"><Icono nombre="flecha" size={15} grosor={1.5} /></span>
    </button>
  </div>

  <figure class="bc-vis__foto">
    <img src={visitanos.img} alt="Cliente con barba y corte pompadour de perfil" loading="lazy" />
  </figure>
</section>

<style>
  .bc-vis {
    position: relative;
    display: grid;
    grid-template-columns: 1fr minmax(0, 40%);
    min-height: 500px;
    background: var(--bc-panel-2);
    overflow: hidden;
  }

  /* "15% OFF" gigante en blanco detras del titulo, como el original */
  .bc-vis__fondo {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--bc-font);
    font-weight: 900;
    font-size: clamp(6rem, 13vw, 12.5rem);
    line-height: 0.95;
    color: #fff;
    opacity: 0.9;
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
  }

  .bc-vis__txt {
    position: relative;
    z-index: 1;
    align-self: center;
    justify-self: end;
    width: min(640px, 100%);
    margin-right: clamp(0rem, 3vw, 3rem);
    padding: clamp(3.5rem, 7vw, 5rem) clamp(1rem, 4vw, 2rem);
  }

  .bc-vis__titulo {
    font-family: var(--bc-bebas);
    font-stretch: normal;
    font-variation-settings: normal;
    font-weight: 400;
    font-size: clamp(5rem, 9.6vw, 9.4rem);
    line-height: 0.82;
    margin-left: -0.5rem;
    color: var(--bc-tinta);
  }

  .bc-vis__sub {
    margin: 1.4rem 0 2.2rem;
    font-family: var(--bc-ext);
    font-stretch: 125%;
    font-variation-settings: "wdth" 125;
    font-weight: 800;
    font-size: clamp(1.3rem, 2.3vw, 2.2rem);
    line-height: 1.12;
    text-transform: uppercase;
    color: var(--bc-tinta);
  }

  .bc-vis__sub span {
    display: block;
  }

  .bc-vis__foto {
    position: relative;
  }

  .bc-vis__foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
  }

  @media (max-width: 860px) {
    .bc-vis {
      grid-template-columns: 1fr;
    }
    .bc-vis__txt {
      justify-self: stretch;
      width: auto;
      margin: 0;
    }
    .bc-vis__foto {
      aspect-ratio: 4 / 4.2;
    }
    .bc-vis__fondo {
      left: 60%;
      top: 26%;
      font-size: 7rem;
    }
  }
</style>
