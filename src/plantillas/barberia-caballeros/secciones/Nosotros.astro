---
import { nosotros } from '../datos/barberia.js';
import Icono from '../componentes/Icono.astro';

interface Foto { src: string; alt: string }
interface Valor { icono: string; t: string; d: string }
---

<section class="bc-nos" id="nosotros">
  <div class="bc-nos__top">
    <div class="bc-nos__fotos">
      {nosotros.fotos.map((f: Foto, i: number) => (
        <figure class={`bc-nos__foto bc-reveal bc-reveal--${i + 1}`}>
          <img src={f.src} alt={f.alt} loading="lazy" />
        </figure>
      ))}
    </div>

    <div class="bc-nos__txt bc-reveal">
      <span class="bc-kicker">{nosotros.kicker}</span>
      <h2 class="bc-titulo">
        {nosotros.titulo.map((l: string) => <span>{l}</span>)}
      </h2>
      <p>{nosotros.texto}</p>
      <a href="#servicios" class="bc-btn bc-btn--oscuro">
        <span class="bc-btn__txt">Leer más</span>
        <span class="bc-btn__fl"><Icono nombre="flecha" size={15} grosor={1.5} /></span>
      </a>
    </div>
  </div>

  <ul class="bc-valores">
    {nosotros.valores.map((v: Valor, i: number) => (
      <li class={`bc-valor bc-reveal bc-reveal--${i}`}>
        <span class="bc-valor__ico"><Icono nombre={v.icono} size={36} grosor={1.3} /></span>
        <h3>{v.t}</h3>
        <p>{v.d}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .bc-nos {
    position: relative;
    z-index: 2;
    background: #fff;
    padding-bottom: clamp(4rem, 8vw, 6.5rem);
  }

  .bc-nos__top {
    max-width: 1300px;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
    display: grid;
    grid-template-columns: minmax(0, 640px) minmax(0, 470px);
    gap: clamp(2rem, 4vw, 3.6rem);
    align-items: start;
    justify-content: center;
  }

  /* las dos fotos verticales suben y se montan sobre el borde inferior del hero */
  .bc-nos__fotos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
    margin-top: -56px;
  }

  .bc-nos__foto {
    aspect-ratio: 302 / 455;
    overflow: hidden;
    background: #111;
  }

  .bc-nos__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }

  .bc-nos__foto:hover img {
    transform: scale(1.04);
  }

  .bc-nos__txt {
    align-self: center;
    padding-top: 2rem;
  }

  .bc-nos__txt .bc-titulo {
    font-size: clamp(1.7rem, 2.7vw, 2.55rem);
  }

  .bc-nos__txt p {
    margin: 1.6rem 0 1.6rem;
    font-size: 0.92rem;
    line-height: 1.75;
  }

  .bc-valores {
    max-width: 1000px;
    margin: clamp(3.5rem, 6vw, 4.5rem) auto 0;
    padding-inline: clamp(1rem, 4vw, 2rem);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem 1.8rem;
    text-align: center;
  }

  .bc-valor__ico {
    display: inline-grid;
    place-items: center;
    color: var(--bc-tinta);
    margin-bottom: 0.9rem;
    transition: transform 0.4s ease;
  }

  .bc-valor:hover .bc-valor__ico {
    transform: rotate(-12deg);
  }

  .bc-valor h3 {
    font-size: 1rem;
    letter-spacing: 0.02em;
    margin-bottom: 0.9rem;
  }

  .bc-valor p {
    font-size: 0.88rem;
    line-height: 1.75;
  }

  @media (max-width: 900px) {
    .bc-nos__top {
      grid-template-columns: 1fr;
    }
    .bc-nos__fotos {
      max-width: 560px;
    }
    .bc-valores {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .bc-nos__fotos {
      gap: 12px;
      margin-top: -40px;
    }
    .bc-valores {
      grid-template-columns: 1fr;
      max-width: 340px;
    }
  }
</style>
