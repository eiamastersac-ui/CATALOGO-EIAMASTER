---
import { servicios } from '../datos/barberia.js';

interface Srv { t: string; img: string }
---

<section class="bc-srvs" id="servicios">
  <header class="bc-srvs__cab bc-reveal">
    <span class="bc-kicker">{servicios.kicker}</span>
    <h2 class="bc-titulo">
      {servicios.titulo.map((l: string) => <span>{l}</span>)}
    </h2>
  </header>

  <p class="bc-srvs__res" id="bc-srv-resultado" hidden>
    <span></span>
    <button type="button" id="bc-srv-limpiar">Ver todos</button>
  </p>

  <ul class="bc-srvs__grid">
    {servicios.items.map((s: Srv) => (
      <li class="bc-srv" data-nombre={s.t}>
        <button type="button" class="bc-srv__btn" data-abrir-chat={`Hola, quiero reservar: ${s.t}`} aria-label={`Reservar ${s.t}`}>
          <img src={s.img} alt="" loading="lazy" />
          <span class="bc-srv__label">{s.t}</span>
        </button>
      </li>
    ))}
  </ul>
</section>

<script>
  document.getElementById('bc-srv-limpiar')?.addEventListener('click', () => {
    document
      .querySelectorAll('.tpl-barberia-caballeros .bc-srv')
      .forEach((t) => t.classList.remove('is-atenuado'));
    const res = document.getElementById('bc-srv-resultado');
    if (res) res.hidden = true;
    const input = document.getElementById('bc-buscar-input') as HTMLInputElement | null;
    if (input) input.value = '';
  });
</script>

<style>
  .bc-srvs {
    background: #000;
    color: #fff;
  }

  .bc-srvs__cab {
    text-align: center;
    padding: clamp(4.5rem, 8vw, 6.8rem) 1.25rem clamp(4.5rem, 8vw, 8.5rem);
  }

  .bc-srvs__cab .bc-titulo {
    color: #fff;
    font-size: clamp(1.8rem, 3.3vw, 2.9rem);
  }

  .bc-srvs__res {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin: -3rem 0 2rem;
    font-size: 0.9rem;
    color: #ccc;
  }

  .bc-srvs__res button {
    font-family: var(--bc-bebas);
    font-size: 1rem;
    letter-spacing: 0.08em;
    color: #fff;
    border-bottom: 1px solid #fff;
  }

  .bc-srvs__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .bc-srv {
    aspect-ratio: 1;
    overflow: hidden;
    transition: opacity 0.35s ease, filter 0.35s ease;
  }

  .bc-srv.is-atenuado {
    opacity: 0.18;
    filter: grayscale(1);
  }

  .bc-srv__btn {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    text-align: left;
  }

  .bc-srv__btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bc-srv__btn:hover img,
  .bc-srv__btn:focus-visible img {
    transform: scale(1.06);
  }

  /* etiqueta negra que aparece en la esquina inferior izquierda al hover */
  .bc-srv__label {
    position: absolute;
    left: 8%;
    bottom: 8%;
    background: #000;
    color: #fff;
    padding: 1.05rem 1.6rem;
    font-family: var(--bc-grot);
    font-weight: 700;
    font-size: 0.98rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1.2;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.35s ease, transform 0.35s ease;
    max-width: 84%;
  }

  .bc-srv__btn:hover .bc-srv__label,
  .bc-srv__btn:focus-visible .bc-srv__label {
    opacity: 1;
    transform: none;
  }

  @media (hover: none) {
    .bc-srv__label {
      opacity: 1;
      transform: none;
      padding: 0.6rem 0.8rem;
      font-size: 0.78rem;
    }
  }

  @media (max-width: 860px) {
    .bc-srvs__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .bc-srv__label {
      padding: 0.6rem 0.8rem;
      font-size: 0.78rem;
    }
  }
</style>
