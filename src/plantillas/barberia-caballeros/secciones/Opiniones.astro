---
import { opiniones } from '../datos/barberia.js';

interface Op { texto: string; nombre: string; sede: string; foto: string }
const items = opiniones as Op[];
---

<section class="bc-op" id="opiniones" aria-roledescription="carrusel" aria-label="Opiniones de clientes">
  <div class="bc-op__in">
    <div class="bc-op__viewport">
      <ul class="bc-op__track" id="bc-op-track">
        {items.map((o: Op, i: number) => (
          <li class="bc-op__slide" aria-hidden={i === 0 ? 'false' : 'true'}>
            <span class="bc-op__avatar"><img src={o.foto} alt={`Foto de ${o.nombre}`} loading="lazy" /></span>
            <blockquote>“{o.texto}”</blockquote>
            <p class="bc-op__nombre">{o.nombre}</p>
            <p class="bc-op__sede">{o.sede}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="bc-op__dots" role="tablist" aria-label="Elegir opinión">
      {items.map((_: Op, i: number) => (
        <button
          type="button"
          role="tab"
          class={`bc-op__dot${i === 0 ? ' is-activo' : ''}`}
          aria-label={`Opinión ${i + 1}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          data-op={i}
        ></button>
      ))}
    </div>
  </div>

  <!-- navaja clasica en trazo fino, decorativa como en el original -->
  <svg class="bc-op__navaja" viewBox="0 0 300 260" aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round">
      <path d="M18 22c40-8 150-2 222 34l8 10-14 6C170 48 70 44 22 48Z" />
      <path d="M26 30c50-4 140 2 206 32" />
      <path d="M240 56c14 2 30 10 44 26l-6 4c-14-12-26-18-40-20" />
      <path d="M232 72c-16 26-40 68-60 104-14 26-34 58-56 70-12 6-22 0-18-14 8-26 34-58 58-90 18-24 38-50 52-70" />
      <path d="M222 80c-14 24-34 58-52 88-12 20-28 46-44 60" />
      <circle cx="226" cy="74" r="5" />
    </g>
  </svg>
</section>

<script>
  const track = document.getElementById('bc-op-track');
  const slides = Array.from(track?.children ?? []) as HTMLElement[];
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.tpl-barberia-caballeros .bc-op__dot'));
  const seccion = document.getElementById('opiniones');
  let idx = 0;
  let timer: number | undefined;

  const ir = (n: number) => {
    if (!track || !slides.length) return;
    idx = (n + slides.length) % slides.length;
    track.style.transform = `translateX(-${idx * 100}%)`;
    slides.forEach((s, i) => s.setAttribute('aria-hidden', String(i !== idx)));
    dots.forEach((d, i) => {
      d.classList.toggle('is-activo', i === idx);
      d.setAttribute('aria-selected', String(i === idx));
    });
  };
  const arrancar = () => {
    window.clearInterval(timer);
    timer = window.setInterval(() => ir(idx + 1), 7000);
  };

  dots.forEach((d) =>
    d.addEventListener('click', () => {
      ir(Number(d.dataset.op));
      arrancar();
    }),
  );

  // arrastre / swipe simple
  let x0: number | null = null;
  track?.addEventListener('pointerdown', (e: PointerEvent) => (x0 = e.clientX));
  track?.addEventListener('pointerup', (e: PointerEvent) => {
    if (x0 === null) return;
    const dx = e.clientX - x0;
    x0 = null;
    if (Math.abs(dx) > 50) {
      ir(idx + (dx < 0 ? 1 : -1));
      arrancar();
    }
  });

  seccion?.addEventListener('mouseenter', () => window.clearInterval(timer));
  seccion?.addEventListener('mouseleave', arrancar);
  arrancar();
</script>

<style>
  .bc-op {
    position: relative;
    background: #000;
    color: #fff;
    overflow: hidden;
    padding: clamp(4.5rem, 8vw, 7.5rem) 0 clamp(4rem, 7vw, 6.5rem);
  }

  .bc-op__in {
    position: relative;
    z-index: 1;
    width: min(640px, calc(100% - 2.5rem));
    margin-left: max(1.25rem, 29.5vw);
  }

  .bc-op__viewport {
    overflow: hidden;
    touch-action: pan-y;
  }

  .bc-op__track {
    display: flex;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: grab;
    user-select: none;
  }

  .bc-op__slide {
    flex: 0 0 100%;
    padding-right: 2rem;
  }

  .bc-op__avatar {
    display: block;
    width: 128px;
    height: 128px;
    padding: 10px;
    border-radius: 50%;
    border: 1px solid #222;
    background: #0c0c0c;
    margin-bottom: 1.3rem;
  }

  .bc-op__avatar img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(1);
    pointer-events: none;
  }

  .bc-op__slide blockquote {
    font-size: clamp(1.1rem, 1.6vw, 1.32rem);
    font-weight: 500;
    line-height: 1.6;
  }

  .bc-op__nombre {
    margin-top: 1.7rem;
    font-family: var(--bc-ext);
    font-stretch: 125%;
    font-variation-settings: "wdth" 125;
    font-weight: 800;
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .bc-op__sede {
    margin-top: 0.5rem;
    font-family: var(--bc-bebas);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bc-gris);
  }

  .bc-op__dots {
    display: flex;
    gap: 0.5rem;
    margin-top: 3.5rem;
  }

  .bc-op__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid #fff !important;
    transition: background 0.25s ease;
  }

  .bc-op__dot.is-activo {
    background: #fff !important;
  }

  .bc-op__navaja {
    position: absolute;
    right: 12%;
    top: 50%;
    width: min(300px, 22vw);
    transform: translateY(-50%);
    color: #3a3a3a;
    pointer-events: none;
  }

  @media (max-width: 860px) {
    .bc-op__in {
      margin-left: 1.25rem;
    }
    .bc-op__navaja {
      width: 180px;
      right: -30px;
      top: 20%;
      opacity: 0.6;
    }
  }
</style>
