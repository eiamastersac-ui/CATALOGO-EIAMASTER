<div class="bc-cookies" id="bc-cookies" role="region" aria-label="Aviso de cookies (demo)">
  <div class="bc-cookies__txt">
    <p>Utilizamos cookies para ofrecerte la mejor experiencia en nuestra web.</p>
    <p>Puedes aprender más sobre qué cookies utilizamos o desactivarlas en los ajustes.</p>
  </div>
  <div class="bc-cookies__acc">
    <button type="button" class="bc-cookies__btn bc-cookies__btn--sec" data-cookies>Rechazar</button>
    <button type="button" class="bc-cookies__btn" data-cookies>Aceptar</button>
  </div>
</div>

<script>
  const aviso = document.getElementById('bc-cookies');
  aviso?.querySelectorAll('[data-cookies]').forEach((b) =>
    b.addEventListener('click', () => {
      if (aviso) aviso.hidden = true;
    }),
  );
</script>

