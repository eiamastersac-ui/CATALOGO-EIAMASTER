---
import './estilos.css';

import Cabecera from './secciones/Cabecera.astro';
import Hero from './secciones/Hero.astro';
import Franja from './secciones/Franja.astro';
import Servicios from './secciones/Servicios.astro';
import Urgencia from './secciones/Urgencia.astro';
import Proceso from './secciones/Proceso.astro';
import Cobertura from './secciones/Cobertura.astro';
import ComoElegir from './secciones/ComoElegir.astro';
import Resenas from './secciones/Resenas.astro';
import Contacto from './secciones/Contacto.astro';
import PiePagina from './secciones/PiePagina.astro';
import WhatsappFlotante from './secciones/WhatsappFlotante.astro';
import RevelarScroll from './componentes/RevelarScroll.astro';
---

<div class="tpl-gasfitero-lima">
  <Cabecera />
  <span id="top"></span>
  <main>
    <Hero />
    <Franja />
    <Servicios />
    <Urgencia />
    <Proceso />
    <Cobertura />
    <ComoElegir />
    <Resenas />
    <Contacto />
  </main>
  <PiePagina />
  <WhatsappFlotante />
  <RevelarScroll />
</div>
