---
import { urgencia, marca } from '../datos/gasfitero.js';
import Icono from '../componentes/Icono.astro';

const waHref = `https://wa.me/51${marca.telCrudo}?text=EMERGENCIA%20de%20gasfiter%C3%ADa`;
---

<section class="gl-urg" id="urgencia">
  <img src={urgencia.img} alt="" class="gl-urg__bg" loading="lazy" />
  <span class="gl-urg__scrim" aria-hidden="true"></span>
  <div class="gl-wrap gl-urg__cont gl-reveal">
    <div class="gl-urg__txt">
      <span class="gl-kicker gl-kicker--claro">{urgencia.kicker}</span>
      <h2>{urgencia.titulo}</h2>
      <p>{urgencia.sub}</p>
    </div>
    <div class="gl-urg__acc">
      <a href={`tel:${marca.telCrudo}`} class="gl-urg__tel">
        <Icono nombre="telefono" size={22} />
        <span>
          <small>Línea 24 h</small>
          {marca.tel}
        </span>
      </a>
      <a href={waHref} target="_blank" rel="noopener" class="gl-btn gl-btn--cobre">
        <Icono nombre="whatsapp" size={16} />
        Escribir por WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .gl-urg {
    position: relative;
    overflow: hidden;
    background: var(--gl-tinta);
    color: #fff;
    padding-block: clamp(3rem, 7vw, 4.75rem);
  }

  .gl-urg__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.28;
  }

  .gl-urg__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(20, 16, 13, 0.92), rgba(20, 16, 13, 0.65));
  }

  .gl-urg__cont {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem 3rem;
    flex-wrap: wrap;
  }

  .gl-urg__txt {
    max-width: 34rem;
  }

  .gl-urg__txt h2 {
    color: #fff;
    font-size: clamp(1.6rem, 3.6vw, 2.4rem);
    margin-bottom: 0.7rem;
  }

  .gl-urg__txt p {
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.98rem;
  }

  .gl-urg__acc {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex-shrink: 0;
  }

  .gl-urg__tel {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--gl-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 3.4vw, 2rem);
    letter-spacing: -0.02em;
    color: #fff;
  }

  .gl-urg__tel span {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .gl-urg__tel small {
    font-family: var(--gl-font);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gl-cobre-suave);
  }

  .gl-urg__tel:hover {
    color: var(--gl-cobre-suave);
  }

  @media (max-width: 720px) {
    .gl-urg__acc {
      width: 100%;
    }
  }
</style>
