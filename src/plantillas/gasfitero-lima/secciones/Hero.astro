---
import { hero, marca } from '../datos/gasfitero.js';
import Icono from '../componentes/Icono.astro';

interface Slide {
  kicker: string;
  titulo: string;
  sub: string;
  img: string;
}
const slides = hero.slides as Slide[];
const waHref = `https://wa.me/51${marca.telCrudo}?text=Hola,%20tengo%20una%20emergencia%20de%20gasfiter%C3%ADa`;
---

<section class="gl-hero" id="hero" aria-roledescription="carrusel">
  <div class="gl-hero__track" id="gl-hero-track">
    {slides.map((s: Slide, i: number) => (
      <article class="gl-hero__slide">
        <img src={s.img} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
        <span class="gl-hero__scrim" aria-hidden="true"></span>
        <div class="gl-hero__body gl-wrap">
          <div class="gl-hero__spacer"></div>
          <div class="gl-hero__texto">
            <span class="gl-kicker gl-kicker--claro">{s.kicker}</span>
            <h1>{s.titulo}</h1>
            <p class="gl-hero__sub">{s.sub}</p>
            <div class="gl-hero__acciones">
              <a href={`tel:${marca.telCrudo}`} class="gl-btn gl-btn--sobre-foto">
                <Icono nombre="telefono" size={16} />
                Llamar {marca.tel}
              </a>
              <a href={waHref} target="_blank" rel="noopener" class="gl-btn gl-btn--claro-linea">
                <Icono nombre="whatsapp" size={16} />
                Emergencia por WhatsApp
              </a>
            </div>
            <div class="gl-hero__tags">
              {hero.tags.map((t: string) => <a href="#servicios" class="gl-hero__tag">{t}</a>)}
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="gl-hero__card gl-reveal">
    <img src={hero.confianza.img} alt={hero.confianza.nombre} loading="lazy" />
    <div>
      <b>{hero.confianza.nombre}</b>
      <span class="gl-hero__card-cargo">{hero.confianza.cargo}</span>
      <span class="gl-hero__card-rating">
        <Icono nombre="estrella" size={12} />
        {hero.confianza.rating} <span>({hero.confianza.resenas})</span>
      </span>
      <span class="gl-hero__card-dato">{hero.confianza.dato}</span>
    </div>
  </div>

  <div class="gl-hero__nav">
    <span class="gl-hero__contador"><b id="gl-hero-actual">01</b> / {String(slides.length).padStart(2, '0')}</span>
    <button type="button" class="gl-flecha" id="gl-hero-prev" aria-label="Anterior">
      <Icono nombre="chevron" size={16} />
    </button>
    <button type="button" class="gl-flecha" id="gl-hero-next" aria-label="Siguiente">
      <Icono nombre="chevron" size={16} />
    </button>
  </div>

  <a href="#servicios" class="gl-hero__scroll" aria-label="Bajar a servicios">
    <Icono nombre="abajo" size={18} />
  </a>
</section>

<script>
  const track = document.getElementById('gl-hero-track');
  const actualEl = document.getElementById('gl-hero-actual');
  const total = track ? track.children.length : 0;
  let idx = 0;

  function ir(n: number) {
    if (!track) return;
    idx = (n + total) % total;
    track.style.transform = `translateX(-${idx * 100}%)`;
    if (actualEl) actualEl.textContent = String(idx + 1).padStart(2, '0');
  }

  document.getElementById('gl-hero-prev')?.addEventListener('click', () => ir(idx - 1));
  document.getElementById('gl-hero-next')?.addEventListener('click', () => ir(idx + 1));

  let timer = window.setInterval(() => ir(idx + 1), 6000);
  const box = document.getElementById('hero');
  box?.addEventListener('mouseenter', () => window.clearInterval(timer));
  box?.addEventListener('mouseleave', () => (timer = window.setInterval(() => ir(idx + 1), 6000)));
</script>

<style>
  .gl-hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: var(--gl-tinta);
  }

  .gl-hero__track {
    display: flex;
    height: 100%;
    transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .gl-hero__slide {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
  }

  .gl-hero__slide img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gl-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(20, 16, 13, 0.62) 0%,
      rgba(20, 16, 13, 0.12) 30%,
      rgba(20, 16, 13, 0.18) 52%,
      rgba(20, 16, 13, 0.8) 100%
    );
  }

  .gl-hero__body {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding-top: var(--gl-hdr-h);
    padding-bottom: clamp(2.5rem, 7vw, 4.5rem);
  }

  .gl-hero__spacer {
    flex: 1;
  }

  .gl-hero__texto {
    max-width: 44rem;
    color: #fff;
  }

  .gl-hero__texto h1 {
    color: #fff;
    font-weight: 800;
    font-size: clamp(2.2rem, 5.6vw, 3.8rem);
    margin-bottom: 0.9rem;
  }

  .gl-hero__sub {
    font-size: clamp(0.95rem, 1.7vw, 1.1rem);
    color: rgba(255, 255, 255, 0.9);
    max-width: 46ch;
    margin-bottom: 1.6rem;
  }

  .gl-hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 1.5rem;
  }

  .gl-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .gl-hero__tag {
    font-size: 0.76rem;
    font-weight: 600;
    color: #fff;
    padding: 0.45rem 0.9rem;
    border-radius: var(--gl-pill);
    border: 1px solid rgba(255, 255, 255, 0.42);
  }

  .gl-hero__tag:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .gl-hero__card {
    position: absolute;
    right: clamp(1.1rem, 4vw, 2rem);
    bottom: clamp(5.5rem, 12vw, 7.5rem);
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    max-width: 320px;
    background: rgba(255, 253, 248, 0.97);
    backdrop-filter: blur(10px);
    border-radius: 16px;
    padding: 0.8rem 1.1rem 0.8rem 0.8rem;
    box-shadow: 0 22px 48px -22px rgba(0, 0, 0, 0.5);
  }

  .gl-hero__card img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .gl-hero__card div {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    color: var(--gl-tinta);
  }

  .gl-hero__card b {
    font-family: var(--gl-display);
    font-size: 0.86rem;
  }

  .gl-hero__card-cargo {
    font-size: 0.7rem;
    color: var(--gl-humo);
  }

  .gl-hero__card-rating {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--gl-cobre);
    margin-top: 0.15rem;
  }

  .gl-hero__card-rating span {
    color: var(--gl-humo);
    font-weight: 500;
  }

  .gl-hero__card-dato {
    font-size: 0.68rem;
    color: var(--gl-humo);
    margin-top: 0.1rem;
  }

  .gl-hero__nav {
    position: absolute;
    right: clamp(1.1rem, 4vw, 2rem);
    bottom: clamp(1.5rem, 4vw, 2.25rem);
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .gl-hero__contador {
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    margin-right: 0.4rem;
  }

  .gl-hero__contador b {
    font-family: var(--gl-display);
  }

  .gl-hero__nav .gl-flecha {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.42);
    color: #fff;
    width: 38px;
    height: 38px;
  }

  .gl-hero__nav .gl-flecha:hover {
    background: #fff;
    color: var(--gl-tinta);
  }

  .gl-hero__nav .gl-flecha:first-of-type {
    transform: scaleX(-1);
  }

  .gl-hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    z-index: 5;
    color: rgba(255, 255, 255, 0.78);
    animation: gl-rebote 2.2s ease-in-out infinite;
  }

  @keyframes gl-rebote {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 6px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .gl-hero__scroll { animation: none; }
  }

  @media (max-width: 820px) {
    .gl-hero__card { display: none; }
  }

  @media (max-width: 560px) {
    .gl-hero__scroll { display: none; }
    .gl-hero__acciones .gl-btn { flex: 1 1 100%; }
  }
</style>
