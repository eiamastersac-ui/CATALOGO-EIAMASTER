---
import { proceso } from '../datos/gasfitero.js';
---

<section class="gl-seccion gl-proc" id="proceso">
  <div class="gl-wrap">
    <div class="gl-cab">
      <span class="gl-kicker">Cómo trabajamos</span>
      <h2 class="gl-titulo">De la llamada a la garantía, en cuatro pasos</h2>
      <p class="gl-sub">
        Sin visitas de "solo cotizar" que se cobran aparte. Sabes el precio y la hora
        de llegada desde el primer contacto.
      </p>
    </div>

    <ol class="gl-proc__lista">
      {proceso.map((p: { n: string; t: string; d: string }, i: number) => (
        <li class={`gl-proc__item gl-reveal gl-reveal--${i + 1}`}>
          <span class="gl-proc__n">{p.n}</span>
          <div>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .gl-proc__lista {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--gl-linea);
    border-top: 1px solid var(--gl-linea);
    border-bottom: 1px solid var(--gl-linea);
  }

  .gl-proc__item {
    background: var(--gl-papel);
    padding: 1.75rem 1.4rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .gl-proc__item:first-child {
    padding-left: 0;
  }

  .gl-proc__n {
    font-family: var(--gl-display);
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--gl-cobre);
    padding-top: 0.2rem;
  }

  .gl-proc__item h3 {
    font-size: 1.08rem;
    margin-bottom: 0.4rem;
  }

  .gl-proc__item p {
    font-size: 0.86rem;
    color: var(--gl-humo);
  }

  @media (max-width: 860px) {
    .gl-proc__lista {
      grid-template-columns: repeat(2, 1fr);
    }
    .gl-proc__item,
    .gl-proc__item:first-child {
      padding-inline: 1.4rem;
    }
  }

  @media (max-width: 520px) {
    .gl-proc__lista {
      grid-template-columns: 1fr;
    }
  }
</style>
