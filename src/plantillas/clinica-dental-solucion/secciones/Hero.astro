---
import { hero } from '../datos/clinica.js';
import Icono from '../componentes/Icono.astro';

interface Slide {
  kicker: string;
  emoji: string;
  texto: string;
  cta: string;
  img: string;
}
const slides = hero.slides as Slide[];
---

<section class="sd-hero" id="top" aria-roledescription="carrusel">
  <div class="sd-hero__track" id="sd-hero-track">
    {slides.map((s: Slide, i: number) => (
      <article class="sd-hero__slide">
        <img src={s.img} alt={s.kicker} loading={i === 0 ? 'eager' : 'lazy'} />
        <span class="sd-hero__scrim" aria-hidden="true"></span>
        <div class="sd-hero__caja">
          <h1>{s.kicker} <span aria-hidden="true">{s.emoji}</span></h1>
          <p>{s.texto}</p>
          <a href="#preguntas" class="sd-btn sd-btn--teal-solido">{s.cta}</a>
        </div>
      </article>
    ))}
  </div>

  <button type="button" class="sd-hero__flecha sd-hero__flecha--izq" id="sd-hero-prev" aria-label="Anterior">
    <Icono nombre="flechaIzq" size={20} />
  </button>
  <button type="button" class="sd-hero__flecha sd-hero__flecha--der" id="sd-hero-next" aria-label="Siguiente">
    <Icono nombre="flechaDer" size={20} />
  </button>

  <div class="sd-hero__dots" id="sd-hero-dots">
    {slides.map((_, i: number) => (
      <button type="button" class={`sd-hero__dot${i === 0 ? ' is-on' : ''}`} data-dot={i} aria-label={`Ir a la diapositiva ${i + 1}`}></button>
    ))}
  </div>
</section>

<script>
  const track = document.getElementById('sd-hero-track');
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.sd-hero__dot'));
  const total = track ? track.children.length : 0;
  let idx = 0;

  function ir(n: number) {
    if (!track) return;
    idx = (n + total) % total;
    track.style.transform = `translateX(-${idx * 100}%)`;
    dots.forEach((d, i) => d.classList.toggle('is-on', i === idx));
  }

  document.getElementById('sd-hero-prev')?.addEventListener('click', () => ir(idx - 1));
  document.getElementById('sd-hero-next')?.addEventListener('click', () => ir(idx + 1));
  dots.forEach((d) => d.addEventListener('click', () => ir(Number(d.dataset.dot))));

  let timer = window.setInterval(() => ir(idx + 1), 6500);
  const box = document.getElementById('top');
  box?.addEventListener('mouseenter', () => window.clearInterval(timer));
  box?.addEventListener('mouseleave', () => (timer = window.setInterval(() => ir(idx + 1), 6500)));
</script>

<style>
  .sd-hero {
    position: relative;
    height: clamp(440px, 58vw, 640px);
    overflow: hidden;
    background: var(--sd-tinta);
  }

  .sd-hero__track {
    display: flex;
    height: 100%;
    transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .sd-hero__slide {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
  }

  .sd-hero__slide img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sd-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(13, 27, 33, 0.72) 0%, rgba(13, 27, 33, 0.35) 42%, rgba(13, 27, 33, 0.05) 68%);
  }

  .sd-hero__caja {
    position: absolute;
    left: clamp(1.25rem, 5vw, 6rem);
    bottom: clamp(2rem, 7vw, 4.5rem);
    max-width: 34rem;
    color: #fff;
  }

  .sd-hero__caja h1 {
    color: #fff;
    font-size: clamp(1.7rem, 3.6vw, 2.5rem);
    margin-bottom: 0.9rem;
  }

  .sd-hero__caja p {
    font-size: clamp(0.9rem, 1.5vw, 1rem);
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 1.5rem;
  }

  .sd-hero__flecha {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.3);
    transition: background 0.2s ease;
  }

  .sd-hero__flecha:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .sd-hero__flecha--izq {
    left: clamp(0.6rem, 2vw, 1.5rem);
  }

  .sd-hero__flecha--der {
    right: clamp(0.6rem, 2vw, 1.5rem);
  }

  .sd-hero__dots {
    position: absolute;
    right: clamp(1.25rem, 5vw, 2.5rem);
    bottom: 1rem;
    z-index: 3;
    display: flex;
    gap: 0.5rem;
  }

  .sd-hero__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.45);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .sd-hero__dot.is-on {
    background: var(--sd-amarillo);
    transform: scale(1.2);
  }

  @media (max-width: 640px) {
    .sd-hero__flecha {
      width: 36px;
      height: 36px;
    }

    .sd-hero__caja {
      max-width: 90%;
    }
  }
</style>
