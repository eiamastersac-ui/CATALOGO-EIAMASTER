---
import { dentistas } from '../datos/clinica.js';

interface Dentista {
  nombre: string;
  cargo: string;
  rne: string;
  img: string;
}
const lista = dentistas.lista as Dentista[];
---

<section class="sd-dent" id="dentistas">
  <div class="sd-dent__banda sd-reveal">
    <h2 class="sd-titulo--linea sd-centro sd-dent__titulo">Nuestros Dentistas</h2>
    <p class="sd-dent__sub">Odontólogos y ortodoncistas experimentados:</p>
  </div>

  <div class="sd-wrap sd-dent__grid">
    <div class="sd-dent__foto sd-reveal">
      <img src={dentistas.img} alt="Consultorio de tu tienda.com Dental Care" loading="lazy" />
    </div>
    <div class="sd-dent__texto sd-reveal sd-reveal--2">
      <p>{dentistas.p1}</p>
      <p>{dentistas.p2}</p>
      <p>{dentistas.p3}</p>

      <div class="sd-dent__equipo">
        {lista.map((d: Dentista) => (
          <div class="sd-dent__card">
            <img src={d.img} alt={d.nombre} loading="lazy" />
            <div class="sd-dent__nombre">
              <b>{d.nombre}</b>
              <span>{d.cargo} · {d.rne}</span>
            </div>
          </div>
        ))}
      </div>

      <a href="#preguntas" class="sd-btn sd-btn--teal-solido sd-dent__cta">{dentistas.cta}</a>
    </div>
  </div>
</section>

<style>
  .sd-dent {
    background: var(--sd-crema);
  }

  .sd-dent__banda {
    background: var(--sd-teal);
    padding-block: clamp(2rem, 5vw, 2.75rem);
    text-align: center;
  }

  .sd-dent__titulo {
    color: #fff;
    font-size: clamp(1.4rem, 3vw, 2rem);
  }

  .sd-dent__titulo::after {
    background: var(--sd-amarillo);
  }

  .sd-dent__sub {
    color: rgba(255, 255, 255, 0.9);
    margin-top: 0.6rem;
    font-size: 0.92rem;
  }

  .sd-dent__grid {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: clamp(1.75rem, 5vw, 3rem);
    padding-block: clamp(2.5rem, 6vw, 3.5rem);
    align-items: start;
  }

  .sd-dent__foto {
    border: 3px solid var(--sd-amarillo);
    border-radius: 4px;
    overflow: hidden;
  }

  .sd-dent__texto p {
    font-size: 0.94rem;
    margin-bottom: 1rem;
  }

  .sd-dent__equipo {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-block: 1.5rem;
  }

  .sd-dent__card {
    border-top: 4px solid var(--sd-amarillo);
    background: #fff;
  }

  .sd-dent__card img {
    aspect-ratio: 1 / 1;
    width: 100%;
    object-fit: cover;
  }

  .sd-dent__nombre {
    background: var(--sd-amarillo);
    padding: 0.75rem 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .sd-dent__nombre b {
    font-size: 0.86rem;
    color: var(--sd-tinta);
  }

  .sd-dent__nombre span {
    font-size: 0.72rem;
    color: #4a3c00;
  }

  @media (max-width: 860px) {
    .sd-dent__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .sd-dent__equipo {
      grid-template-columns: 1fr;
    }
  }
</style>
