---
import { compromiso, servicios, waHref } from '../datos/servicios.js';
import Icono from '../componentes/Icono.astro';

interface Servicio {
  t: string;
  d: string;
  img: string;
}
---

<section class="sg-comp sg-seccion" id="servicios">
  <div class="sg-wrap">
    <header class="sg-comp__cab sg-reveal">
      <span class="sg-comp__linea" aria-hidden="true"></span>
      <h2 class="sg-titulo">{compromiso.titulo}</h2>
      <p class="sg-comp__lead">{compromiso.lead}</p>
      <p class="sg-texto sg-comp__texto">{compromiso.texto}</p>
    </header>

    <ul class="sg-comp__grid">
      {servicios.map((s: Servicio, i: number) => (
        <li class={`sg-comp__card sg-reveal sg-reveal--${Math.min(i, 3)}`}>
          <a href={`${waHref}%20de%20${encodeURIComponent(s.t.toLowerCase())}`} target="_blank" rel="noopener">
            <img src={s.img} alt={s.t} loading="lazy" />
            <span class="sg-comp__num">{String(i + 1).padStart(2, '0')}</span>
            <div class="sg-comp__info">
              <h3>{s.t}</h3>
              <p>{s.d}</p>
              <span class="sg-comp__cta">
                Pedir presupuesto <Icono nombre="flecha" size={15} />
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .sg-comp {
    background: var(--sg-papel);
  }

  .sg-comp__cab {
    position: relative;
    max-width: 46rem;
    margin: 0 auto clamp(2.5rem, 5vw, 3.75rem);
    text-align: center;
  }

  .sg-comp__linea {
    position: absolute;
    right: calc(100% + 1.5rem);
    top: 0.7em;
    width: 150px;
    height: 4px;
    background: var(--sg-azul);
  }

  .sg-comp__cab .sg-titulo {
    margin-bottom: 1.1rem;
  }

  .sg-comp__lead {
    font-weight: 600;
    font-size: 0.98rem;
    margin-bottom: 1rem;
  }

  .sg-comp__texto {
    max-width: 62ch;
    margin-inline: auto;
  }

  .sg-comp__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.1rem;
  }

  .sg-comp__card a {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    border-radius: var(--sg-radio);
    overflow: hidden;
    background: var(--sg-tinta);
    color: var(--sg-blanco);
  }

  .sg-comp__card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* scrim oscuro para legibilidad del texto (no decorativo) */
  .sg-comp__card a::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 10, 10, 0) 30%, rgba(10, 10, 10, 0.55) 58%, rgba(10, 10, 10, 0.9) 100%);
    transition: background 0.4s ease;
  }

  .sg-comp__card a:hover img {
    transform: scale(1.06);
  }

  .sg-comp__num {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    background: var(--sg-blanco);
    color: var(--sg-tinta);
    padding: 0.3rem 0.55rem;
    border-radius: 4px;
  }

  .sg-comp__info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: 1.25rem;
  }

  .sg-comp__info h3 {
    font-size: 1.3rem;
    margin-bottom: 0.4rem;
  }

  .sg-comp__info p {
    font-size: 0.8rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.82);
    margin-bottom: 0.8rem;
  }

  .sg-comp__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    padding-bottom: 0.2rem;
    border-bottom: 2px solid var(--sg-azul);
  }

  .sg-comp__card a:hover .sg-comp__cta {
    border-color: var(--sg-blanco);
  }

  @media (max-width: 1100px) {
    .sg-comp__linea {
      position: static;
      display: block;
      width: 80px;
      margin: 0 auto 1.4rem;
    }
  }

  @media (max-width: 960px) {
    .sg-comp__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .sg-comp__grid {
      grid-template-columns: 1fr;
    }
    .sg-comp__card a {
      aspect-ratio: 4 / 3.4;
    }
  }
</style>
