---
import { sobreNosotros } from '../datos/mercadoflores.js';
---

<section class="mf-sobre mf-seccion" id="sobre-nosotros">
  <div class="mf-wrap mf-sobre__grid">
    <div class="mf-sobre__fotos">
      <img class="mf-sobre__foto-grande" src={sobreNosotros.img} alt="Florería tienda.com" loading="lazy" width="900" height="1000" />
      <img class="mf-sobre__foto-chica" src={sobreNosotros.imgChica} alt="Detalle de una rosa" loading="lazy" width="420" height="500" />
    </div>
    <div class="mf-sobre__texto">
      <span class="mf-kicker">{sobreNosotros.kicker}</span>
      <h2>{sobreNosotros.titulo}</h2>
      <p class="mf-sub">{sobreNosotros.texto}</p>
      <a href="#seleccion" class="mf-btn mf-btn--tinta">Descubre la colección</a>
    </div>
  </div>
</section>

<style>
  .mf-sobre__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: center;
  }

  .mf-sobre__fotos {
    position: relative;
  }

  .mf-sobre__foto-grande {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 4px;
  }

  .mf-sobre__foto-chica {
    position: absolute;
    right: -1.5rem;
    bottom: -1.75rem;
    width: 42%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 4px;
    border: 6px solid var(--mf-papel);
    box-shadow: 0 26px 44px -22px rgba(36, 31, 27, 0.4);
  }

  .mf-sobre__texto h2 {
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    font-weight: 500;
    font-style: italic;
    margin-bottom: 1rem;
  }

  .mf-sobre__texto p {
    max-width: 46ch;
    margin-bottom: 1.75rem;
  }

  @media (max-width: 820px) {
    .mf-sobre__grid {
      grid-template-columns: 1fr;
    }
    .mf-sobre__fotos {
      margin-bottom: 2.5rem;
    }
  }
</style>
