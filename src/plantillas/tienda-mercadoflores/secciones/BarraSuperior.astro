---
import { marca } from '../datos/mercadoflores.js';
---

<div class="mf-fila-top" id="mf-fila-top">
  <div class="mf-wrap mf-fila-top__row">
    <a href="#seleccion" class="mf-fila-top__promo">Flores amarillas</a>

    <a href="#top" class="mf-logo" aria-label={`${marca.nombre} ${marca.sub}`}>
      <svg class="mf-logo__ico" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M12 3c1.6 1.5 1.9 3.2 1.1 4.9C14.7 6.9 16.5 7.2 18 8.8c-1.5 1.6-3.2 1.9-4.9 1.1 1.9 1.4 2.2 3.1.6 4.7-1.5-1.5-1.9-3.2-1.1-4.9-1.7.8-3.4.5-4.9-1 1.5-1.6 3.2-1.9 4.9-1.1C11.7 6 11.4 4.3 12 3Z"/>
        <path d="M11.3 11.7h1.4V21h-1.4z"/>
      </svg>
      <span class="mf-logo__tx">{marca.nombre}<b>{marca.sub}</b></span>
    </a>

    <div class="mf-fila-top__acc">
      <a href={`tel:${marca.tel}`} class="mf-fila-top__tel">
        {marca.tel}
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <button type="button" class="mf-fila-top__ico" id="mf-buscar-btn" aria-label="Buscar">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
      <a href="#seleccion" class="mf-fila-top__ico" aria-label="Favoritos">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.8 8.6c0 4.5-8.8 10.4-8.8 10.4S3.2 13.1 3.2 8.6a4.8 4.8 0 0 1 8.8-2.7 4.8 4.8 0 0 1 8.8 2.7Z"/></svg>
      </a>
      <button type="button" class="mf-fila-top__ico mf-fila-top__cart" id="mf-cart" aria-label="Ver carrito">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6 5 3H2"/><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/></svg>
        <span class="mf-fila-top__badge" id="mf-cart-count" hidden>0</span>
      </button>
    </div>
  </div>

  <form class="mf-buscar" id="mf-buscar" role="search" hidden>
    <div class="mf-wrap mf-buscar__row">
      <input type="search" id="mf-buscar-input" placeholder="Buscar flores, ramos, arreglos..." aria-label="Buscar productos" />
      <button type="submit" class="mf-btn mf-btn--tinta">Buscar</button>
    </div>
  </form>
</div>
<span id="top"></span>

<script>
  const fila = document.getElementById('mf-fila-top');
  window.addEventListener(
    'scroll',
    () => {
      fila?.classList.toggle('is-scrolled', window.scrollY > 40);
    },
    { passive: true },
  );

  const buscarBtn = document.getElementById('mf-buscar-btn');
  const buscarPanel = document.getElementById('mf-buscar') as HTMLElement | null;
  buscarBtn?.addEventListener('click', () => {
    if (buscarPanel) buscarPanel.hidden = !buscarPanel.hidden;
  });

  const form = document.getElementById('mf-buscar');
  const input = document.getElementById('mf-buscar-input') as HTMLInputElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = (input?.value || '').trim().toLowerCase();
    const grid = document.getElementById('mf-seleccion-grid');
    const nota = document.getElementById('mf-seleccion-nota');
    if (!grid) return;
    let visibles = 0;
    grid.querySelectorAll<HTMLElement>('.mf-prod').forEach((card) => {
      const hit = !q || (card.dataset.nombre || '').includes(q);
      card.hidden = !hit;
      if (hit) visibles++;
    });
    if (nota) {
      nota.hidden = !q;
      nota.textContent = q ? `${visibles} resultado(s) para "${q}"` : '';
    }
    document.getElementById('seleccion')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

<style>
  .mf-fila-top {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    height: var(--mf-fila-top-h, 76px);
    display: flex;
    flex-direction: column;
    color: #fff;
    background: linear-gradient(180deg, rgba(20, 16, 13, 0.45), rgba(20, 16, 13, 0));
    transition: background 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
  }

  .mf-fila-top.is-scrolled {
    background: rgba(250, 245, 236, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--mf-tinta);
    box-shadow: 0 8px 26px -20px rgba(36, 31, 27, 0.5);
  }

  .mf-fila-top__row {
    display: flex;
    align-items: center;
    height: var(--mf-fila-top-h, 76px);
    gap: 1rem;
  }

  .mf-fila-top__promo {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding-block: 0.4rem;
    border-bottom: 1px solid currentColor;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .mf-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline: auto;
    color: inherit;
    flex-shrink: 0;
  }

  .mf-logo__ico {
    flex-shrink: 0;
  }

  .mf-logo__tx {
    font-family: var(--mf-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 1.4rem;
    line-height: 1;
  }

  .mf-logo__tx b {
    display: block;
    font-family: var(--mf-font);
    font-style: normal;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.85;
    margin-top: 0.2rem;
  }

  .mf-fila-top__acc {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-shrink: 0;
    margin-left: auto;
  }

  .mf-fila-top__tel {
    display: none;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .mf-fila-top__ico {
    position: relative;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: inherit;
  }

  .mf-fila-top__ico:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .is-scrolled .mf-fila-top__ico:hover {
    background: var(--mf-papel-osc);
  }

  .mf-fila-top__badge {
    position: absolute;
    top: -2px;
    right: -2px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: var(--mf-pill);
    background: var(--mf-acento);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 700;
    display: grid;
    place-items: center;
  }

  .mf-fila-top__badge[hidden] {
    display: none;
  }

  .mf-buscar {
    background: var(--mf-papel);
    border-bottom: 1px solid var(--mf-linea);
  }

  .mf-buscar[hidden] {
    display: none;
  }

  .mf-buscar__row {
    display: flex;
    gap: 0.75rem;
    padding-block: 0.85rem;
  }

  .mf-buscar input {
    flex: 1;
    border: 1.5px solid var(--mf-linea);
    border-radius: var(--mf-pill);
    padding: 0.6rem 1.1rem;
    font-size: 0.85rem;
    color: var(--mf-tinta);
    background: #fff;
  }

  .mf-buscar input:focus {
    outline: none;
    border-color: var(--mf-acento);
  }

  @media (min-width: 720px) {
    .mf-fila-top__tel {
      display: inline-flex;
    }
  }

  @media (max-width: 620px) {
    .mf-fila-top__promo {
      display: none;
    }
    .mf-logo {
      margin-inline: 0;
    }
  }
</style>
