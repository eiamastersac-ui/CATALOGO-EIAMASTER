---
import { experiencia, marca } from '../datos/mercadoflores.js';

const items = experiencia.items as string[];
const wa = marca.tel.replace(/[^\d]/g, '');
---

<section class="mf-exp" id="experiencia">
  <img class="mf-exp__foto" src={experiencia.img} alt={experiencia.titulo} loading="lazy" width="1100" height="700" />
  <span class="mf-exp__scrim" aria-hidden="true"></span>

  <div class="mf-wrap mf-exp__body">
    <span class="mf-kicker mf-kicker--claro">{experiencia.kicker}</span>
    <h2>{experiencia.titulo}</h2>
    <ul class="mf-exp__lista">
      {items.map((it: string) => (
        <li>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>
          {it}
        </li>
      ))}
    </ul>
    <div class="mf-exp__acciones">
      <a href="#seleccion" class="mf-btn mf-btn--claro">Explorar colección</a>
      <a href={`https://wa.me/${wa}`} target="_blank" rel="noopener" class="mf-btn mf-btn--tinta">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.7 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.7-1.2-4.5-3.9-4.6-4.1-.1-.2-1.1-1.4-1.1-2.7s.7-1.9 1-2.2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5.2.5.7 1.8.8 1.9.1.2.1.3 0 .5-.1.2-.1.3-.3.5-.1.2-.3.4-.4.5-.2.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.7-.1.2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1.2.1 1.5.7 1.8.8.3.1.5.2.5.3.1.2.1.6-.1 1.2Z"/></svg>
        Pedir por WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .mf-exp {
    position: relative;
    min-height: clamp(420px, 60vw, 560px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--mf-tinta);
  }

  .mf-exp__foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mf-exp__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(15, 11, 9, 0.82) 0%, rgba(15, 11, 9, 0.55) 45%, rgba(15, 11, 9, 0.2) 100%);
  }

  .mf-exp__body {
    position: relative;
    z-index: 2;
    padding-block: clamp(3rem, 8vw, 5rem);
    color: #fff;
    max-width: 34rem;
  }

  .mf-exp__body h2 {
    color: #fff;
    font-weight: 500;
    font-style: italic;
    font-size: clamp(1.7rem, 3.6vw, 2.5rem);
    margin-bottom: 1.5rem;
  }

  .mf-exp__lista {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem 1.5rem;
    margin-bottom: 2rem;
  }

  .mf-exp__lista li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.92);
  }

  .mf-exp__lista svg {
    flex-shrink: 0;
    color: var(--mf-acento-suave);
  }

  .mf-exp__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (max-width: 560px) {
    .mf-exp__lista {
      grid-template-columns: 1fr;
    }
  }
</style>
