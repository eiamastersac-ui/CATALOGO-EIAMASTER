---
import { promesa } from '../datos/mercadoflores.js';

interface Item {
  t: string;
  d: string;
}
const items = promesa.items as Item[];
---

<section class="mf-promesa mf-seccion" id="promesa">
  <div class="mf-wrap">
    <div class="mf-promesa__intro">
      <h2>{promesa.titulo}</h2>
      <p class="mf-sub">{promesa.texto}</p>
    </div>

    <div class="mf-promesa__linea" aria-hidden="true"></div>

    <h3 class="mf-titulo mf-promesa__tit">Nuestra promesa</h3>

    <div class="mf-promesa__grid">
      {items.map((it: Item, i: number) => (
        <div class={`mf-promesa__item${i < 3 ? ' mf-promesa__item--top' : ''}`}>
          <h4>{it.t}</h4>
          <p>{it.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .mf-promesa__intro {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .mf-promesa__intro h2 {
    font-size: clamp(1.5rem, 3.2vw, 2.15rem);
    font-weight: 500;
  }

  .mf-promesa__linea {
    height: 1px;
    background: var(--mf-linea);
    margin-block: clamp(2rem, 5vw, 3rem);
  }

  .mf-promesa__tit {
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  .mf-promesa__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--mf-linea);
  }

  .mf-promesa__item {
    padding: 1.6rem 1.5rem 1.6rem 0;
    border-bottom: 1px solid var(--mf-linea);
  }

  .mf-promesa__item:nth-child(3n) {
    padding-right: 0;
  }

  .mf-promesa__item h4 {
    font-size: 1.02rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .mf-promesa__item p {
    font-size: 0.86rem;
    color: var(--mf-tinta-suave);
  }

  @media (max-width: 820px) {
    .mf-promesa__intro {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .mf-promesa__grid {
      grid-template-columns: 1fr;
    }
    .mf-promesa__item {
      padding-right: 0;
    }
  }
</style>
