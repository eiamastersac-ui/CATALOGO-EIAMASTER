---
import './estilos.css';

import BarraSuperior from './secciones/BarraSuperior.astro';
import Cabecera from './secciones/Cabecera.astro';
import Hero from './secciones/Hero.astro';
import Promesa from './secciones/Promesa.astro';
import Seleccion from './secciones/Seleccion.astro';
import Historias from './secciones/Historias.astro';
import TiposFlor from './secciones/TiposFlor.astro';
import Homenajes from './secciones/Homenajes.astro';
import Testimonios from './secciones/Testimonios.astro';
import Entregas from './secciones/Entregas.astro';
import SobreNosotros from './secciones/SobreNosotros.astro';
import Experiencia from './secciones/Experiencia.astro';
import PiePagina from './secciones/PiePagina.astro';
import WhatsappFlotante from './secciones/WhatsappFlotante.astro';
---

<div class="tpl-tienda-mercadoflores">
  <BarraSuperior />
  <Cabecera />
  <main>
    <Hero />
    <Promesa />
    <Seleccion />
    <Historias />
    <TiposFlor />
    <Homenajes />
    <Testimonios />
    <Entregas />
    <SobreNosotros />
    <Experiencia />
  </main>
  <PiePagina />
  <WhatsappFlotante />
</div>
