---
import { hero } from '../datos/clinica.js';

interface Slide {
  kicker: string;
  titulo: string;
  sub: string;
  img: string;
}
const slides = hero.slides as Slide[];
---

<section class="od-hero" id="hero" aria-roledescription="carrusel">
  <div class="od-hero__track" id="od-hero-track">
    {slides.map((s: Slide, i: number) => (
      <article class="od-hero__slide">
        <img src={s.img} alt={s.titulo} loading={i === 0 ? 'eager' : 'lazy'} />
        <span class="od-hero__scrim" aria-hidden="true"></span>
        <div class="od-hero__body od-wrap">
          <div class="od-hero__spacer"></div>
          <div class="od-hero__texto">
            <span class="od-kicker od-kicker--claro">{s.kicker}</span>
            <h1>{s.titulo}</h1>
            <p class="od-hero__sub">{s.sub}</p>
            <div class="od-hero__acciones">
              <a href="#preguntas" class="od-btn od-btn--sobre-foto">Agenda tu evaluación</a>
              <div class="od-hero__tags">
                {hero.tags.map((t: string) => <a href="#especialidades" class="od-hero__tag">{t}</a>)}
              </div>
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="od-hero__card od-reveal">
    <img src={hero.confianza.img} alt={hero.confianza.nombre} loading="lazy" />
    <div>
      <b>{hero.confianza.nombre}</b>
      <span class="od-hero__card-cargo">{hero.confianza.cargo}</span>
      <span class="od-hero__card-rating">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3 7h7l-5.7 4.3L18.3 21 12 16.6 5.7 21l2-7.7L2 9h7z"/></svg>
        {hero.confianza.rating} <span>({hero.confianza.resenas})</span>
      </span>
      <span class="od-hero__card-exp">{hero.confianza.experiencia}</span>
    </div>
  </div>

  <div class="od-hero__nav">
    <span class="od-hero__contador"><b id="od-hero-actual">1</b>/{slides.length}</span>
    <button type="button" class="od-flecha" id="od-hero-prev" aria-label="Anterior">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 6-6 6 6 6"/></svg>
    </button>
    <button type="button" class="od-flecha" id="od-hero-next" aria-label="Siguiente">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6"/></svg>
    </button>
  </div>

  <a href="#especialidades" class="od-hero__scroll" aria-label="Bajar a especialidades">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
  </a>
</section>

<script>
  const track = document.getElementById('od-hero-track');
  const actualEl = document.getElementById('od-hero-actual');
  const total = track ? track.children.length : 0;
  let idx = 0;

  function ir(n: number) {
    if (!track) return;
    idx = (n + total) % total;
    track.style.transform = `translateX(-${idx * 100}%)`;
    if (actualEl) actualEl.textContent = String(idx + 1);
  }

  document.getElementById('od-hero-prev')?.addEventListener('click', () => ir(idx - 1));
  document.getElementById('od-hero-next')?.addEventListener('click', () => ir(idx + 1));

  let timer = window.setInterval(() => ir(idx + 1), 6000);
  const box = document.getElementById('hero');
  box?.addEventListener('mouseenter', () => window.clearInterval(timer));
  box?.addEventListener('mouseleave', () => (timer = window.setInterval(() => ir(idx + 1), 6000)));
</script>

<style>
  .od-hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: var(--od-tinta);
  }

  .od-hero__track {
    display: flex;
    height: 100%;
    transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .od-hero__slide {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
  }

  .od-hero__slide img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .od-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 10, 12, 0.5) 0%, rgba(10, 10, 12, 0.05) 26%, rgba(10, 10, 12, 0.1) 55%, rgba(10, 10, 12, 0.72) 100%);
  }

  .od-hero__body {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding-top: var(--od-hdr-h);
    padding-bottom: clamp(2.5rem, 7vw, 4.5rem);
  }

  .od-hero__spacer {
    flex: 1;
  }

  .od-hero__texto {
    max-width: 42rem;
    color: #fff;
  }

  .od-hero__texto h1 {
    color: #fff;
    font-weight: 700;
    font-size: clamp(2.1rem, 5.2vw, 3.6rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.9rem;
  }

  .od-hero__sub {
    font-size: clamp(0.92rem, 1.6vw, 1.05rem);
    color: rgba(255, 255, 255, 0.86);
    max-width: 40ch;
    margin-bottom: 1.6rem;
  }

  .od-kicker--claro {
    color: #fff;
  }

  .od-kicker--claro::before {
    background: #fff;
  }

  .od-hero__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .od-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .od-hero__tag {
    font-size: 0.76rem;
    font-weight: 600;
    color: #fff;
    padding: 0.5rem 0.9rem;
    border-radius: var(--od-pill);
    border: 1px solid rgba(255, 255, 255, 0.4);
  }

  .od-hero__tag:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .od-hero__card {
    position: absolute;
    right: clamp(1.1rem, 4vw, 2rem);
    bottom: clamp(5.5rem, 11vw, 7.5rem);
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    border-radius: 16px;
    padding: 0.75rem 1.1rem 0.75rem 0.75rem;
    box-shadow: 0 20px 45px -20px rgba(0, 0, 0, 0.45);
  }

  .od-hero__card img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .od-hero__card div {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .od-hero__card b {
    font-size: 0.82rem;
  }

  .od-hero__card-cargo {
    font-size: 0.7rem;
    color: var(--od-gris);
  }

  .od-hero__card-rating {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--od-acento);
    margin-top: 0.15rem;
  }

  .od-hero__card-rating span {
    color: var(--od-gris);
    font-weight: 500;
  }

  .od-hero__card-exp {
    font-size: 0.68rem;
    color: var(--od-gris);
  }

  .od-hero__nav {
    position: absolute;
    right: clamp(1.1rem, 4vw, 2rem);
    bottom: clamp(1.5rem, 4vw, 2.25rem);
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .od-hero__contador {
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    margin-right: 0.4rem;
  }

  .od-hero__contador b {
    font-family: var(--od-display);
  }

  .od-hero__nav .od-flecha {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.4);
    color: #fff;
    width: 38px;
    height: 38px;
  }

  .od-hero__nav .od-flecha:hover {
    background: #fff;
    color: var(--od-tinta);
  }

  .od-hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    z-index: 5;
    color: rgba(255, 255, 255, 0.75);
    animation: od-rebote 2.2s ease-in-out infinite;
  }

  @keyframes od-rebote {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 6px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .od-hero__scroll {
      animation: none;
    }
  }

  @media (max-width: 760px) {
    .od-hero__card {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .od-hero__scroll {
      display: none;
    }
  }
</style>
