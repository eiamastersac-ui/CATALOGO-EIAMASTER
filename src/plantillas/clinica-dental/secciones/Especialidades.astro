---
import { especialidades, hero } from '../datos/clinica.js';
---

<section class="od-seccion" id="especialidades">
  <div class="od-wrap od-esp__cab">
    <div class="od-reveal">
      <span class="od-kicker">Especialidades</span>
      <h2 class="od-titulo">Un tratamiento para cada necesidad</h2>
    </div>
    <div class="od-esp__aparte od-reveal od-reveal--2">
      <p class="od-sub">Ocho especialidades bajo un mismo equipo, coordinadas para que no tengas que repetir tu historia clínica dos veces.</p>
      <div class="od-esp__prueba">
        <span class="od-esp__estrella">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3 7h7l-5.7 4.3L18.3 21 12 16.6 5.7 21l2-7.7L2 9h7z"/></svg>
        </span>
        <b>{hero.confianza.resenas * 12}+</b> reseñas de pacientes
      </div>
    </div>
  </div>

  <div class="od-wrap od-esp__area">
    <button type="button" class="od-flecha od-esp__prev" aria-label="Anterior">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 6-6 6 6 6"/></svg>
    </button>
    <div class="od-fila od-esp__fila" id="od-esp-fila">
      {especialidades.map((e: { img: string; t: string; d: string }, i: number) => (
        <a href="#preguntas" class={`od-esp__card od-reveal od-reveal--${(i % 4) + 1}`}>
          <img src={e.img} alt={e.t} loading="lazy" />
          <span class="od-esp__scrim" aria-hidden="true"></span>
          <span class="od-esp__etiqueta">
            {e.t}
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M7 17 17 7M9 7h8v8"/></svg>
          </span>
        </a>
      ))}
    </div>
    <button type="button" class="od-flecha od-esp__next" aria-label="Siguiente">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6"/></svg>
    </button>
  </div>
</section>

<script>
  const fila = document.getElementById('od-esp-fila');
  document.querySelectorAll<HTMLButtonElement>('.od-esp__prev, .od-esp__next').forEach((btn) => {
    btn.addEventListener('click', () => {
      const dir = btn.classList.contains('od-esp__next') ? 1 : -1;
      fila?.scrollBy({ left: dir * 300, behavior: 'smooth' });
    });
  });
</script>

<style>
  .od-esp__cab {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: clamp(2rem, 5vw, 2.75rem);
  }

  .od-esp__aparte {
    max-width: 22rem;
    text-align: right;
  }

  .od-esp__aparte .od-sub {
    max-width: none;
    margin-bottom: 0.6rem;
  }

  .od-esp__prueba {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--od-gris);
  }

  .od-esp__estrella {
    color: var(--od-acento);
    display: inline-flex;
  }

  .od-esp__prueba b {
    color: var(--od-tinta);
  }

  .od-esp__area {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .od-esp__area .od-fila {
    flex: 1;
  }

  .od-esp__fila {
    grid-auto-columns: minmax(240px, 1fr);
  }

  .od-esp__card {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 20px;
    overflow: hidden;
  }

  .od-esp__card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .od-esp__card:hover img {
    transform: scale(1.06);
  }

  .od-esp__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(10, 10, 12, 0.75) 0%, rgba(10, 10, 12, 0.05) 45%);
  }

  .od-esp__etiqueta {
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    color: #fff;
    font-weight: 600;
    font-size: 0.88rem;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(6px);
    padding: 0.65rem 0.6rem 0.65rem 0.9rem;
    border-radius: var(--od-pill);
  }

  .od-esp__etiqueta svg {
    flex-shrink: 0;
    background: #fff;
    color: var(--od-tinta);
    border-radius: 50%;
    padding: 0.3rem;
    box-sizing: content-box;
  }

  @media (min-width: 1080px) {
    #od-esp-fila {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-flow: row;
      overflow: visible;
    }
    .od-esp__prev,
    .od-esp__next {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .od-esp__cab {
      flex-direction: column;
      align-items: flex-start;
    }
    .od-esp__aparte {
      text-align: left;
      max-width: none;
    }
    .od-esp__prueba {
      justify-content: flex-start;
    }
  }
</style>
