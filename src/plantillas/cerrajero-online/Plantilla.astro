---
import './estilos.css';

import Cabecera from './secciones/Cabecera.astro';
import Hero from './secciones/Hero.astro';
import Intro from './secciones/Intro.astro';
import Servicios from './secciones/Servicios.astro';
import BloquesSeo from './secciones/BloquesSeo.astro';
import Opiniones from './secciones/Opiniones.astro';
import Blog from './secciones/Blog.astro';
import Videos from './secciones/Videos.astro';
import Ventajas from './secciones/Ventajas.astro';
import BandaLlamada from './secciones/BandaLlamada.astro';
import Contacto from './secciones/Contacto.astro';
import Zonas from './secciones/Zonas.astro';
import Preguntas from './secciones/Preguntas.astro';
import Newsletter from './secciones/Newsletter.astro';
import PiePagina from './secciones/PiePagina.astro';
import AvisoCookies from './secciones/AvisoCookies.astro';
import LlamarFlotante from './secciones/LlamarFlotante.astro';
import RevelarScroll from './componentes/RevelarScroll.astro';
---

<div class="tpl-cerrajero-online">
  <span id="top"></span>
  <Cabecera />
  <main>
    <Hero />
    <Intro />
    <Servicios />
    <BloquesSeo />
    <Opiniones />
    <Blog />
    <Videos />
    <Ventajas />
    <BandaLlamada />
    <Contacto />
    <Zonas />
    <Preguntas />
    <Newsletter />
  </main>
  <PiePagina />
  <AvisoCookies />
  <LlamarFlotante />
  <RevelarScroll />
</div>
