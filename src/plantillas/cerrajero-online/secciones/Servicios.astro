---
import { servicios, marca } from '../datos/cerrajeria.js';
import Icono from '../componentes/Icono.astro';

interface Servicio { t: string; d: string; img: string; tag: string }
const lista = servicios as Servicio[];
---

<section class="co-seccion co-seccion--panel co-serv" id="servicios">
  <div class="co-wrap">
    <div class="co-cab co-cab--centro co-reveal">
      <span class="co-kicker">Todos los servicios</span>
      <h2 class="co-titulo">Servicios de cerrajería</h2>
      <p class="co-sub">Para particulares, empresas y comunidades de propietarios en Madrid capital y pueblos colindantes.</p>
    </div>

    <p class="co-resultados" id="co-resultados" hidden></p>

    <ul class="co-serv__grid">
      {lista.map((s: Servicio, i: number) => (
        <li class={`co-servicio co-reveal co-reveal--${i % 3}`} data-nombre={`${s.t} ${s.d} ${s.tag}`}>
          <a href={`tel:${marca.telCrudo}`} class="co-serv__card" aria-label={`${s.t} — llamar`}>
            <img src={s.img} alt="" loading="lazy" />
            <span class="co-serv__scrim" aria-hidden="true"></span>
            <span class="co-serv__tag">{s.tag}</span>
            <span class="co-serv__pie">
              <b>{s.t}</b>
              <span class="co-serv__desc">{s.d}</span>
              <span class="co-serv__mas">
                Solicitar <Icono nombre="flecha" size={14} grosor={2} />
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .co-serv__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .co-serv__card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 4.6;
    border-radius: var(--co-radio);
    overflow: hidden;
    background: var(--co-tinta);
    color: #fff;
  }

  .co-serv__card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .co-serv__card:hover img {
    transform: scale(1.05);
  }

  .co-serv__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 38%, rgba(0, 0, 0, 0.78) 100%);
  }

  .co-serv__tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.94);
    color: var(--co-titulo);
  }

  .co-serv__pie {
    position: absolute;
    left: 1.25rem;
    right: 1.25rem;
    bottom: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .co-serv__pie b {
    font-size: 1.2rem;
    line-height: 1.25;
  }

  .co-serv__desc {
    font-size: 0.86rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.82);
  }

  .co-serv__mas {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    border-bottom: 2px solid var(--co-naranja);
    align-self: flex-start;
    padding-bottom: 0.1rem;
  }

  @media (max-width: 900px) {
    .co-serv__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .co-serv__grid {
      grid-template-columns: 1fr;
    }
    .co-serv__card {
      aspect-ratio: 16 / 12;
    }
  }
</style>
