---
import { cta, marca } from '../datos/cerrajeria.js';
import Icono from '../componentes/Icono.astro';
---

<section class="co-banda" id="llamada" aria-label={cta.sub}>
  <img src={cta.img} alt="" loading="lazy" />
  <span class="co-banda__scrim" aria-hidden="true"></span>
  <svg class="co-banda__divisor" viewBox="0 0 1280 140" preserveAspectRatio="none" aria-hidden="true">
    <path d="M1280 0H0c706.92 0 1280 140 1280 140z" fill="#fff" fill-opacity=".3" />
    <path d="M1280 0H0c706.92 0 1280 110 1280 110z" fill="#fff" fill-opacity=".5" />
    <path d="M1280 0H0c706.92 0 1280 80 1280 80z" fill="#fff" />
  </svg>
  <div class="co-wrap co-banda__body co-reveal">
    <h2>{cta.titulo}</h2>
    <p>{cta.sub}</p>
    <a href={`tel:${marca.telCrudo}`} class="co-btn co-btn--naranja">
      <Icono nombre="telefono" size={17} grosor={2} /> Llámenos: {marca.tel}
    </a>
  </div>
</section>

<style>
  .co-banda {
    position: relative;
    min-height: clamp(420px, 60vh, 560px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--co-pizarra);
    color: #fff;
  }

  .co-banda img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .co-banda__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(70deg, rgba(40, 61, 75, 0.92) 0%, rgba(40, 61, 75, 0.6) 50%, rgba(128, 103, 79, 0.35) 100%);
  }

  .co-banda__divisor {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: clamp(50px, 9vw, 120px);
    z-index: 1;
  }

  .co-banda__body {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-block: clamp(6rem, 12vw, 8rem) clamp(3rem, 7vw, 4.5rem);
  }

  .co-banda h2 {
    font-family: var(--co-display);
    color: #fff;
    font-size: clamp(2.2rem, 5.5vw, 3.8rem);
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }

  .co-banda p {
    font-family: var(--co-display);
    font-size: clamp(1.1rem, 2.4vw, 1.6rem);
    color: rgba(255, 255, 255, 0.78);
    margin-bottom: 1.8rem;
  }

  .co-banda .co-btn {
    padding: 0.95rem 1.8rem;
    font-size: 1rem;
  }
</style>
