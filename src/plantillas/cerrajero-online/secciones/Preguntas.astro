---
import { faqs } from '../datos/cerrajeria.js';
import Icono from '../componentes/Icono.astro';

interface Faq { p: string; r: string }
const lista = faqs as Faq[];
---

<section class="co-seccion co-faq" id="preguntas">
  <div class="co-wrap co-faq__inner">
    <div class="co-cab co-cab--centro co-reveal">
      <h2 class="co-titulo co-titulo--normal co-faq__titulo">Preguntas frecuentes</h2>
    </div>
    <div class="co-faq__lista co-reveal" id="co-faq">
      {lista.map((f: Faq, i: number) => (
        <details class="co-faq__item" open={i === 0}>
          <summary>
            <span>{f.p}</span>
            <span class="co-faq__mas" aria-hidden="true"><Icono nombre="abajo" size={18} grosor={2} /></span>
          </summary>
          <p>{f.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  // Acordeon: solo una pregunta abierta a la vez
  const items = Array.from(document.querySelectorAll<HTMLDetailsElement>('#co-faq .co-faq__item'));
  items.forEach((d) =>
    d.addEventListener('toggle', () => {
      if (d.open) items.forEach((o) => o !== d && (o.open = false));
    }),
  );
</script>

<style>
  .co-faq__inner {
    max-width: 62rem;
  }

  .co-faq__titulo {
    font-weight: 500;
  }

  .co-faq__lista {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .co-faq__item {
    border: 1px solid #d9d9d9;
    background: var(--co-blanco);
    transition: background 0.2s ease;
  }

  .co-faq__item:not([open]) {
    background: var(--co-panel);
  }

  .co-faq__item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.4rem;
    font-size: 1.05rem;
    color: var(--co-titulo);
  }

  .co-faq__item summary::-webkit-details-marker {
    display: none;
  }

  .co-faq__item[open] summary {
    font-size: 1.15rem;
    font-weight: 600;
  }

  .co-faq__mas {
    color: #bbb;
    transition: transform 0.25s ease, color 0.2s ease;
    flex-shrink: 0;
  }

  .co-faq__item[open] .co-faq__mas {
    transform: rotate(180deg);
    color: var(--co-naranja);
  }

  .co-faq__item p {
    padding: 0 1.4rem 1.3rem;
    color: var(--co-gris);
    font-size: 0.93rem;
  }
</style>
