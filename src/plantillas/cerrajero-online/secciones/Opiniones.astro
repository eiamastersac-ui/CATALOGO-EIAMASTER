---
import { opiniones } from '../datos/cerrajeria.js';
import Icono from '../componentes/Icono.astro';

interface Opinion { txt: string; nombre: string; lugar: string; estrellas: number }
const lista = opiniones as Opinion[];
const iniciales = (n: string) =>
  n
    .split(' ')
    .map((p: string) => p[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<section class="co-seccion co-op" id="opiniones">
  <div class="co-wrap co-op__inner">
    <div class="co-cab co-cab--centro co-reveal">
      <span class="co-kicker">4,9 / 5 en reseñas verificadas</span>
      <h2 class="co-titulo co-titulo--normal">Opiniones de nuestros clientes</h2>
    </div>

    <div class="co-op__caja co-reveal" id="co-op">
      <span class="co-op__comillas" aria-hidden="true"><Icono nombre="comillas" size={40} /></span>
      <div class="co-op__viewport">
        <div class="co-op__track" id="co-op-track">
          {lista.map((o: Opinion) => (
            <figure class="co-op__slide">
              <div class="co-op__estrellas" aria-label={`${o.estrellas} de 5 estrellas`}>
                {Array.from({ length: o.estrellas }).map(() => <Icono nombre="estrella" size={16} />)}
              </div>
              <blockquote>{o.txt}</blockquote>
              <figcaption>
                <span class="co-op__avatar" aria-hidden="true">{iniciales(o.nombre)}</span>
                <span><b>{o.nombre}</b><small>{o.lugar}</small></span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
      <div class="co-op__nav">
        <button type="button" class="co-flecha co-flecha--izq" id="co-op-prev" aria-label="Opinión anterior">
          <Icono nombre="chevron" size={16} grosor={2} />
        </button>
        <div class="co-dots co-dots--oscuro" id="co-op-dots">
          {lista.map((_o: Opinion, i: number) => (
            <button type="button" class={`co-dot${i === 0 ? ' is-activo' : ''}`} aria-label={`Ir a opinión ${i + 1}`}></button>
          ))}
        </div>
        <button type="button" class="co-flecha" id="co-op-next" aria-label="Opinión siguiente">
          <Icono nombre="chevron" size={16} grosor={2} />
        </button>
      </div>
    </div>

    <div class="co-op__links co-reveal">
      <a href="#opiniones">Ver más reseñas en Google</a>
      <a href="#opiniones">Ver más reseñas en Facebook</a>
    </div>
    <div class="co-op__cta co-reveal">
      <a href="#opiniones" class="co-btn co-btn--borde">Lea más opiniones</a>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('co-op-track');
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('#co-op-dots .co-dot'));
  const total = dots.length;
  let idx = 0;

  function ir(n: number) {
    if (!track || !total) return;
    idx = (n + total) % total;
    track.style.transform = `translateX(-${idx * 100}%)`;
    dots.forEach((d, i) => d.classList.toggle('is-activo', i === idx));
  }

  document.getElementById('co-op-prev')?.addEventListener('click', () => ir(idx - 1));
  document.getElementById('co-op-next')?.addEventListener('click', () => ir(idx + 1));
  dots.forEach((d, i) => d.addEventListener('click', () => ir(i)));

  let timer = window.setInterval(() => ir(idx + 1), 7000);
  const caja = document.getElementById('co-op');
  caja?.addEventListener('mouseenter', () => window.clearInterval(timer));
  caja?.addEventListener('mouseleave', () => {
    window.clearInterval(timer);
    timer = window.setInterval(() => ir(idx + 1), 7000);
  });
</script>

<style>
  .co-op {
    padding-top: clamp(3rem, 7vw, 4.5rem);
  }

  .co-op__inner {
    max-width: 58rem;
  }

  .co-op__caja {
    position: relative;
    background: var(--co-panel);
    border-radius: var(--co-radio);
    padding: clamp(2rem, 5vw, 3rem) clamp(1.25rem, 5vw, 3.5rem) 1.75rem;
  }

  .co-op__comillas {
    position: absolute;
    top: -20px;
    left: clamp(1.25rem, 5vw, 3.5rem);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--co-blanco);
    color: var(--co-naranja);
    display: grid;
    place-items: center;
    box-shadow: 0 6px 18px -8px rgba(0, 0, 0, 0.25);
  }

  .co-op__comillas :global(svg) {
    width: 24px;
    height: 24px;
  }

  .co-op__viewport {
    overflow: hidden;
  }

  .co-op__track {
    display: flex;
    transition: transform 0.55s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .co-op__slide {
    flex: 0 0 100%;
    padding-right: 0.5rem;
  }

  .co-op__estrellas {
    display: flex;
    gap: 0.2rem;
    color: var(--co-naranja);
    margin-bottom: 0.9rem;
  }

  .co-op__slide blockquote {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.65;
    font-style: italic;
    color: var(--co-titulo);
    margin-bottom: 1.4rem;
  }

  .co-op__slide figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .co-op__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--co-tinta);
    color: #fff;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 0.85rem;
  }

  .co-op__slide figcaption b {
    display: block;
    color: var(--co-titulo);
    font-size: 0.95rem;
    line-height: 1.2;
  }

  .co-op__slide figcaption small {
    color: var(--co-gris);
    font-size: 0.8rem;
  }

  .co-op__nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.9rem;
    margin-top: 1.25rem;
  }

  .co-op__links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    margin-top: 1.75rem;
    font-size: 0.88rem;
  }

  .co-op__links a {
    color: var(--co-naranja);
  }

  .co-op__links a:hover {
    text-decoration: underline;
  }

  .co-op__cta {
    display: flex;
    justify-content: center;
    margin-top: 1.4rem;
  }
</style>
