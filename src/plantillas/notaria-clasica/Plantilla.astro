---
import './estilos.css';

import Cabecera from './secciones/Cabecera.astro';
import Hero from './secciones/Hero.astro';
import Servicios from './secciones/Servicios.astro';
import Recurrentes from './secciones/Recurrentes.astro';
import ConsultaLinea from './secciones/ConsultaLinea.astro';
import Tramites from './secciones/Tramites.astro';
import Nosotros from './secciones/Nosotros.astro';
import Valores from './secciones/Valores.astro';
import Financiamiento from './secciones/Financiamiento.astro';
import Pagos from './secciones/Pagos.astro';
import Certificacion from './secciones/Certificacion.astro';
import Contacto from './secciones/Contacto.astro';
import PiePagina from './secciones/PiePagina.astro';
import Flotantes from './secciones/Flotantes.astro';
---

<div class="tpl-notaria-clasica">
  <Cabecera />
  <main>
    <Hero />
    <Servicios />
    <Recurrentes />
    <ConsultaLinea />
    <Tramites />
    <Nosotros />
    <Valores />
    <Financiamiento />
    <Pagos />
    <Certificacion />
    <Contacto />
  </main>
  <PiePagina />
  <Flotantes />
</div>
