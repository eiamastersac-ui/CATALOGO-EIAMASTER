---
import Icono from '../componentes/Icono.astro';
import { consulta } from '../datos/notaria.js';

interface Tipo { id: string; t: string; label: string; ph: string; patron: string }
const tipos = consulta.tipos as Tipo[];
const categorias = [
  { t: 'Consulta de Contratos', ico: 'doc' },
  { t: 'Contratos Corporativos', ico: 'edificio' },
  { t: 'Cartas Notariales', ico: 'mail' },
  { t: 'Autenticidad de Documentos', ico: 'escudo' },
  { t: 'Facturación Electrónica', ico: 'libro' },
];
const r = consulta.resultado;
---

<section class="ncl-seccion ncl-cons" id="ncl-consulta" aria-labelledby="ncl-cons-t">
  <div class="ncl-wrap">
    <div class="ncl-cons__cab">
      <span class="ncl-kicker">Consultas en Línea</span>
      <h2 class="ncl-titulo" id="ncl-cons-t">Consulta el estado de tu trámite</h2>
      <p class="ncl-lead">{consulta.texto}</p>
    </div>

    <ul class="ncl-cons__cats" role="tablist" aria-label="Tipo de consulta">
      {categorias.map((c, i) => (
        <li>
          <button
            type="button"
            class={`ncl-cons__cat${i === 0 ? ' is-on' : ''}`}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            data-cat={c.t}
          >
            <span class="ncl-cons__cat-ico"><Icono n={c.ico} size={30} /></span>
            <span>{c.t}</span>
          </button>
        </li>
      ))}
    </ul>

    <div class="ncl-cons__caja">
      <h3 id="ncl-cons-cat">Consulta de Contratos</h3>

      <div class="ncl-cons__tabs" role="tablist" aria-label="Buscar por">
        {tipos.map((t, i) => (
          <button
            type="button"
            class={`ncl-cons__tab${i === 0 ? ' is-on' : ''}`}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            data-tipo={t.id}
            data-label={t.label}
            data-ph={t.ph}
            data-patron={t.patron}
          >{t.t}</button>
        ))}
      </div>

      <form class="ncl-cons__form" id="ncl-cons-form" novalidate>
        <label for="ncl-cons-q" id="ncl-cons-label">{tipos[0].label}</label>
        <div class="ncl-cons__fila">
          <input id="ncl-cons-q" type="text" autocomplete="off" placeholder={tipos[0].ph} />
          <button type="submit" class="ncl-btn ncl-btn--acento"><Icono n="buscar" size={16} />Consultar</button>
          <button type="button" class="ncl-cons__limpiar" id="ncl-cons-limpiar">Limpiar campo</button>
        </div>
        <p class="ncl-cons__error" id="ncl-cons-error" hidden>Ingrese un valor válido para continuar.</p>
      </form>

      <div class="ncl-cons__res" id="ncl-cons-res" hidden aria-live="polite">
        <div class="ncl-cons__res-cab">
          <div>
            <small>Resultado de la búsqueda</small>
            <b id="ncl-cons-ref">—</b>
          </div>
          <span class="ncl-cons__estado">{r.estado}</span>
        </div>
        <dl class="ncl-cons__datos">
          <div><dt>Acto / Contrato</dt><dd>{r.contrato}</dd></div>
          <div><dt>Fecha de ingreso</dt><dd>{r.fecha}</dd></div>
          <div><dt>Notaría</dt><dd>tienda.com Notaría</dd></div>
        </dl>
        <ol class="ncl-cons__pasos">
          {r.pasos.map((p: string, i: number) => (
            <li class={i < r.actual ? 'is-hecho' : i === r.actual ? 'is-actual' : ''}>
              <span>{i < r.actual ? '✓' : i + 1}</span>{p}
            </li>
          ))}
        </ol>
        <p class="ncl-cons__nota">Consulta demostrativa: los datos mostrados son de ejemplo.</p>
      </div>
    </div>
  </div>
</section>

<script>
  const sec = document.getElementById('ncl-consulta');
  const form = document.getElementById('ncl-cons-form') as HTMLFormElement | null;
  const q = document.getElementById('ncl-cons-q') as HTMLInputElement | null;
  const label = document.getElementById('ncl-cons-label');
  const err = document.getElementById('ncl-cons-error');
  const res = document.getElementById('ncl-cons-res');
  const ref = document.getElementById('ncl-cons-ref');
  const catT = document.getElementById('ncl-cons-cat');
  let patron = /^[A-Za-z0-9-]{4,}$/;
  let tipoTxt = 'Kardex';

  sec?.querySelectorAll<HTMLButtonElement>('.ncl-cons__cat').forEach((b) => {
    b.addEventListener('click', () => {
      sec.querySelectorAll('.ncl-cons__cat').forEach((x) => {
        x.classList.toggle('is-on', x === b);
        x.setAttribute('aria-selected', String(x === b));
      });
      if (catT) catT.textContent = b.dataset.cat || '';
      if (res) res.hidden = true;
    });
  });

  sec?.querySelectorAll<HTMLButtonElement>('.ncl-cons__tab').forEach((b) => {
    b.addEventListener('click', () => {
      sec.querySelectorAll('.ncl-cons__tab').forEach((x) => {
        x.classList.toggle('is-on', x === b);
        x.setAttribute('aria-selected', String(x === b));
      });
      if (label) label.textContent = b.dataset.label || '';
      if (q) {
        q.placeholder = b.dataset.ph || '';
        q.value = '';
        q.focus();
      }
      patron = new RegExp(b.dataset.patron || '.+');
      tipoTxt = (b.textContent || '').replace('Por ', '');
      if (err) err.hidden = true;
      if (res) res.hidden = true;
    });
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const v = (q?.value || '').trim();
    if (!patron.test(v)) {
      if (err) err.hidden = false;
      q?.focus();
      return;
    }
    if (err) err.hidden = true;
    if (ref) ref.textContent = `${tipoTxt}: ${v.toUpperCase()}`;
    if (res) {
      res.hidden = false;
      res.classList.remove('is-flash');
      void res.offsetWidth;
      res.classList.add('is-flash');
    }
  });

  document.getElementById('ncl-cons-limpiar')?.addEventListener('click', () => {
    if (q) {
      q.value = '';
      q.focus();
    }
    if (err) err.hidden = true;
    if (res) res.hidden = true;
  });
</script>

<style>
  .ncl-cons {
    background: var(--ncl-papel);
    border-top: 1px solid var(--ncl-linea);
  }

  .ncl-cons__cab {
    text-align: center;
    display: grid;
    justify-items: center;
    margin-bottom: 2.4rem;
  }

  .ncl-cons__cab .ncl-lead {
    text-align: center;
    font-size: 0.9rem;
  }

  .ncl-cons__cats {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    max-width: 820px;
    margin: 0 auto 2rem;
  }

  .ncl-cons__cat {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ncl-acento);
    text-align: center;
  }

  .ncl-cons__cat-ico {
    display: grid;
    place-items: center;
    width: 64px;
    height: 58px;
    border: 2px solid currentColor;
    border-radius: 12px / 18px;
    background: #fff;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .ncl-cons__cat.is-on .ncl-cons__cat-ico,
  .ncl-cons__cat:hover .ncl-cons__cat-ico {
    background: var(--ncl-acento);
    color: #fff;
  }

  .ncl-cons__cat.is-on {
    color: var(--ncl-tinta);
  }

  .ncl-cons__caja {
    max-width: 820px;
    margin-inline: auto;
    background: #fff;
    border: 1px solid var(--ncl-linea);
    border-top: 3px solid var(--ncl-acento);
    border-radius: 3px;
    box-shadow: 0 10px 24px -18px rgba(0, 0, 0, 0.45);
    padding: clamp(1.4rem, 4vw, 2.2rem);
  }

  .ncl-cons__caja h3 {
    font-size: 1.35rem;
    margin-bottom: 1.1rem;
  }

  .ncl-cons__tabs {
    display: flex;
    border-bottom: 1px solid var(--ncl-linea);
    margin-bottom: 1.3rem;
  }

  .ncl-cons__tab {
    padding: 0.65rem 1.2rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--ncl-suave);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }

  .ncl-cons__tab.is-on {
    color: var(--ncl-acento);
    border-bottom-color: var(--ncl-acento);
  }

  .ncl-cons__form label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ncl-tinta);
    margin-bottom: 0.4rem;
  }

  .ncl-cons__fila {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    align-items: center;
  }

  .ncl-cons__fila input {
    flex: 1 1 240px;
    min-width: 0;
    height: 46px;
    padding: 0 0.9rem;
    border: 1px solid var(--ncl-linea);
    border-radius: var(--ncl-radio);
    background: var(--ncl-papel);
  }

  .ncl-cons__fila input:focus {
    outline: none;
    border-color: var(--ncl-acento);
    background: #fff;
  }

  .ncl-cons__fila .ncl-btn {
    height: 46px;
    padding-inline: 1.4rem;
  }

  .ncl-cons__limpiar {
    font-size: 0.8rem;
    color: var(--ncl-suave);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ncl-cons__error {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--ncl-acento);
  }

  .ncl-cons__res {
    margin-top: 1.6rem;
    border: 1px solid var(--ncl-linea);
    border-radius: 3px;
    padding: 1.2rem;
    background: var(--ncl-papel);
  }

  .ncl-cons__res.is-flash {
    animation: ncl-res 0.4s ease;
  }

  @keyframes ncl-res {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }

  .ncl-cons__res-cab {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .ncl-cons__res-cab small {
    display: block;
    font-size: 0.72rem;
    color: var(--ncl-suave);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .ncl-cons__res-cab b {
    font-family: var(--ncl-serif);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--ncl-tinta);
  }

  .ncl-cons__estado {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ncl-acento);
    border: 1px solid var(--ncl-acento);
    border-radius: 2px;
    padding: 0.3rem 0.6rem;
  }

  .ncl-cons__datos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8rem;
    margin-bottom: 1.2rem;
    font-size: 0.85rem;
  }

  .ncl-cons__datos dt {
    font-size: 0.72rem;
    color: var(--ncl-suave);
  }

  .ncl-cons__datos dd {
    color: var(--ncl-tinta);
    font-weight: 600;
  }

  .ncl-cons__pasos {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.5rem;
    counter-reset: none;
  }

  .ncl-cons__pasos li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    text-align: center;
    color: var(--ncl-suave);
    line-height: 1.3;
    position: relative;
  }

  .ncl-cons__pasos li::before {
    content: "";
    position: absolute;
    top: 13px;
    right: 50%;
    width: 100%;
    height: 2px;
    background: var(--ncl-linea);
    z-index: 0;
  }

  .ncl-cons__pasos li:first-child::before {
    display: none;
  }

  .ncl-cons__pasos li.is-hecho::before,
  .ncl-cons__pasos li.is-actual::before {
    background: var(--ncl-acento);
  }

  .ncl-cons__pasos span {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid var(--ncl-linea);
    background: #fff;
    font-weight: 700;
    font-size: 0.75rem;
  }

  .ncl-cons__pasos li.is-hecho span {
    background: var(--ncl-acento);
    border-color: var(--ncl-acento);
    color: #fff;
  }

  .ncl-cons__pasos li.is-actual {
    color: var(--ncl-tinta);
    font-weight: 700;
  }

  .ncl-cons__pasos li.is-actual span {
    border-color: var(--ncl-acento);
    color: var(--ncl-acento);
  }

  .ncl-cons__nota {
    margin-top: 1rem;
    font-size: 0.72rem;
    color: var(--ncl-suave);
  }

  @media (max-width: 700px) {
    .ncl-cons__cats {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 0.5rem;
      padding-bottom: 0.5rem;
      margin-inline: calc(-1 * clamp(1rem, 4vw, 1.5rem));
      padding-inline: clamp(1rem, 4vw, 1.5rem);
    }

    .ncl-cons__cats li {
      flex: 0 0 104px;
      scroll-snap-align: start;
    }

    .ncl-cons__datos {
      grid-template-columns: 1fr;
    }

    .ncl-cons__pasos {
      grid-template-columns: 1fr;
    }

    .ncl-cons__pasos li {
      flex-direction: row;
      text-align: left;
    }

    .ncl-cons__pasos li::before {
      display: none;
    }

    .ncl-cons__tab {
      padding-inline: 0.8rem;
    }
  }
</style>
