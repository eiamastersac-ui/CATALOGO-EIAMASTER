---
import Icono from '../componentes/Icono.astro';
import { nav, topIzq, topDer } from '../datos/notaria.js';

interface ItemNav { t: string; href: string; sub?: string[] }
interface Top { t: string; href: string; ico: string }
const items = nav as ItemNav[];
const izq = topIzq as Top[];
const der = topDer as Top[];
---

<header class="ncl-hdr" id="ncl-hdr">
  <div class="ncl-wrap ncl-hdr__top">
    <ul class="ncl-hdr__mini">
      {izq.map((l) => (
        <li><a href={l.href}><Icono n={l.ico} size={14} />{l.t}</a></li>
      ))}
    </ul>

    <a href="#ncl-inicio" class="ncl-logo" aria-label="tienda.com Notaría — inicio">
      <span class="ncl-logo__t" aria-hidden="true">T</span>
      <span class="ncl-logo__txt">
        <small>Notaría</small>
        <b>IENDA.COM</b>
      </span>
    </a>

    <ul class="ncl-hdr__mini ncl-hdr__mini--der">
      {der.map((l) => (
        <li><a href={l.href}>{l.t}<Icono n={l.ico} size={14} /></a></li>
      ))}
    </ul>

    <button type="button" class="ncl-hamb" id="ncl-hamb" aria-label="Abrir menú" aria-expanded="false" aria-controls="ncl-nav">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="ncl-nav" id="ncl-nav" aria-label="Navegación principal">
    <ul class="ncl-wrap ncl-nav__lista">
      {items.map((it) => (
        <li class={`ncl-nav__item${it.sub ? ' ncl-nav__item--sub' : ''}`}>
          {it.sub ? (
            <>
              <button type="button" class="ncl-nav__link ncl-nav__toggle" aria-expanded="false">
                {it.t}
                <svg class="ncl-nav__car" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 3.5 5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
              </button>
              <div class="ncl-nav__drop">
                <ul class={`ncl-nav__grid${it.sub.length > 6 ? ' ncl-nav__grid--4' : ''}`}>
                  {it.sub.map((s) => (
                    <li><a href={it.href}>{s}</a></li>
                  ))}
                </ul>
              </div>
            </>
          ) : (
            <a href={it.href} class="ncl-nav__link">{it.t}</a>
          )}
        </li>
      ))}
    </ul>
    <ul class="ncl-nav__extra">
      {[...izq, ...der].map((l) => (
        <li><a href={l.href}><Icono n={l.ico} size={15} />{l.t}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const hdr = document.getElementById('ncl-hdr');
  const hamb = document.getElementById('ncl-hamb');
  const navEl = document.getElementById('ncl-nav');

  function pintarScroll() {
    hdr?.classList.toggle('is-solid', window.scrollY > 60);
  }
  pintarScroll();
  window.addEventListener('scroll', pintarScroll, { passive: true });

  function cerrarDrops(excepto?: Element | null) {
    hdr?.querySelectorAll('.ncl-nav__item--sub.is-open').forEach((li) => {
      if (li !== excepto) {
        li.classList.remove('is-open');
        li.querySelector('.ncl-nav__toggle')?.setAttribute('aria-expanded', 'false');
      }
    });
  }

  hdr?.querySelectorAll<HTMLButtonElement>('.ncl-nav__toggle').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const li = btn.closest('.ncl-nav__item--sub');
      if (!li) return;
      const abierto = li.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(abierto));
      cerrarDrops(li);
    });
  });

  function abrirMenu(v: boolean) {
    navEl?.classList.toggle('is-open', v);
    hdr?.classList.toggle('is-menu', v);
    hamb?.setAttribute('aria-expanded', String(v));
    hamb?.setAttribute('aria-label', v ? 'Cerrar menú' : 'Abrir menú');
  }

  hamb?.addEventListener('click', () => abrirMenu(!navEl?.classList.contains('is-open')));

  navEl?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      abrirMenu(false);
      cerrarDrops();
    });
  });

  document.addEventListener('click', (e) => {
    if (hdr && !hdr.contains(e.target as Node)) {
      cerrarDrops();
      abrirMenu(false);
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      cerrarDrops();
      abrirMenu(false);
    }
  });
</script>

<style>
  .ncl-hdr {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 90;
    color: #fff;
    background: rgba(26, 23, 22, 0.55);
    transition: background 0.25s ease, box-shadow 0.25s ease;
  }

  .ncl-hdr.is-solid,
  .ncl-hdr.is-menu {
    background: var(--ncl-tinta-2);
    box-shadow: 0 8px 22px -14px rgba(0, 0, 0, 0.7);
  }

  .ncl-hdr__top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 64px;
    transition: height 0.25s ease;
  }

  .ncl-hdr.is-solid .ncl-hdr__top {
    height: 54px;
  }

  .ncl-hdr__mini {
    display: grid;
    gap: 0.15rem;
    font-size: 0.74rem;
    font-weight: 600;
  }

  .ncl-hdr__mini a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    opacity: 0.92;
  }

  .ncl-hdr__mini a:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ncl-hdr__mini--der {
    justify-items: end;
  }

  /* logo: bloque en acento con la inicial + wordmark serif (como el original) */
  .ncl-logo {
    display: flex;
    align-items: flex-end;
    gap: 0.1rem;
    line-height: 1;
  }

  .ncl-logo__t {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    background: var(--ncl-acento);
    color: #fff;
    font-family: var(--ncl-serif);
    font-size: 1.75rem;
    font-weight: 500;
    clip-path: polygon(0 6%, 100% 0, 100% 100%, 0 94%);
  }

  .ncl-logo__txt {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .ncl-logo__txt small {
    font-family: var(--ncl-serif);
    font-size: 0.52rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    margin-bottom: 0.15rem;
    padding-bottom: 0.15rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.6);
  }

  .ncl-logo__txt b {
    font-family: var(--ncl-serif);
    font-size: 1.62rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  /* ---- fila de navegacion en celdas con borde ---- */
  .ncl-nav {
    background: rgba(12, 10, 9, 0.55);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .ncl-hdr.is-solid .ncl-nav {
    background: #120f0e;
  }

  .ncl-nav__lista {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    position: relative;
  }

  .ncl-nav__item {
    border-left: 1px solid rgba(255, 255, 255, 0.16);
  }

  .ncl-nav__item:last-child {
    border-right: 1px solid rgba(255, 255, 255, 0.16);
  }

  .ncl-nav__link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    width: 100%;
    height: 40px;
    font-size: 0.79rem;
    font-weight: 600;
    color: #fff;
    transition: background 0.15s ease;
  }

  .ncl-nav__car {
    display: none;
  }

  .ncl-nav__item:hover > .ncl-nav__link,
  .ncl-nav__item.is-open > .ncl-nav__link {
    background: var(--ncl-acento);
  }

  .ncl-nav__drop {
    position: absolute;
    top: 100%;
    left: clamp(1rem, 4vw, 1.5rem);
    right: clamp(1rem, 4vw, 1.5rem);
    background: rgba(20, 17, 16, 0.96);
    border-top: 2px solid var(--ncl-acento);
    padding: 0.9rem 1.2rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
    box-shadow: 0 20px 30px -18px rgba(0, 0, 0, 0.7);
  }

  .ncl-nav__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.1rem 1.5rem;
  }

  .ncl-nav__grid--4 {
    grid-template-columns: repeat(4, 1fr);
  }

  .ncl-nav__grid a {
    display: block;
    padding: 0.55rem 0.4rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.88);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .ncl-nav__grid a:hover {
    color: #fff;
    padding-left: 0.7rem;
    border-bottom-color: var(--ncl-acento);
    transition: padding 0.15s ease;
  }

  .ncl-nav__item--sub:hover .ncl-nav__drop,
  .ncl-nav__item--sub.is-open .ncl-nav__drop {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .ncl-nav__extra {
    display: none;
  }

  .ncl-hamb {
    display: none;
    width: 42px;
    height: 42px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    color: #fff;
    justify-self: end;
  }

  .ncl-hamb span {
    width: 22px;
    height: 2px;
    background: currentColor;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .ncl-hdr.is-menu .ncl-hamb span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .ncl-hdr.is-menu .ncl-hamb span:nth-child(2) {
    opacity: 0;
  }

  .ncl-hdr.is-menu .ncl-hamb span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    .ncl-hdr__top,
    .ncl-hdr.is-solid .ncl-hdr__top {
      grid-template-columns: 1fr auto;
      height: 64px;
    }

    .ncl-hdr__mini {
      display: none;
    }

    .ncl-hamb {
      display: flex;
    }

    .ncl-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--ncl-tinta-2);
      max-height: calc(100svh - 64px);
      overflow-y: auto;
      padding-bottom: 1.2rem;
    }

    .ncl-hdr.is-solid .ncl-nav {
      background: var(--ncl-tinta-2);
    }

    .ncl-nav.is-open {
      display: block;
    }

    .ncl-nav__lista {
      grid-template-columns: 1fr;
    }

    .ncl-nav__item,
    .ncl-nav__item:last-child {
      border: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .ncl-nav__link {
      justify-content: space-between;
      height: auto;
      padding: 0.9rem 0;
      font-size: 0.92rem;
    }

    .ncl-nav__car {
      display: block;
      transition: transform 0.2s ease;
    }

    .ncl-nav__item:hover > .ncl-nav__link {
      background: none;
    }

    .ncl-nav__item.is-open > .ncl-nav__link {
      background: none;
      color: #fff;
    }

    .ncl-nav__item.is-open .ncl-nav__car {
      transform: rotate(180deg);
    }

    .ncl-nav__drop {
      position: static;
      display: none;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      background: none;
      border-top: 0;
      border-left: 2px solid var(--ncl-acento);
      padding: 0 0 0.8rem 0.9rem;
    }

    .ncl-nav__item--sub:hover .ncl-nav__drop {
      display: none;
    }

    .ncl-nav__item--sub.is-open .ncl-nav__drop {
      display: block;
    }

    .ncl-nav__grid,
    .ncl-nav__grid--4 {
      grid-template-columns: 1fr;
    }

    .ncl-nav__extra {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem 1rem;
      padding: 1rem clamp(1rem, 4vw, 1.5rem) 0;
      font-size: 0.8rem;
      color: rgba(255, 255, 255, 0.8);
    }

    .ncl-nav__extra a {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
    }
  }
</style>
