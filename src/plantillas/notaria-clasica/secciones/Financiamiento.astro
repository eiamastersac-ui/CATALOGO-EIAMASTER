---
import { financiamiento } from '../datos/notaria.js';
---

<section class="ncl-fin" id="ncl-financiamiento" aria-labelledby="ncl-fin-t">
  <div class="ncl-fin__txt">
    <div class="ncl-fin__in">
      <h2 id="ncl-fin-t">{financiamiento.titulo}</h2>
      <p>{financiamiento.texto}</p>
      <ul class="ncl-fin__ops">
        {financiamiento.opciones.map((o: string) => <li>{o}</li>)}
      </ul>
      <a href="#ncl-contacto" class="ncl-btn ncl-btn--blanco" data-asunto="Escrituras Públicas">Ver más</a>
    </div>
  </div>
  <div class="ncl-fin__foto">
    <img src={financiamiento.img} alt="Persona calculando cuotas de un préstamo hipotecario" loading="lazy" />
  </div>
</section>

<style>
  .ncl-fin {
    display: grid;
    grid-template-columns: 55% 45%;
    min-height: 460px;
    background: var(--ncl-acento);
  }

  .ncl-fin__txt {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    color: #fff;
    padding: clamp(3rem, 6vw, 4.5rem) clamp(1rem, 4vw, 3.5rem);
  }

  .ncl-fin__in {
    width: 100%;
    max-width: 450px;
  }

  .ncl-fin h2 {
    color: #fff;
    font-size: clamp(1.6rem, 2.8vw, 2.05rem);
    margin-bottom: 1.3rem;
  }

  .ncl-fin p {
    font-size: 0.86rem;
    line-height: 1.55;
    text-align: justify;
    margin-bottom: 1.3rem;
  }

  .ncl-fin__ops {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem 1.2rem;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 1.8rem;
  }

  .ncl-fin__ops li {
    padding-left: 0.9rem;
    border-left: 1px solid rgba(255, 255, 255, 0.55);
  }

  .ncl-fin__foto {
    position: relative;
    min-height: 280px;
  }

  .ncl-fin__foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 800px) {
    .ncl-fin {
      grid-template-columns: 1fr;
    }

    .ncl-fin__txt {
      justify-content: flex-start;
    }

    .ncl-fin__in {
      max-width: none;
    }
  }

  @media (max-width: 480px) {
    .ncl-fin__ops {
      grid-template-columns: 1fr;
    }
  }
</style>
