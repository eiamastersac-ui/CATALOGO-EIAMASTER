---
import { presenta } from '../datos/club.js';
---

<section class="cn-seccion">
  <div class="cn-wrap cn-presenta cn-reveal">
    <div class="cn-presenta__foto">
      <img src={presenta.img} alt={presenta.titulo} loading="lazy" />
    </div>
    <div class="cn-presenta__tx">
      <span class="cn-presenta__kicker">{presenta.kicker}</span>
      <h2>{presenta.titulo}</h2>
      <p>{presenta.texto}</p>
      <a href="#djs" class="cn-btn cn-btn--claro">{presenta.cta}</a>
    </div>
  </div>
</section>

<style>
  .cn-presenta {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .cn-presenta__foto {
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    overflow: hidden;
  }

  .cn-presenta__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cn-presenta__kicker {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--cn-texto-tenue);
    margin-bottom: 0.8rem;
  }

  .cn-presenta__tx h2 {
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    margin-bottom: 1rem;
  }

  .cn-presenta__tx p {
    color: var(--cn-texto);
    margin-bottom: 1.6rem;
    max-width: 48ch;
  }

  @media (max-width: 780px) {
    .cn-presenta {
      grid-template-columns: 1fr;
    }
  }
</style>
