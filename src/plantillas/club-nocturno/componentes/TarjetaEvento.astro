---
interface Evento {
  mes: string;
  dia: string;
  diaFin: string | null;
  titulo: string;
  lugar: string;
  desc: string;
  img: string;
}
const { evento } = Astro.props as { evento: Evento };
const { mes, dia, diaFin, titulo, lugar, desc, img } = evento;
---

<article class="cn-evento">
  <div class="cn-evento__foto">
    <img src={img} alt={titulo} loading="lazy" />
    <div class="cn-evento__fecha">
      <span>{mes}</span>
      <b>{dia}</b>
      {diaFin && (
        <>
          <span class="cn-evento__fecha-sep">{mes}</span>
          <b>{diaFin}</b>
        </>
      )}
    </div>
  </div>
  <div class="cn-evento__tx">
    <h3>{titulo}</h3>
    <span class="cn-evento__lugar">{lugar}</span>
    <p>{desc}</p>
    <a href="#eventos" class="cn-evento__cta">Entradas &amp; Info ›</a>
  </div>
</article>

<style>
  .cn-evento {
    background: var(--cn-panel);
    border: 1px solid var(--cn-linea);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, border-color 0.35s ease;
  }

  .cn-evento:hover {
    transform: translateY(-6px);
    border-color: rgba(245, 243, 240, 0.3);
    box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.6);
  }

  .cn-evento__foto img {
    transition: transform 0.5s ease;
  }

  .cn-evento:hover .cn-evento__foto img {
    transform: scale(1.05);
  }

  .cn-evento__foto {
    position: relative;
    aspect-ratio: 4 / 3;
  }

  .cn-evento__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cn-evento__fecha {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    background: rgba(11, 10, 16, 0.85);
    backdrop-filter: blur(4px);
    border-radius: 8px;
    padding: 0.4rem 0.6rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.1;
  }

  .cn-evento__fecha span {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--cn-texto-tenue);
  }

  .cn-evento__fecha b {
    font-family: var(--cn-font-titulo);
    font-size: 1.1rem;
    color: #fff;
  }

  .cn-evento__fecha-sep {
    margin-top: 0.3rem;
  }

  .cn-evento__tx {
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }

  .cn-evento__tx h3 {
    font-size: 1rem;
  }

  .cn-evento__lugar {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--cn-acento);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .cn-evento__tx p {
    font-size: 0.85rem;
    color: var(--cn-texto);
    flex: 1;
    margin-top: 0.2rem;
  }

  .cn-evento__cta {
    margin-top: 0.6rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
</style>
