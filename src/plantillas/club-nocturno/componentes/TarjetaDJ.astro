---
import Icono from './Icono.astro';

interface Props {
  nombre: string;
  show: string;
  duracion: string;
  img: string;
  live?: boolean;
}
const { nombre, show, duracion, img, live = false } = Astro.props as Props;
---

<article class="cn-dj">
  <div class="cn-dj__foto">
    <img src={img} alt={nombre} loading="lazy" />
    <span class="cn-dj__duracion">{live ? 'EN VIVO' : duracion}</span>
    <button type="button" class="cn-dj__play" aria-label={`Reproducir set de ${nombre}`}>
      <span class="cn-dj__play-ico">
        <Icono name="play" size={18} />
      </span>
    </button>
  </div>
  <div class="cn-dj__tx">
    <h3>{nombre}</h3>
    <span>{show}</span>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('.cn-dj__play').forEach((btn) => {
    if (btn.dataset.wired) return;
    btn.dataset.wired = '1';
    btn.addEventListener('click', () => {
      const ico = btn.querySelector('.cn-dj__play-ico');
      const activo = btn.classList.toggle('is-activo');
      if (ico) ico.innerHTML = activo
        ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 5h4v14H7z M13 5h4v14h-4z"/></svg>'
        : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 5v14l11-7Z"/></svg>';
    });
  });
</script>

<style>
  .cn-dj__foto {
    position: relative;
    aspect-ratio: 1;
    border-radius: 12px;
    overflow: hidden;
    transition: box-shadow 0.35s ease;
  }

  article:hover .cn-dj__foto {
    box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.6);
  }

  .cn-dj__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  article:hover .cn-dj__foto img {
    transform: scale(1.05);
  }

  .cn-dj__duracion {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    background: rgba(11, 10, 16, 0.85);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
  }

  .cn-dj__play {
    position: absolute;
    bottom: 0.8rem;
    right: 0.8rem;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--cn-acento);
    color: var(--cn-tinta);
    display: grid;
    place-items: center;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease, color 0.3s ease;
  }

  .cn-dj__play:hover {
    transform: scale(1.08);
  }

  .cn-dj__play.is-activo {
    background: var(--cn-tinta);
    color: var(--cn-blanco);
    box-shadow: inset 0 0 0 1.5px rgba(245, 243, 240, 0.5);
  }

  .cn-dj__tx {
    padding-top: 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .cn-dj__tx h3 {
    font-size: 0.95rem;
  }

  .cn-dj__tx span {
    font-size: 0.78rem;
    color: var(--cn-texto-tenue);
  }
</style>
