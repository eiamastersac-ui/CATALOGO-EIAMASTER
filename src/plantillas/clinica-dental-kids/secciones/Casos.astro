---
import { casos } from '../datos/clinica.js';
---

<section class="kd-seccion kd-wrap" id="casos">
  <div class="kd-cab kd-cab--centro kd-reveal">
    <span class="kd-kicker" style="justify-content:center">Antes y después</span>
    <h2 class="kd-titulo kd-titulo--centro">De nervioso a feliz en una sola cita</h2>
    <p class="kd-sub kd-sub--centro">Desliza para ver la transformación. Así se ve superar el miedo al dentista.</p>
  </div>

  <div class="kd-casos__grid">
    {casos.map((c: { t: string; d: string; antes: string; despues: string }, i: number) => (
      <article class={`kd-caso kd-reveal kd-reveal--${i + 1}`}>
        <div class="kd-caso__comparador" data-comparador>
          <img src={c.despues} alt={`${c.t} - despues`} class="kd-caso__despues" loading="lazy" />
          <div class="kd-caso__antes-wrap" data-antes-wrap>
            <img src={c.antes} alt={`${c.t} - antes`} class="kd-caso__antes" loading="lazy" />
            <span class="kd-caso__tag kd-caso__tag--antes">Nervioso</span>
          </div>
          <span class="kd-caso__tag kd-caso__tag--despues">Feliz</span>
          <span class="kd-caso__linea" data-linea aria-hidden="true"></span>
          <input type="range" min="0" max="100" value="50" class="kd-caso__slider" data-slider aria-label={`Comparar antes y despues: ${c.t}`} />
          <span class="kd-caso__handle" data-handle aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6-6 6 6 6M15 6l6 6-6 6"/></svg>
          </span>
        </div>
        <h3>{c.t}</h3>
        <p>{c.d}</p>
      </article>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-comparador]').forEach((comparador) => {
    const slider = comparador.querySelector<HTMLInputElement>('[data-slider]');
    const antesWrap = comparador.querySelector<HTMLElement>('[data-antes-wrap]');
    const handle = comparador.querySelector<HTMLElement>('[data-handle]');
    const linea = comparador.querySelector<HTMLElement>('[data-linea]');
    if (!slider || !antesWrap || !handle || !linea) return;

    function actualizar() {
      if (!slider || !antesWrap || !handle || !linea) return;
      const v = slider.value;
      antesWrap.style.clipPath = `inset(0 ${100 - Number(v)}% 0 0)`;
      handle.style.left = `${v}%`;
      linea.style.left = `${v}%`;
    }

    slider.addEventListener('input', actualizar);
    actualizar();
  });
</script>

<style>
  .kd-casos__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
    max-width: 44rem;
    margin-inline: auto;
  }

  .kd-caso h3 {
    font-size: 1rem;
    margin-top: 1rem;
    margin-bottom: 0.35rem;
  }

  .kd-caso p {
    font-size: 0.84rem;
    color: var(--kd-gris);
  }

  .kd-caso__comparador {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 22px;
    overflow: hidden;
    user-select: none;
    box-shadow: 0 20px 45px -28px rgba(43, 33, 64, 0.4);
  }

  .kd-caso__despues,
  .kd-caso__antes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kd-caso__antes-wrap {
    position: absolute;
    inset: 0;
    clip-path: inset(0 50% 0 0);
  }

  .kd-caso__tag {
    position: absolute;
    top: 0.75rem;
    z-index: 2;
    font-family: var(--kd-display);
    font-size: 0.68rem;
    font-weight: 700;
    color: #fff;
    background: rgba(43, 33, 64, 0.55);
    padding: 0.25rem 0.6rem;
    border-radius: var(--kd-pill);
  }

  .kd-caso__tag--antes {
    left: 0.75rem;
  }

  .kd-caso__tag--despues {
    right: 0.75rem;
    background: var(--kd-coral);
  }

  .kd-caso__linea {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 3px;
    background: #fff;
    transform: translateX(-50%);
    z-index: 2;
    pointer-events: none;
  }

  .kd-caso__slider {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    z-index: 3;
    -webkit-appearance: none;
    appearance: none;
    background: none;
  }

  .kd-caso__handle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 36px;
    height: 36px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #fff;
    display: grid;
    place-items: center;
    color: var(--kd-coral-osc);
    pointer-events: none;
    z-index: 2;
    box-shadow: 0 6px 16px -6px rgba(43, 33, 64, 0.5);
  }

  @media (max-width: 620px) {
    .kd-casos__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
