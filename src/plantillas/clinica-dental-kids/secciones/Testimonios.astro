---
import { testimonios } from '../datos/clinica.js';

interface Testimonio {
  texto: string;
  autor: string;
  hijo: string;
}
const lista = testimonios as Testimonio[];
---

<section class="kd-seccion kd-testi">
  <div class="kd-wrap">
    <div class="kd-cab kd-cab--centro kd-reveal">
      <span class="kd-kicker" style="justify-content:center">Opiniones de nuestros papitos</span>
      <h2 class="kd-titulo kd-titulo--centro">Lo que cuentan las familias</h2>
    </div>
  </div>

  <div class="kd-testi__fila kd-fila kd-reveal kd-reveal--2">
    {lista.map((t: Testimonio) => (
      <article class="kd-testi__card">
        <span class="kd-testi__comillas" aria-hidden="true">"</span>
        <p>{t.texto}</p>
        <div class="kd-testi__autor">
          <b>{t.autor}</b>
          <span>{t.hijo}</span>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .kd-testi {
    background: var(--kd-tinta);
  }

  .kd-testi .kd-kicker {
    color: var(--kd-sol);
  }

  .kd-testi .kd-kicker::before {
    background: var(--kd-sol);
    box-shadow: 0 0 0 3px rgba(255, 201, 60, 0.25);
  }

  .kd-testi .kd-titulo {
    color: #fff;
  }

  .kd-testi__fila {
    padding-inline: max(1.25rem, calc((100vw - var(--kd-maxw)) / 2));
  }

  .kd-testi__card {
    flex: 0 0 min(320px, 82vw);
    scroll-snap-align: start;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 22px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .kd-testi__comillas {
    font-family: var(--kd-display);
    font-size: 2.5rem;
    line-height: 1;
    color: var(--kd-coral);
  }

  .kd-testi__card p {
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.92rem;
    flex: 1;
  }

  .kd-testi__autor {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .kd-testi__autor b {
    font-family: var(--kd-display);
    color: #fff;
    font-size: 0.9rem;
  }

  .kd-testi__autor span {
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.6);
  }
</style>
