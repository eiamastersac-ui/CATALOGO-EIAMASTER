---
import { hero } from '../datos/clinica.js';

interface Slide {
  kicker: string;
  titulo: string;
  sub: string;
  img: string;
}
const slides = hero.slides as Slide[];
---

<section class="kd-hero" id="hero" aria-roledescription="carrusel">
  <div class="kd-hero__track" id="kd-hero-track">
    {slides.map((s: Slide, i: number) => (
      <article class="kd-hero__slide">
        <img src={s.img} alt={s.titulo} loading={i === 0 ? 'eager' : 'lazy'} />
        <span class="kd-hero__scrim" aria-hidden="true"></span>
        <div class="kd-hero__body kd-wrap">
          <div class="kd-hero__spacer"></div>
          <div class="kd-hero__texto">
            <span class="kd-kicker kd-kicker--claro">{s.kicker}</span>
            <h1>{s.titulo}</h1>
            <p class="kd-hero__sub">{s.sub}</p>
            <div class="kd-hero__acciones">
              <a href="#preguntas" class="kd-btn kd-btn--sobre-foto">Agenda su primera cita</a>
              <div class="kd-hero__tags">
                {hero.tags.map((t: string) => <a href="#especialidades" class="kd-hero__tag">{t}</a>)}
              </div>
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="kd-hero__card kd-reveal">
    <img src={hero.insignia.img} alt={hero.insignia.nombre} loading="lazy" />
    <div>
      <b>{hero.insignia.frase}</b>
      <span>{hero.insignia.nombre}</span>
    </div>
  </div>

  <div class="kd-hero__nav">
    <span class="kd-hero__contador"><b id="kd-hero-actual">1</b>/{slides.length}</span>
    <button type="button" class="kd-flecha" id="kd-hero-prev" aria-label="Anterior">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 6-6 6 6 6"/></svg>
    </button>
    <button type="button" class="kd-flecha" id="kd-hero-next" aria-label="Siguiente">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6"/></svg>
    </button>
  </div>

  <a href="#especialidades" class="kd-hero__scroll" aria-label="Bajar a especialidades">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
  </a>
</section>

<script>
  const track = document.getElementById('kd-hero-track');
  const actualEl = document.getElementById('kd-hero-actual');
  const total = track ? track.children.length : 0;
  let idx = 0;

  function ir(n: number) {
    if (!track) return;
    idx = (n + total) % total;
    track.style.transform = `translateX(-${idx * 100}%)`;
    if (actualEl) actualEl.textContent = String(idx + 1);
  }

  document.getElementById('kd-hero-prev')?.addEventListener('click', () => ir(idx - 1));
  document.getElementById('kd-hero-next')?.addEventListener('click', () => ir(idx + 1));

  let timer = window.setInterval(() => ir(idx + 1), 6000);
  const box = document.getElementById('hero');
  box?.addEventListener('mouseenter', () => window.clearInterval(timer));
  box?.addEventListener('mouseleave', () => (timer = window.setInterval(() => ir(idx + 1), 6000)));
</script>

<style>
  .kd-hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: var(--kd-tinta);
  }

  .kd-hero__track {
    display: flex;
    height: 100%;
    transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .kd-hero__slide {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
  }

  .kd-hero__slide img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kd-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(43, 33, 64, 0.55) 0%, rgba(43, 33, 64, 0.08) 28%, rgba(43, 33, 64, 0.12) 55%, rgba(43, 33, 64, 0.75) 100%);
  }

  .kd-hero__body {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding-top: var(--kd-hdr-h);
    padding-bottom: clamp(2.5rem, 7vw, 4.5rem);
  }

  .kd-hero__spacer {
    flex: 1;
  }

  .kd-hero__texto {
    max-width: 42rem;
    color: #fff;
  }

  .kd-hero__texto h1 {
    color: #fff;
    font-weight: 800;
    font-size: clamp(2.1rem, 5.2vw, 3.6rem);
    margin-bottom: 0.9rem;
  }

  .kd-hero__sub {
    font-size: clamp(0.92rem, 1.6vw, 1.05rem);
    color: rgba(255, 255, 255, 0.9);
    max-width: 40ch;
    margin-bottom: 1.6rem;
  }

  .kd-kicker--claro {
    color: #fff;
  }

  .kd-kicker--claro::before {
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.3);
  }

  .kd-hero__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .kd-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .kd-hero__tag {
    font-family: var(--kd-display);
    font-size: 0.76rem;
    font-weight: 700;
    color: #fff;
    padding: 0.5rem 0.9rem;
    border-radius: var(--kd-pill);
    border: 2px solid rgba(255, 255, 255, 0.4);
  }

  .kd-hero__tag:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .kd-hero__card {
    position: absolute;
    right: clamp(1.1rem, 4vw, 2rem);
    bottom: clamp(5.5rem, 11vw, 7.5rem);
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(10px);
    border-radius: 18px;
    padding: 0.75rem 1.1rem 0.75rem 0.75rem;
    box-shadow: 0 20px 45px -20px rgba(0, 0, 0, 0.45);
  }

  .kd-hero__card img {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid var(--kd-sol);
  }

  .kd-hero__card div {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .kd-hero__card b {
    font-family: var(--kd-display);
    font-size: 0.85rem;
    color: var(--kd-coral-osc);
  }

  .kd-hero__card span {
    font-size: 0.7rem;
    color: var(--kd-gris);
  }

  .kd-hero__nav {
    position: absolute;
    right: clamp(1.1rem, 4vw, 2rem);
    bottom: clamp(1.5rem, 4vw, 2.25rem);
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .kd-hero__contador {
    color: #fff;
    font-family: var(--kd-display);
    font-size: 0.85rem;
    font-weight: 700;
    margin-right: 0.4rem;
  }

  .kd-hero__nav .kd-flecha {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.4);
    color: #fff;
    width: 38px;
    height: 38px;
  }

  .kd-hero__nav .kd-flecha:hover {
    background: #fff;
    color: var(--kd-tinta);
  }

  .kd-hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    z-index: 5;
    color: rgba(255, 255, 255, 0.8);
    animation: kd-rebote 2.2s ease-in-out infinite;
  }

  @keyframes kd-rebote {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 6px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .kd-hero__scroll {
      animation: none;
    }
  }

  @media (max-width: 760px) {
    .kd-hero__card {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .kd-hero__scroll {
      display: none;
    }
  }
</style>
