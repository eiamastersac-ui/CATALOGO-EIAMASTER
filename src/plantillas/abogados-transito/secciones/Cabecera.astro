---
import { marca, navPrincipal } from '../datos/contenido.js';
---

<header class="at-hdr" id="top">
  <div class="at-wrap at-hdr__row">
    <a href="#top" class="at-logo" aria-label={`${marca.nombre} ${marca.sub}`}>
      <span class="at-logo__ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M4 17l1.6-6.4A2 2 0 0 1 7.5 9h9a2 2 0 0 1 1.9 1.6L20 17" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M3 17h18v2a1 1 0 0 1-1 1h-1.5a1 1 0 0 1-1-1v-1h-11v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-2Z"></path>
          <circle cx="7.5" cy="17.5" r="1.4"></circle>
          <circle cx="16.5" cy="17.5" r="1.4"></circle>
          <path d="M7 13h10" stroke-linecap="round"></path>
        </svg>
      </span>
      <span class="at-logo__tx">
        {marca.nombre}<b>{marca.sub}</b>
      </span>
    </a>

    <nav class="at-nav" aria-label="Navegación principal">
      <ul class="at-nav__links">
        {navPrincipal.map((n) => (
          <li><a href={n.href}>{n.t}</a></li>
        ))}
      </ul>
    </nav>

    <div class="at-hdr__acc">
      <a class="at-hdr__tel" href={`tel:${marca.telHref}`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.45 2.11L8 9.9a16 16 0 0 0 6 6l1.4-1.15a2 2 0 0 1 2.11-.45c.87.3 1.78.5 2.7.6A2 2 0 0 1 22 16.9Z"></path></svg>
        {marca.telTexto}
      </a>
      <a href="#banner-urgente" class="at-btn at-btn--amarillo at-hdr__cta">Cotización Gratis</a>
      <button type="button" class="at-hdr__burger" id="at-menu-btn" aria-expanded="false" aria-controls="at-menu-movil" aria-label="Abrir menú">
        <i></i><i></i><i></i>
      </button>
    </div>
  </div>

  <div class="at-menu-movil" id="at-menu-movil" hidden>
    <ul>
      {navPrincipal.map((n) => (
        <li><a href={n.href}>{n.t}</a></li>
      ))}
    </ul>
    <a href="#banner-urgente" class="at-btn at-btn--amarillo at-btn--bloque">Cotización Gratis</a>
  </div>
</header>

<script>
  const btn = document.getElementById('at-menu-btn');
  const menu = document.getElementById('at-menu-movil');

  btn?.addEventListener('click', () => {
    if (!menu) return;
    const abierto = menu.hidden;
    menu.hidden = !abierto;
    btn.classList.toggle('is-active', abierto);
    btn.setAttribute('aria-expanded', String(abierto));
  });

  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      if (!menu || !btn) return;
      menu.hidden = true;
      btn.classList.remove('is-active');
      btn.setAttribute('aria-expanded', 'false');
    })
  );
</script>

<style>
  /* Cabecera solida, sticky. Sin overflow-x:hidden en la raiz del tpl para
     que este sticky funcione siempre (ver trampa de header en el playbook). */
  .at-hdr {
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--at-linea);
  }

  .at-hdr__row {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: 0.85rem;
  }

  .at-logo {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
  }

  .at-logo__ico {
    width: 2.3rem;
    height: 2.3rem;
    display: grid;
    place-items: center;
    color: var(--at-tinta);
    background: var(--at-amarillo);
    border-radius: 8px;
    flex-shrink: 0;
  }

  .at-logo__ico svg {
    width: 62%;
    height: 62%;
  }

  .at-logo__tx {
    font-family: var(--at-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: 0.01em;
    line-height: 1;
    color: var(--at-tinta);
    text-transform: uppercase;
  }

  .at-logo__tx b {
    display: block;
    font-family: var(--at-font);
    font-weight: 700;
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    color: var(--at-amarillo-osc);
    margin-top: 0.2rem;
  }

  .at-nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .at-nav__links {
    display: flex;
    gap: 1.9rem;
    list-style: none;
    font-size: 0.83rem;
    font-weight: 600;
    color: var(--at-tinta);
  }

  .at-nav__links a:hover {
    color: var(--at-amarillo-osc);
  }

  .at-hdr__acc {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    flex-shrink: 0;
  }

  .at-hdr__tel {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--at-tinta);
  }

  .at-hdr__tel:hover {
    color: var(--at-amarillo-osc);
  }

  .at-hdr__burger {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 0.4rem;
  }

  .at-hdr__burger i {
    width: 20px;
    height: 2px;
    background: var(--at-tinta);
    border-radius: 2px;
  }

  .at-menu-movil {
    display: none;
  }

  @media (max-width: 980px) {
    .at-nav,
    .at-hdr__tel {
      display: none;
    }
    .at-hdr__burger {
      display: flex;
    }
    .at-menu-movil:not([hidden]) {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 1rem clamp(1rem, 4vw, 2rem) 1.4rem;
      border-top: 1px solid var(--at-linea);
    }
    .at-menu-movil ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      font-weight: 600;
    }
  }
</style>
