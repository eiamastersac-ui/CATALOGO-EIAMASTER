---
import { IMG, faq } from '../datos/contenido.js';
---

<section class="at-faq" id="faq" aria-label="Preguntas frecuentes">
  <div class="at-faq__banner">
    <img src={IMG.corteVacia} alt="Sala de audiencias vacía" loading="lazy" />
    <div class="at-faq__scrim" aria-hidden="true"></div>
    <div class="at-wrap at-faq__banner-txt">
      <h2 class="at-titulo">Preguntas más frecuentes</h2>
      <p>
        Las preguntas más frecuentes sobre multas de tránsito se basan en las consultas que
        recibimos a diario. Si no encuentras la tuya, escríbenos o llama al {' '}
        <a href="tel:+17025550120">(702) 555-0120</a>.
      </p>
    </div>
  </div>

  <div class="at-wrap at-faq__lista">
    {faq.map((f, i) => (
      <div class="at-faq__item">
        <button type="button" class="at-faq__pregunta" aria-expanded={i === 0 ? 'true' : 'false'}>
          <span>{f.p}</span>
          <span class="at-faq__mas" aria-hidden="true">+</span>
        </button>
        <div class="at-faq__respuesta" hidden={i !== 0}>
          <p>{f.r}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>('.at-faq__item'));

  items.forEach((item) => {
    const btn = item.querySelector<HTMLButtonElement>('.at-faq__pregunta');
    const panel = item.querySelector<HTMLElement>('.at-faq__respuesta');

    btn?.addEventListener('click', () => {
      if (!panel) return;
      const abierto = btn.getAttribute('aria-expanded') === 'true';
      items.forEach((otro) => {
        const otroBtn = otro.querySelector<HTMLButtonElement>('.at-faq__pregunta');
        const otroPanel = otro.querySelector<HTMLElement>('.at-faq__respuesta');
        otroBtn?.setAttribute('aria-expanded', 'false');
        otroBtn?.classList.remove('is-on');
        if (otroPanel) otroPanel.hidden = true;
      });
      if (!abierto) {
        btn.setAttribute('aria-expanded', 'true');
        btn.classList.add('is-on');
        panel.hidden = false;
      }
    });
  });
</script>

<style>
  .at-faq__banner {
    position: relative;
    color: #fff;
    overflow: hidden;
  }

  .at-faq__banner img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .at-faq__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, rgba(10, 12, 18, 0.92) 0%, rgba(10, 12, 18, 0.55) 65%);
  }

  .at-faq__banner-txt {
    position: relative;
    z-index: 1;
    padding-block: clamp(3rem, 7vw, 4.5rem);
    max-width: 640px;
  }

  .at-faq__banner-txt .at-titulo {
    color: #fff;
  }

  .at-faq__banner-txt p {
    color: #dcdfe8;
    font-size: 0.95rem;
  }

  .at-faq__banner-txt a {
    color: var(--at-amarillo);
    font-weight: 700;
  }

  .at-faq__lista {
    padding-block: clamp(2.5rem, 6vw, 3.75rem);
    max-width: 820px;
  }

  .at-faq__item {
    border-bottom: 1px solid var(--at-linea);
  }

  .at-faq__pregunta {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 0;
    text-align: left;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .at-faq__pregunta:hover {
    color: var(--at-amarillo-osc);
  }

  .at-faq__mas {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--at-crema);
    display: grid;
    place-items: center;
    font-size: 1.1rem;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .at-faq__pregunta[aria-expanded="true"] .at-faq__mas {
    transform: rotate(45deg);
    background: var(--at-amarillo);
  }

  .at-faq__respuesta[hidden] {
    display: none;
  }

  .at-faq__respuesta p {
    padding-bottom: 1.25rem;
    color: var(--at-gris);
    font-size: 0.88rem;
    max-width: 62ch;
  }
</style>
