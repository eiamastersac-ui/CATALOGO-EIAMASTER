---
import { IMG, beneficios } from '../datos/contenido.js';
---

<section class="at-seccion at-porque" id="por-que-elegirnos">
  <div class="at-wrap at-porque__layout">
    <div class="at-porque__foto">
      <img src={IMG.librosLey} alt="Libros de leyes y notas sobre un escritorio" loading="lazy" />
    </div>

    <div class="at-porque__texto">
      <p class="at-kicker">Sobre el equipo</p>
      <h2 class="at-titulo">¿Por qué contratar a tienda.com Tránsito?</h2>
      <p class="at-sub" style="margin-bottom:2rem;">
        Cuando contratas a tienda.com Tránsito, puedes estar tranquilo sabiendo que la mayoría de
        nuestros casos se resuelven sin escuela de tráfico, sin puntos en tu registro y sin subir tu
        prima de seguro.
      </p>

      <div class="at-porque__lista">
        {beneficios.map((b) => (
          <article class="at-porque__item">
            <h3>{b.titulo}</h3>
            <p>{b.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .at-porque__layout {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  .at-porque__foto img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 14px;
  }

  .at-porque__lista {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .at-porque__item {
    padding-top: 1.4rem;
    border-top: 1px solid var(--at-linea);
  }

  .at-porque__item:first-child {
    border-top: none;
    padding-top: 0;
  }

  .at-porque__item h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .at-porque__item p {
    font-size: 0.87rem;
    color: var(--at-gris);
  }

  @media (max-width: 900px) {
    .at-porque__layout {
      grid-template-columns: 1fr;
    }
    .at-porque__foto img {
      aspect-ratio: 16 / 9;
    }
  }
</style>
