---
import { marca } from '../datos/contenido.js';
---

<div class="at-topbar">
  <div class="at-wrap at-topbar__row">
    <div class="at-topbar__redes" aria-label="Redes sociales">
      <a href="#" aria-label="Facebook">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 22v-8.5H16l.5-3.5h-3V7.8c0-1 .3-1.7 1.7-1.7H16.6V3.1C16.3 3 15.3 3 14.2 3c-2.3 0-3.9 1.4-3.9 4v2h-2.6v3.5h2.6V22h3.2Z"/></svg>
      </a>
      <a href="#" aria-label="X / Twitter">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M3 3l7.6 9.4L3.2 21H6l5.4-6.1L15.8 21H21l-8-9.9L20.4 3H17.6l-5 5.6L8.2 3H3Z"/></svg>
      </a>
      <a href="#" aria-label="YouTube">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M21.6 7.2s-.2-1.5-.8-2.1c-.8-.8-1.7-.8-2.1-.9C15.9 4 12 4 12 4s-3.9 0-6.7.2c-.4 0-1.3.1-2.1.9-.6.6-.8 2.1-.8 2.1S2.2 9 2.2 10.7v1.5C2.2 14 2.4 15.7 2.4 15.7s.2 1.5.8 2.1c.8.8 1.8.8 2.3.9 1.7.1 6.5.2 6.5.2s3.9 0 6.7-.3c.4 0 1.3-.1 2.1-.9.6-.6.8-2.1.8-2.1s.2-1.7.2-3.5v-1.5c0-1.7-.2-3.4-.2-3.4ZM9.9 14.6V8.9l5.4 2.9-5.4 2.8Z"/></svg>
      </a>
      <a href="#" aria-label="Instagram">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.2c2.7 0 3 0 4.1.06 1.1.05 1.8.22 2.4.46.6.24 1.1.56 1.6 1.05.5.5.8 1 1.05 1.6.24.6.4 1.3.46 2.4.06 1.1.06 1.4.06 4.1s0 3-.06 4.1c-.05 1.1-.22 1.8-.46 2.4a4.3 4.3 0 0 1-1.05 1.6c-.5.5-1 .8-1.6 1.05-.6.24-1.3.4-2.4.46-1.1.06-1.4.06-4.1.06s-3 0-4.1-.06c-1.1-.05-1.8-.22-2.4-.46a4.3 4.3 0 0 1-1.6-1.05 4.3 4.3 0 0 1-1.05-1.6c-.24-.6-.4-1.3-.46-2.4C2.2 15 2.2 14.7 2.2 12s0-3 .06-4.1c.05-1.1.22-1.8.46-2.4.24-.6.56-1.1 1.05-1.6.5-.5 1-.8 1.6-1.05.6-.24 1.3-.4 2.4-.46C9 2.2 9.3 2.2 12 2.2Zm0 1.8c-2.65 0-2.96 0-4 .06-.9.04-1.4.19-1.73.32-.43.17-.75.37-1.08.7-.33.33-.53.65-.7 1.08-.13.33-.28.83-.32 1.73-.06 1.04-.06 1.35-.06 4s0 2.96.06 4c.04.9.19 1.4.32 1.73.17.43.37.75.7 1.08.33.33.65.53 1.08.7.33.13.83.28 1.73.32 1.04.06 1.35.06 4 .06s2.96 0 4-.06c.9-.04 1.4-.19 1.73-.32.43-.17.75-.37 1.08-.7.33-.33.53-.65.7-1.08.13-.33.28-.83.32-1.73.06-1.04.06-1.35.06-4s0-2.96-.06-4c-.04-.9-.19-1.4-.32-1.73a2.9 2.9 0 0 0-.7-1.08 2.9 2.9 0 0 0-1.08-.7c-.33-.13-.83-.28-1.73-.32-1.04-.06-1.35-.06-4-.06Zm0 3.5a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9Zm0 1.8a2.7 2.7 0 1 0 0 5.4 2.7 2.7 0 0 0 0-5.4Zm4.7-2a1.05 1.05 0 1 1 0 2.1 1.05 1.05 0 0 1 0-2.1Z"/></svg>
      </a>
    </div>

    <div class="at-topbar__acc">
      <a class="at-topbar__tel" href={`tel:${marca.telHref}`}>{marca.telOficina}</a>
      <div class="at-topbar__idioma">
        <button type="button" class="is-on">Español</button>
        <span aria-hidden="true">|</span>
        <button type="button">English</button>
      </div>
    </div>
  </div>
</div>

<style>
  .at-topbar {
    background: var(--at-tinta);
    color: #cfd2db;
  }

  .at-topbar__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.5rem;
    font-size: 0.75rem;
  }

  .at-topbar__redes {
    display: flex;
    gap: 0.85rem;
  }

  .at-topbar__redes a {
    display: grid;
    place-items: center;
    color: #9aa0b0;
  }

  .at-topbar__redes a:hover {
    color: var(--at-amarillo);
  }

  .at-topbar__acc {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .at-topbar__tel {
    font-weight: 600;
    color: #fff;
    letter-spacing: 0.02em;
  }

  .at-topbar__tel:hover {
    color: var(--at-amarillo);
  }

  .at-topbar__idioma {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #7d8294;
  }

  .at-topbar__idioma button.is-on {
    color: #fff;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .at-topbar__redes {
      display: none;
    }
    .at-topbar__row {
      justify-content: center;
    }
  }
</style>
