---
import { IMG, cobertura } from '../datos/contenido.js';
---

<section class="at-cobertura" id="cobertura" aria-label="Cobertura por cortes y ciudades">
  <div class="at-wrap at-cobertura__layout">
    <div class="at-cobertura__texto">
      <p class="at-kicker">Cobertura</p>
      <h2 class="at-titulo">Atendemos casos en cortes de todo Nevada.</h2>
      <p class="at-sub">
        No importa en qué corte te citaron: coordinamos tu caso desde cualquier parte del estado,
        con actualizaciones puntuales por correo y mensaje de texto.
      </p>
    </div>

    <ul class="at-cobertura__lista">
      {cobertura.map((c) => (
        <li>
          <span class="at-cobertura__ciudad">{c.ciudad}</span>
          <span class="at-cobertura__corte">{c.corte}</span>
        </li>
      ))}
    </ul>
  </div>

  <img class="at-cobertura__foto" src={IMG.torresOficina} alt="Torres de oficinas vistas desde abajo" loading="lazy" />
</section>

<style>
  .at-cobertura {
    background: var(--at-tinta);
    color: #fff;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: stretch;
  }

  .at-cobertura__layout {
    padding-block: clamp(2.75rem, 6vw, 4.5rem);
    max-width: none;
  }

  .at-cobertura__texto {
    max-width: 420px;
    margin-bottom: 2rem;
  }

  .at-cobertura__texto .at-titulo {
    color: #fff;
  }

  .at-cobertura__texto .at-sub {
    color: #b8bccb;
  }

  .at-cobertura__lista {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    max-width: 560px;
  }

  .at-cobertura__lista li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.8rem 1rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
  }

  .at-cobertura__ciudad {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--at-amarillo);
  }

  .at-cobertura__corte {
    font-size: 0.75rem;
    color: #c7cad6;
  }

  .at-cobertura__foto {
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .at-cobertura {
      grid-template-columns: 1fr;
    }
    .at-cobertura__foto {
      min-height: 220px;
      order: -1;
    }
    .at-cobertura__lista {
      grid-template-columns: 1fr;
    }
  }
</style>
