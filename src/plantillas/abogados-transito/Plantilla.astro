---
import './estilos.css';

import BarraSuperior from './secciones/BarraSuperior.astro';
import Cabecera from './secciones/Cabecera.astro';
import Hero from './secciones/Hero.astro';
import BannerUrgente from './secciones/BannerUrgente.astro';
import ComoFunciona from './secciones/ComoFunciona.astro';
import Estadisticas from './secciones/Estadisticas.astro';
import TiposCasos from './secciones/TiposCasos.astro';
import PorQueElegirnos from './secciones/PorQueElegirnos.astro';
import Cobertura from './secciones/Cobertura.astro';
import Testimonios from './secciones/Testimonios.astro';
import Recursos from './secciones/Recursos.astro';
import Faq from './secciones/Faq.astro';
import PiePagina from './secciones/PiePagina.astro';
import ChatBot from './secciones/ChatBot.astro';
---

<div class="tpl-abogados-transito">
  <BarraSuperior />
  <Cabecera />
  <main>
    <Hero />
    <BannerUrgente />
    <ComoFunciona />
    <Estadisticas />
    <TiposCasos />
    <PorQueElegirnos />
    <Cobertura />
    <Testimonios />
    <Recursos />
    <Faq />
  </main>
  <PiePagina />
  <ChatBot />
</div>
