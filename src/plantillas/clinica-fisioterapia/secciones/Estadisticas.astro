---
import { estadisticas } from '../datos/fisioterapia.js';
---

<section class="ft-wrap ft-stats">
  {estadisticas.map((e: { n: number; sufijo: string; t: string }, i: number) => (
    <div class={`ft-stats__item ft-reveal ft-reveal--${i + 1}`}>
      <span class="ft-stats__n" data-num={e.n}>0{e.sufijo}</span>
      <p>{e.t}</p>
    </div>
  ))}
</section>

<script>
  const nodos = document.querySelectorAll<HTMLElement>('.ft-stats__n');

  const animar = (el: HTMLElement) => {
    const meta = Number(el.dataset.num ?? '0');
    const sufijo = el.textContent?.replace(/^\d+/, '') ?? '';
    const duracion = 1200;
    const inicio = performance.now();

    const paso = (ahora: number) => {
      const progreso = Math.min((ahora - inicio) / duracion, 1);
      const valor = Math.round(meta * progreso);
      el.textContent = `${valor}${sufijo}`;
      if (progreso < 1) requestAnimationFrame(paso);
    };
    requestAnimationFrame(paso);
  };

  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          if (entrada.isIntersecting) {
            animar(entrada.target as HTMLElement);
            observer.unobserve(entrada.target);
          }
        }
      },
      { threshold: 0.4 },
    );
    nodos.forEach((n) => observer.observe(n));
  } else {
    nodos.forEach((n) => {
      const meta = Number(n.dataset.num ?? '0');
      const sufijo = n.textContent?.replace(/^\d+/, '') ?? '';
      n.textContent = `${meta}${sufijo}`;
    });
  }
</script>

<style>
  .ft-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .ft-stats__item {
    background: var(--ft-menta);
    border-radius: 20px;
    padding: 1.75rem 1rem;
    text-align: center;
  }

  .ft-stats__n {
    display: block;
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 900;
    color: var(--ft-marino);
  }

  .ft-stats__item p {
    color: var(--ft-gris);
    font-size: 0.85rem;
    font-weight: 700;
    margin-top: 0.3rem;
  }

  @media (max-width: 640px) {
    .ft-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
