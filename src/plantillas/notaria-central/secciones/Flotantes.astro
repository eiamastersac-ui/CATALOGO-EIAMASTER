---
import { marca, citas } from '../datos/notaria.js';
---

<a class="nc-wa" href={`https://wa.me/${marca.whatsapp}`} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 0 0 1.8-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z" /></svg>
</a>

<div class="nc-citas" id="nc-citas">
  <div class="nc-citas__panel" id="nc-citas-panel" role="dialog" aria-label="Citas online" hidden>
    <div class="nc-citas__cab">
      <div>
        <b>Citas Online</b>
        <span><i aria-hidden="true"></i> En línea · respuesta en horario de atención</span>
      </div>
      <button type="button" class="nc-citas__x" id="nc-citas-x" aria-label="Cerrar citas">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>

    <form class="nc-citas__form" id="nc-citas-form" novalidate>
      <label>
        <span>Trámite</span>
        <select class="nc-campo" name="tramite">
          {citas.tramites.map((t: string) => <option>{t}</option>)}
        </select>
      </label>
      <label>
        <span>Fecha</span>
        <input class="nc-campo" type="date" name="fecha" id="nc-citas-fecha" required />
      </label>
      <fieldset>
        <legend>Hora</legend>
        <div class="nc-citas__horas">
          {citas.horas.map((h: string, i: number) => (
            <label class="nc-citas__hora">
              <input type="radio" name="hora" value={h} checked={i === 0} />
              <span>{h}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <label>
        <span>Nombre</span>
        <input class="nc-campo" name="nombre" placeholder="Tu nombre" required />
      </label>
      <p class="nc-citas__err" id="nc-citas-err" hidden>Elige una fecha y escribe tu nombre.</p>
      <button type="submit" class="nc-btn nc-btn--lleno">Reservar cita</button>
    </form>

    <div class="nc-citas__ok" id="nc-citas-ok" hidden>
      <span class="nc-citas__check" aria-hidden="true">✓</span>
      <p><b>¡Cita reservada!</b></p>
      <p id="nc-citas-resumen"></p>
      <p class="nc-citas__nota">Demo: no se registra ninguna cita real.</p>
      <button type="button" class="nc-btn nc-btn--vino" id="nc-citas-otra">Nueva cita</button>
    </div>
  </div>

  <span class="nc-citas__burbuja" aria-hidden="true">Citas<br />Online</span>
  <button type="button" class="nc-citas__btn" id="nc-citas-btn" aria-expanded="false" aria-controls="nc-citas-panel" aria-label="Abrir citas online">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4M8 14h3M8 17h6" /></svg>
  </button>
</div>

<script>
  const wrap = document.getElementById('nc-citas');
  const panel = document.getElementById('nc-citas-panel');
  const btn = document.getElementById('nc-citas-btn');
  const form = document.getElementById('nc-citas-form') as HTMLFormElement | null;
  const ok = document.getElementById('nc-citas-ok');
  const err = document.getElementById('nc-citas-err');
  const fecha = document.getElementById('nc-citas-fecha') as HTMLInputElement | null;

  if (fecha) {
    const hoy = new Date();
    hoy.setDate(hoy.getDate() + 1);
    fecha.min = hoy.toISOString().slice(0, 10);
  }

  function abrir(v: boolean) {
    if (!panel) return;
    panel.hidden = !v;
    wrap?.classList.toggle('is-open', v);
    btn?.setAttribute('aria-expanded', String(v));
    if (v) panel.querySelector<HTMLElement>('select, input')?.focus();
  }

  btn?.addEventListener('click', () => abrir(!!panel?.hidden));
  document.getElementById('nc-citas-x')?.addEventListener('click', () => abrir(false));
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-abrir-citas]')) {
      e.preventDefault();
      abrir(true);
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') abrir(false);
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const valido = form.checkValidity();
    if (err) err.hidden = valido;
    if (!valido) return;
    const d = new FormData(form);
    const f = String(d.get('fecha') || '');
    const [a, m, dia] = f.split('-');
    const res = document.getElementById('nc-citas-resumen');
    if (res) res.textContent = `${d.get('nombre')}, te esperamos el ${dia}/${m}/${a} a las ${d.get('hora')} para: ${d.get('tramite')}.`;
    form.hidden = true;
    if (ok) ok.hidden = false;
  });

  document.getElementById('nc-citas-otra')?.addEventListener('click', () => {
    form?.reset();
    if (form) form.hidden = false;
    if (ok) ok.hidden = true;
  });
</script>

<style>
  .nc-wa {
    position: fixed;
    left: 1.2rem;
    bottom: 1.2rem;
    z-index: 80;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.5);
    transition: transform 0.2s ease;
  }

  .nc-wa:hover {
    transform: scale(1.06);
  }

  .nc-citas {
    position: fixed;
    right: 1.2rem;
    bottom: 1.2rem;
    z-index: 85;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .nc-citas__burbuja {
    background: #fff;
    color: var(--nc-tinta);
    font-family: var(--nc-f-titulo);
    font-size: 0.85rem;
    line-height: 1.05;
    text-align: center;
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    box-shadow: 0 8px 20px -10px rgba(0, 0, 0, 0.45);
  }

  .nc-citas.is-open .nc-citas__burbuja {
    display: none;
  }

  .nc-citas__btn {
    width: 58px;
    height: 58px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--nc-vino);
    color: #fff;
    box-shadow: 0 12px 26px -10px rgba(0, 0, 0, 0.55);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .nc-citas__btn:hover {
    transform: scale(1.05);
    background: var(--nc-vino-osc);
  }

  .nc-citas__panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.8rem);
    width: min(340px, calc(100vw - 2.4rem));
    max-height: calc(100svh - 140px);
    overflow-y: auto;
    background: #fff;
    box-shadow: 0 24px 50px -20px rgba(0, 0, 0, 0.55);
    border-radius: 6px;
    animation: nc-cit-in 0.22s ease both;
  }

  .nc-citas__panel[hidden] {
    display: none;
  }

  @keyframes nc-cit-in {
    from { opacity: 0; transform: translateY(10px); }
  }

  .nc-citas__cab {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding: 0.95rem 1.1rem;
    background: var(--nc-vino);
    color: #fff;
    border-radius: 6px 6px 0 0;
  }

  .nc-citas__cab b {
    display: block;
    font-family: var(--nc-f-titulo);
    font-weight: 500;
    font-size: 1.15rem;
  }

  .nc-citas__cab span {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    opacity: 0.9;
  }

  .nc-citas__cab i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #7ddc8f;
  }

  .nc-citas__x {
    color: #fff;
    padding: 0.2rem;
  }

  .nc-citas__form,
  .nc-citas__ok {
    padding: 1rem 1.1rem 1.2rem;
    display: grid;
    gap: 0.75rem;
  }

  .nc-citas__form[hidden],
  .nc-citas__ok[hidden] {
    display: none;
  }

  .nc-citas__form label > span,
  .nc-citas__form legend {
    display: block;
    font-family: var(--nc-f-sub);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--nc-tinta);
    margin-bottom: 0.25rem;
  }

  .nc-citas__form fieldset {
    border: 0;
  }

  .nc-citas__horas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .nc-citas__hora input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .nc-citas__hora span {
    display: inline-block;
    padding: 0.3rem 0.6rem;
    border: 1px solid #cfc8c4;
    border-radius: 3px;
    font-size: 0.82rem;
    cursor: pointer;
  }

  .nc-citas__hora input:checked + span {
    background: var(--nc-tinta);
    border-color: var(--nc-tinta);
    color: #fff;
  }

  .nc-citas__hora input:focus-visible + span {
    outline: 2px solid var(--nc-vino);
    outline-offset: 1px;
  }

  .nc-citas__err {
    font-size: 0.82rem;
    color: var(--nc-vino);
  }

  .nc-citas__ok {
    text-align: center;
    justify-items: center;
    font-size: 0.9rem;
  }

  .nc-citas__check {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 2px solid var(--nc-vino);
    color: var(--nc-vino);
    font-size: 1.3rem;
  }

  .nc-citas__nota {
    font-size: 0.78rem;
    color: var(--nc-gris);
  }

  @media (max-width: 480px) {
    .nc-citas__burbuja {
      display: none;
    }
  }
</style>
