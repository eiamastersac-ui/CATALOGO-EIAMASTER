---
import { heroSlides } from '../datos/notaria.js';

interface Slide { kicker: string; titulo: string; texto: string; cta: string; href: string; img: string; alt: string }
const slides = heroSlides as Slide[];
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="nc-hero" id="nc-inicio" aria-roledescription="carrusel" aria-label="Destacados de la notaría">
  <div class="nc-hero__slides">
    {slides.map((s, i) => (
      <div class={`nc-hero__slide${i === 0 ? ' is-on' : ''}`} data-slide={i} aria-hidden={i === 0 ? 'false' : 'true'}>
        <img src={s.img} alt={s.alt} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
      </div>
    ))}
  </div>
  <div class="nc-hero__scrim" aria-hidden="true"></div>

  <div class="nc-wrap nc-hero__cont">
    {slides.map((s, i) => (
      <div class={`nc-hero__txt${i === 0 ? ' is-on' : ''}`} data-txt={i} hidden={i !== 0}>
        <span class="nc-hero__kicker">{s.kicker}</span>
        {i === 0 ? <h1>{s.titulo}</h1> : <p class="nc-hero__h">{s.titulo}</p>}
        <p class="nc-hero__p">{s.texto}</p>
        <a href={s.href} class="nc-btn nc-btn--claro">{s.cta}</a>
      </div>
    ))}
  </div>

  <div class="nc-hero__ctrl">
    <span class="nc-hero__num"><b id="nc-hero-n">01</b> / {pad(slides.length)}</span>
    <button type="button" class="nc-hero__flecha" id="nc-hero-prev" aria-label="Anterior">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6" /></svg>
    </button>
    <div class="nc-hero__dots" role="tablist" aria-label="Elegir diapositiva">
      {slides.map((_, i) => (
        <button type="button" class={`nc-hero__dot${i === 0 ? ' is-on' : ''}`} data-dot={i} aria-label={`Diapositiva ${i + 1}`}></button>
      ))}
    </div>
    <button type="button" class="nc-hero__flecha" id="nc-hero-next" aria-label="Siguiente">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6" /></svg>
    </button>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('.nc-hero');
  const slidesEl = Array.from(document.querySelectorAll<HTMLElement>('.nc-hero__slide'));
  const txts = Array.from(document.querySelectorAll<HTMLElement>('.nc-hero__txt'));
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.nc-hero__dot'));
  const num = document.getElementById('nc-hero-n');
  let idx = 0;
  let timer: number | undefined;

  function ir(n: number) {
    const total = slidesEl.length;
    idx = (n + total) % total;
    slidesEl.forEach((s, i) => {
      s.classList.toggle('is-on', i === idx);
      s.setAttribute('aria-hidden', String(i !== idx));
    });
    txts.forEach((t, i) => {
      const on = i === idx;
      t.hidden = !on;
      t.classList.remove('is-on');
      if (on) {
        void t.offsetWidth;
        t.classList.add('is-on');
      }
    });
    dots.forEach((d, i) => d.classList.toggle('is-on', i === idx));
    if (num) num.textContent = String(idx + 1).padStart(2, '0');
  }

  function play() {
    stop();
    timer = window.setInterval(() => ir(idx + 1), 6000);
  }
  function stop() {
    if (timer) window.clearInterval(timer);
  }

  document.getElementById('nc-hero-prev')?.addEventListener('click', () => { ir(idx - 1); play(); });
  document.getElementById('nc-hero-next')?.addEventListener('click', () => { ir(idx + 1); play(); });
  dots.forEach((d) => d.addEventListener('click', () => { ir(Number(d.dataset.dot)); play(); }));
  hero?.addEventListener('mouseenter', stop);
  hero?.addEventListener('mouseleave', play);
  play();
</script>

<style>
  .nc-hero {
    position: relative;
    height: 100svh;
    min-height: 600px;
    display: flex;
    align-items: center;
    color: #fff;
    overflow: hidden;
    background: var(--nc-carbon);
  }

  .nc-hero__slides,
  .nc-hero__slide {
    position: absolute;
    inset: 0;
  }

  .nc-hero__slide {
    opacity: 0;
    transition: opacity 0.9s ease;
  }

  .nc-hero__slide.is-on {
    opacity: 1;
  }

  .nc-hero__slide img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    transition: transform 7s ease-out;
  }

  .nc-hero__slide.is-on img {
    transform: scale(1);
  }

  /* scrim de legibilidad (no decorativo) */
  .nc-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.3) 35%, rgba(0, 0, 0, 0.35) 65%, rgba(0, 0, 0, 0.72) 100%);
  }

  .nc-hero__cont {
    position: relative;
    text-align: center;
    padding-top: calc(var(--nc-hdr) + var(--nc-top));
  }

  .nc-hero__txt {
    max-width: 820px;
    margin: 0 auto;
  }

  .nc-hero__txt.is-on > * {
    animation: nc-sube 0.7s ease both;
  }

  .nc-hero__txt.is-on > *:nth-child(2) { animation-delay: 0.08s; }
  .nc-hero__txt.is-on > *:nth-child(3) { animation-delay: 0.16s; }
  .nc-hero__txt.is-on > *:nth-child(4) { animation-delay: 0.24s; }

  @keyframes nc-sube {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }

  .nc-hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--nc-f-titulo);
    font-weight: 300;
    font-size: 0.95rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: 1.1rem;
  }

  .nc-hero__kicker::before,
  .nc-hero__kicker::after {
    content: "";
    width: 28px;
    height: 1px;
    background: rgba(255, 255, 255, 0.7);
  }

  .nc-hero h1,
  .nc-hero__h {
    font-family: var(--nc-f-sub);
    font-weight: 700;
    font-size: clamp(2.3rem, 7vw, 4.6rem);
    line-height: 1.05;
    text-transform: uppercase;
    color: #fff;
    letter-spacing: 0.01em;
  }

  .nc-hero__p {
    font-size: clamp(1rem, 2vw, 1.15rem);
    max-width: 560px;
    margin: 1rem auto 2rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .nc-hero__ctrl {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--nc-f-titulo);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .nc-hero__num {
    margin-right: 0.3rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .nc-hero__num b {
    color: #fff;
    font-weight: 500;
  }

  .nc-hero__flecha {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 50%;
    color: #fff;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .nc-hero__flecha:hover {
    background: #fff;
    color: var(--nc-tinta);
  }

  .nc-hero__dots {
    display: flex;
    gap: 0.55rem;
  }

  .nc-hero__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.45);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .nc-hero__dot.is-on {
    background: #fff;
    transform: scale(1.25);
  }

  @media (max-width: 640px) {
    .nc-hero {
      min-height: 560px;
    }

    .nc-hero__num {
      display: none;
    }
  }
</style>
