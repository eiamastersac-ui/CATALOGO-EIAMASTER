---
import { trabaja, marca } from '../datos/notaria.js';
---

<section class="nc-trab" id="trabaja">
  <figure class="nc-trab__foto">
    <img src={trabaja.img} alt="Equipo de trabajo reunido revisando documentos" loading="lazy" />
  </figure>

  <div class="nc-trab__txt">
    <h2 class="nc-titulo-xl">{trabaja.titulo}</h2>
    <p class="nc-sub">{trabaja.texto}</p>
    <span class="nc-raya" aria-hidden="true"></span>
    <p class="nc-trab__mail">
      Envíanos tu CV a: <a href={`mailto:${marca.correoCv}`}>{marca.correoCv}</a>
    </p>

    <form class="nc-trab__form" id="nc-trab-form">
      <input class="nc-campo" name="nombre" placeholder="Nombre completo" required />
      <input class="nc-campo" name="correo" type="email" placeholder="Correo electrónico" required />
      <select class="nc-campo" name="area" aria-label="Área de interés">
        <option>Área legal / abogados</option>
        <option>Atención al cliente</option>
        <option>Archivo y kardex</option>
        <option>Prácticas pre profesionales</option>
      </select>
      <button type="submit" class="nc-btn nc-btn--vino">Postular</button>
    </form>
  </div>
</section>

<script>
  import { toast } from '../componentes/toast';
  const f = document.getElementById('nc-trab-form') as HTMLFormElement | null;
  f?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!f.checkValidity()) {
      f.reportValidity();
      return;
    }
    const nombre = (f.elements.namedItem('nombre') as HTMLInputElement | null)?.value.split(' ')[0] || '';
    f.reset();
    toast(`Gracias ${nombre}, recibimos tu postulación (demo).`);
  });
</script>

<style>
  .nc-trab {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 460px;
    scroll-margin-top: calc(var(--nc-hdr) + var(--nc-top) - 1px);
  }

  .nc-trab__foto {
    position: relative;
    min-height: 300px;
  }

  .nc-trab__foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nc-trab__txt {
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1rem, 5vw, 4rem);
    max-width: 620px;
  }

  .nc-trab__txt .nc-titulo-xl {
    font-size: clamp(2rem, 4.5vw, 2.8rem);
  }

  .nc-trab__mail a {
    color: var(--nc-vino);
    font-weight: 600;
    border-bottom: 1px solid currentColor;
  }

  .nc-trab__form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }

  .nc-trab__form .nc-btn {
    justify-self: start;
  }

  @media (max-width: 820px) {
    .nc-trab {
      grid-template-columns: 1fr;
    }

    .nc-trab__foto {
      min-height: 240px;
    }
  }

  @media (max-width: 480px) {
    .nc-trab__form {
      grid-template-columns: 1fr;
    }
  }
</style>
