---
import { servicios } from '../datos/notaria.js';

interface Grupo { t: string; l: string[] }
interface Servicio { id: string; titulo: string; img: string; requisitos: Grupo[] }
const lista = servicios as Servicio[];
---

<div class="nc-modal" id="nc-req" hidden>
  <div class="nc-modal__velo" data-cerrar></div>
  <div class="nc-modal__caja" role="dialog" aria-modal="true" aria-labelledby="nc-req-titulo">
    <button type="button" class="nc-modal__x" data-cerrar aria-label="Cerrar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>

    {lista.map((s) => (
      <div class="nc-modal__panel" data-panel={s.id} hidden>
        <div class="nc-modal__foto">
          <img src={s.img} alt="" loading="lazy" />
          <div>
            <span class="nc-modal__kicker">Requisitos</span>
            <p class="nc-modal__h" data-titulo>{s.titulo}</p>
          </div>
        </div>
        <div class="nc-modal__cuerpo">
          {s.requisitos.map((g, i) => (
            <details class="nc-req__grupo" open={i === 0}>
              <summary>{g.t}</summary>
              <ul>
                {g.l.map((x) => <li>{x}</li>)}
              </ul>
            </details>
          ))}
          <p class="nc-modal__nota">
            Los requisitos son referenciales. Un especialista validará tu documentación antes de la firma.
          </p>
          <div class="nc-modal__acc">
            <button type="button" class="nc-btn nc-btn--lleno" data-abrir-citas>Reservar cita</button>
            <a href="#contacto" class="nc-btn nc-btn--vino" data-cerrar>Hacer una consulta</a>
          </div>
        </div>
      </div>
    ))}
    <span id="nc-req-titulo" class="nc-modal__sr"></span>
  </div>
</div>

<script>
  const modal = document.getElementById('nc-req');
  const titulo = document.getElementById('nc-req-titulo');
  let ultimoFoco: HTMLElement | null = null;

  function abrir(id: string) {
    if (!modal) return;
    let visible: HTMLElement | null = null;
    modal.querySelectorAll<HTMLElement>('.nc-modal__panel').forEach((p) => {
      const on = p.dataset.panel === id;
      p.hidden = !on;
      if (on) visible = p;
    });
    const t = (visible as HTMLElement | null)?.querySelector('[data-titulo]')?.textContent || '';
    if (titulo) titulo.textContent = 'Requisitos: ' + t;
    ultimoFoco = document.activeElement as HTMLElement | null;
    modal.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    modal.querySelector<HTMLButtonElement>('.nc-modal__x')?.focus();
  }

  function cerrar() {
    if (!modal || modal.hidden) return;
    modal.hidden = true;
    document.documentElement.style.overflow = '';
    ultimoFoco?.focus();
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const btn = t.closest<HTMLElement>('[data-requisitos]');
    if (btn) {
      abrir(btn.dataset.requisitos || '');
      return;
    }
    if (modal && !modal.hidden && t.closest('[data-cerrar], [data-abrir-citas]') && modal.contains(t)) cerrar();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') cerrar();
  });
</script>

<style>
  .nc-modal {
    position: fixed;
    inset: 0;
    z-index: 150;
    display: grid;
    place-items: center;
    padding: 1rem;
  }

  .nc-modal[hidden] {
    display: none;
  }

  .nc-modal__velo {
    position: absolute;
    inset: 0;
    background: rgba(20, 16, 16, 0.62);
    animation: nc-fade 0.2s ease both;
  }

  .nc-modal__caja {
    position: relative;
    width: min(680px, 100%);
    max-height: calc(100svh - 2rem);
    overflow-y: auto;
    background: #fff;
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.7);
    animation: nc-pop 0.25s ease both;
  }

  @keyframes nc-fade {
    from { opacity: 0; }
  }

  @keyframes nc-pop {
    from { opacity: 0; transform: translateY(14px); }
  }

  .nc-modal__x {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    z-index: 2;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: var(--nc-tinta);
  }

  .nc-modal__panel[hidden] {
    display: none;
  }

  .nc-modal__foto {
    position: relative;
    height: 190px;
    display: flex;
    align-items: flex-end;
    color: #fff;
    background: var(--nc-carbon);
  }

  .nc-modal__foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nc-modal__foto::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 30%, rgba(0, 0, 0, 0.75) 100%);
  }

  .nc-modal__foto > div {
    position: relative;
    z-index: 1;
    padding: 1.2rem 1.6rem;
  }

  .nc-modal__kicker {
    font-family: var(--nc-f-titulo);
    font-weight: 300;
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .nc-modal__h {
    font-family: var(--nc-f-titulo);
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 500;
    text-transform: uppercase;
    line-height: 1.1;
  }

  .nc-modal__cuerpo {
    padding: 0.6rem 1.6rem 1.6rem;
  }

  .nc-modal__nota {
    font-size: 0.82rem;
    color: var(--nc-gris);
    margin-top: 1rem;
  }

  .nc-modal__acc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.2rem;
  }

  .nc-modal__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>
