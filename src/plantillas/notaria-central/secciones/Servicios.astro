---
import { servicios, img } from '../datos/notaria.js';

interface Servicio { id: string; titulo: string; img: string; items: string[] }
const lista = servicios as Servicio[];
const fondo = img('biblioteca', 2000);
---

<section class="nc-serv" id="servicios">
  <div class="nc-wrap nc-serv__cab">
    <h2 class="nc-titulo-xl">Servicios</h2>
    <p class="nc-sub">Cuéntanos qué tipo de trámite deseas realizar</p>
  </div>

  <div class="nc-serv__banda">
    <img class="nc-serv__fondo" src={fondo} alt="" loading="lazy" aria-hidden="true" />
    <div class="nc-serv__tinte" aria-hidden="true"></div>

    <div class="nc-wrap">
      <ul class="nc-serv__grid">
        {lista.map((s) => (
          <li class="nc-serv__card">
            <h3>{s.titulo}</h3>
            <span class="nc-serv__raya" aria-hidden="true"></span>
            <ul class="nc-serv__lista">
              {s.items.map((it) => <li>{it}</li>)}
            </ul>
            <button type="button" class="nc-btn nc-btn--claro nc-serv__btn" data-requisitos={s.id}>
              Ver requisitos
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .nc-serv {
    padding-top: clamp(3rem, 7vw, 4.5rem);
    scroll-margin-top: calc(var(--nc-hdr) + var(--nc-top) - 1px);
  }

  .nc-serv__cab {
    padding-bottom: clamp(2.5rem, 6vw, 4.2rem);
  }

  .nc-serv__banda {
    position: relative;
    padding: clamp(3rem, 7vw, 4.5rem) 0;
    overflow: hidden;
    background: var(--nc-vino-osc);
  }

  .nc-serv__fondo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
  }

  /* la foto se tine con el vino de la marca, igual que el original */
  .nc-serv__tinte {
    position: absolute;
    inset: 0;
    background: rgba(110, 42, 48, 0.86);
  }

  .nc-serv__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.8rem;
  }

  .nc-serv__card {
    display: flex;
    flex-direction: column;
    background: rgba(28, 12, 14, 0.78);
    border-radius: 4px;
    padding: 1.7rem 1.1rem 1.4rem;
    color: #fff;
    transition: transform 0.25s ease, background 0.25s ease;
  }

  .nc-serv__card:hover {
    transform: translateY(-4px);
    background: rgba(28, 12, 14, 0.9);
  }

  .nc-serv__card h3 {
    font-family: var(--nc-f-sub);
    font-weight: 700;
    font-size: 1.08rem;
    text-transform: uppercase;
    text-align: center;
    color: #fff;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }

  .nc-serv__raya {
    display: block;
    width: 84px;
    height: 2px;
    background: #fff;
    margin: 0.9rem auto 1.4rem;
  }

  .nc-serv__lista {
    flex: 1;
    display: grid;
    align-content: start;
    gap: 0.2rem;
    font-family: var(--nc-f-sub);
    font-size: 0.95rem;
    line-height: 1.45;
    padding-left: 0.4rem;
  }

  .nc-serv__lista li {
    position: relative;
    padding-left: 1.05rem;
  }

  .nc-serv__lista li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #fff;
  }

  .nc-serv__btn {
    align-self: flex-start;
    margin-top: 1.6rem;
    font-size: 0.85rem;
    border-width: 1px;
  }

  @media (max-width: 960px) {
    .nc-serv__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .nc-serv__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
