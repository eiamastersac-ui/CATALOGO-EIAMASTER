---
import { temporada } from '../datos/patitas.js';
---

<section class="pt-temp">
  <img src={temporada.img} alt={temporada.titulo} loading="lazy" />
  <span class="pt-temp__scrim" aria-hidden="true"></span>
  <div class="pt-wrap pt-temp__body">
    <span class="pt-temp__badge">{temporada.kicker}</span>
    <h2>{temporada.titulo}</h2>
    <p>{temporada.sub}</p>
    <a href="#ofertas" class="pt-btn pt-btn--negro">Comprar aquí</a>
  </div>
</section>

<style>
  .pt-temp {
    position: relative;
    height: clamp(220px, 32vw, 320px);
    margin-inline: clamp(1rem, 3vw, 2rem);
    margin-block: 1.5rem;
    border-radius: 16px;
    overflow: hidden;
  }

  .pt-temp img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pt-temp__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(20, 14, 10, 0.72) 0%, rgba(20, 14, 10, 0.15) 65%);
  }

  .pt-temp__body {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.7rem;
    max-width: 30ch;
    color: #fff;
  }

  .pt-temp__badge {
    display: inline-block;
    background: var(--pt-naranja);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    width: fit-content;
  }

  .pt-temp__body h2 {
    font-size: clamp(1.5rem, 3.4vw, 2.2rem);
    color: #fff;
  }

  .pt-temp__body p {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .pt-temp__body .pt-btn {
    width: fit-content;
    margin-top: 0.4rem;
  }
</style>
