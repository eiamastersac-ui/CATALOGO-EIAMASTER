---
import { marca, ticker, categoriasMenu, navLinks, base } from '../datos/patitas.js';
import Icono from '../componentes/Icono.astro';

interface Grupo { titulo: string; items: string[] }
interface Banner { titulo: string; tag: string; img: string }
interface Categoria { cat: string; ico: string; grupos: Grupo[]; banners: Banner[] }
interface NavLink { t: string; href: string; destacado?: boolean }

const cats = categoriasMenu as Categoria[];
const links = navLinks as NavLink[];
---

<div class="pt-ticker" aria-hidden="true">
  <div class="pt-ticker__track">
    {Array.from({ length: 6 }).map(() => <span>{ticker}</span>)}
  </div>
</div>

<header class="pt-hdr" id="top">
  <div class="pt-wrap pt-hdr__row">
    <a href={`${base}/`} class="pt-logo" aria-label={marca.nombre}>
      <span class="pt-logo__ico" aria-hidden="true"><Icono name="pelota" size={24} /></span>
      <span class="pt-logo__tx">{marca.nombre}<b>{marca.sub}</b></span>
    </a>

    <form class="pt-buscar" id="pt-buscar-form" role="search">
      <input type="search" id="pt-buscar-input" placeholder="Buscar productos..." aria-label="Buscar productos" />
      <button type="submit" aria-label="Buscar"><Icono name="busqueda" size={18} /></button>
    </form>

    <div class="pt-hdr__acc">
      <a href={marca.whatsappHref} target="_blank" rel="noopener" class="pt-hdr__ico" aria-label="Escríbenos por WhatsApp">
        <Icono name="whatsapp" size={20} />
      </a>
      <button type="button" class="pt-hdr__ico" id="pt-cart-toggle" aria-label="Ver carrito">
        <Icono name="carrito" size={21} />
        <span class="pt-hdr__badge" id="pt-cart-count" hidden>0</span>
      </button>
    </div>
  </div>

  <nav class="pt-nav" aria-label="Categorías">
    <div class="pt-wrap pt-nav__row">
      {cats.map((c: Categoria, i: number) => (
        <button type="button" class="pt-nav__item" data-mega={`cat-${i}`}>
          {c.cat} <Icono name="chevron" size={12} />
        </button>
      ))}
      {links.map((l: NavLink) => (
        <a href={l.href} class:list={['pt-nav__link', { 'pt-nav__link--dest': l.destacado }]}>{l.t}</a>
      ))}
    </div>

    <div class="pt-mega" id="pt-mega" hidden>
      {cats.map((c: Categoria, i: number) => (
        <div class="pt-mega__panel" data-panel={`cat-${i}`} hidden>
          <div class="pt-wrap pt-mega__grid">
            <div class="pt-mega__cols">
              {c.grupos.map((g: Grupo) => (
                <div class="pt-mega__col">
                  <h3>{g.titulo}</h3>
                  <ul>
                    {g.items.map((it: string) => <li><a href="#recomendados">{it}</a></li>)}
                  </ul>
                </div>
              ))}
            </div>
            <div class="pt-mega__banners">
              {c.banners.map((b: Banner) => (
                <a href="#ofertas" class="pt-mega__banner">
                  <img src={b.img} alt={b.titulo} loading="lazy" />
                  <span class="pt-mega__banner-tag">{b.tag}</span>
                  <span class="pt-mega__banner-t">{b.titulo}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </nav>
</header>

<div class="pt-mega-overlay" id="pt-mega-overlay" hidden></div>

<!-- Drawer de carrito -->
<div class="pt-cart-overlay" id="pt-cart-overlay" hidden></div>
<aside class="pt-cart" id="pt-cart" hidden aria-label="Carrito de compras">
  <header class="pt-cart__head">
    <h2>Mi carrito <small id="pt-cart-n">(0)</small></h2>
    <button type="button" id="pt-cart-cerrar" aria-label="Cerrar carrito"><Icono name="cerrar" size={20} /></button>
  </header>
  <div class="pt-cart__body" id="pt-cart-body">
    <p class="pt-cart__vacio" id="pt-cart-vacio">Tu carrito está vacío.</p>
  </div>
  <footer class="pt-cart__foot">
    <div class="pt-cart__total">
      <span>Subtotal</span>
      <b id="pt-cart-total">S/ 0.00</b>
    </div>
    <button type="button" class="pt-btn pt-btn--naranja pt-cart__pagar">Ir a pagar</button>
  </footer>
</aside>

<script>
  const megaBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.pt-nav__item'));
  const mega = document.getElementById('pt-mega');
  const megaOverlay = document.getElementById('pt-mega-overlay');
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.pt-mega__panel'));

  function cerrarMega() {
    if (mega) mega.hidden = true;
    if (megaOverlay) megaOverlay.hidden = true;
    megaBtns.forEach((b) => b.classList.remove('is-on'));
  }

  megaBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.mega;
      const yaAbierto = btn.classList.contains('is-on');
      megaBtns.forEach((b) => b.classList.remove('is-on'));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
      if (yaAbierto) {
        cerrarMega();
      } else {
        btn.classList.add('is-on');
        if (mega) mega.hidden = false;
        if (megaOverlay) megaOverlay.hidden = false;
      }
    });
  });

  megaOverlay?.addEventListener('click', cerrarMega);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      cerrarMega();
      abrirCarrito(false);
    }
  });

  const buscarForm = document.getElementById('pt-buscar-form');
  const buscarInput = document.getElementById('pt-buscar-input') as HTMLInputElement | null;
  buscarForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = (buscarInput?.value || '').trim().toLowerCase();
    document.querySelectorAll<HTMLElement>('.pt-prod').forEach((card) => {
      const hit = !q || (card.dataset.nombre || '').includes(q);
      card.hidden = !hit;
    });
    document.getElementById('recomendados')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  interface ItemCarrito { nombre: string; precio: number; img: string; cantidad: number }
  const carrito: ItemCarrito[] = [];

  const cartToggle = document.getElementById('pt-cart-toggle');
  const cartPanelEl = document.getElementById('pt-cart');
  const cartOverlay = document.getElementById('pt-cart-overlay');
  const cartCerrar = document.getElementById('pt-cart-cerrar');
  const cartBody = document.getElementById('pt-cart-body');
  const cartVacio = document.getElementById('pt-cart-vacio');
  const cartN = document.getElementById('pt-cart-n');
  const cartTotalEl = document.getElementById('pt-cart-total');
  const badge = document.getElementById('pt-cart-count');

  function soles(n: number): string {
    return 'S/ ' + n.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function pintarCarrito() {
    if (!cartBody || !cartN || !cartTotalEl || !badge) return;
    const totalItems = carrito.reduce((a, i) => a + i.cantidad, 0);
    const totalSoles = carrito.reduce((a, i) => a + i.cantidad * i.precio, 0);
    cartN.textContent = `(${totalItems})`;
    cartTotalEl.textContent = soles(totalSoles);
    badge.textContent = String(totalItems);
    badge.hidden = totalItems === 0;

    cartBody.querySelectorAll('.pt-cart__item').forEach((el) => el.remove());
    if (cartVacio) cartVacio.hidden = carrito.length > 0;

    carrito.forEach((item) => {
      const row = document.createElement('div');
      row.className = 'pt-cart__item';
      row.innerHTML = `
        <img src="${item.img}" alt="" />
        <div class="pt-cart__item-tx">
          <b>${item.nombre}</b>
          <span>${item.cantidad} x ${soles(item.precio)}</span>
        </div>
      `;
      cartBody.appendChild(row);
    });
  }

  function abrirCarrito(v: boolean) {
    if (!cartPanelEl || !cartOverlay) return;
    cartPanelEl.hidden = !v;
    cartOverlay.hidden = !v;
  }

  cartToggle?.addEventListener('click', () => abrirCarrito(true));
  cartCerrar?.addEventListener('click', () => abrirCarrito(false));
  cartOverlay?.addEventListener('click', () => abrirCarrito(false));

  document.addEventListener('click', (e) => {
    const el = e.target as HTMLElement;

    const step = el.closest<HTMLButtonElement>('.pt-qty__b');
    if (step) {
      const cont = step.closest('.pt-prod__qty');
      const n = cont?.querySelector<HTMLElement>('.pt-qty__n');
      if (n) {
        const val = Math.max(1, (parseInt(n.textContent || '1', 10) || 1) + Number(step.dataset.step));
        n.textContent = String(val);
      }
      return;
    }

    const add = el.closest<HTMLButtonElement>('.pt-prod__add');
    if (add) {
      const card = add.closest<HTMLElement>('.pt-prod');
      const n = card?.querySelector<HTMLElement>('.pt-qty__n');
      const cantidad = parseInt(n?.textContent || '1', 10) || 1;
      const nombre = card?.querySelector<HTMLElement>('.pt-prod__nombre')?.textContent || 'Producto';
      const precio = Number(card?.dataset.precio || '0');
      const img = card?.querySelector('img')?.getAttribute('src') || '';

      const existente = carrito.find((i) => i.nombre === nombre);
      if (existente) existente.cantidad += cantidad;
      else carrito.push({ nombre, precio, img, cantidad });
      pintarCarrito();

      const prev = add.textContent;
      add.textContent = '¡Agregado!';
      add.classList.add('is-ok');
      window.setTimeout(() => {
        add.textContent = prev;
        add.classList.remove('is-ok');
      }, 1100);
    }
  });
</script>

<style>
  .pt-ticker {
    background: var(--pt-negro);
    color: #fff;
    overflow: hidden;
    white-space: nowrap;
  }

  .pt-ticker__track {
    display: inline-flex;
    gap: 3rem;
    padding-block: 0.5rem;
    animation: pt-marquee 22s linear infinite;
    font-size: 0.76rem;
    font-weight: 700;
  }

  @keyframes pt-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pt-ticker__track {
      animation: none;
    }
  }

  .pt-hdr {
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 65;
  }

  .pt-hdr__row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block: 0.9rem;
  }

  .pt-logo {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .pt-logo__ico {
    color: var(--pt-naranja);
    position: relative;
    top: 2px;
  }

  .pt-logo__tx {
    font-family: var(--pt-font-titulo);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--pt-negro);
  }

  .pt-logo__tx b {
    font-family: var(--pt-font);
    font-weight: 800;
    color: var(--pt-naranja);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-left: 0.35rem;
  }

  .pt-buscar {
    flex: 1;
    display: flex;
    align-items: center;
    border: 1.5px solid var(--pt-linea);
    border-radius: 999px;
    max-width: 560px;
    padding-left: 0.4rem;
  }

  .pt-buscar input {
    flex: 1;
    border: none;
    outline: none;
    padding: 0.6rem 0.6rem;
    font-size: 0.85rem;
    background: transparent;
    font-family: var(--pt-font);
  }

  .pt-buscar button {
    width: 40px;
    display: grid;
    place-items: center;
    color: var(--pt-naranja);
  }

  .pt-hdr__acc {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .pt-hdr__ico {
    position: relative;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    color: var(--pt-negro);
  }

  .pt-hdr__ico:hover {
    color: var(--pt-naranja);
  }

  .pt-hdr__badge[hidden] {
    display: none;
  }

  .pt-hdr__badge {
    position: absolute;
    top: 2px;
    right: 2px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 50%;
    background: var(--pt-verde);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 700;
    display: grid;
    place-items: center;
  }

  .pt-nav {
    background: var(--pt-naranja);
    position: relative;
  }

  .pt-nav__row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 0.7rem;
    flex-wrap: wrap;
  }

  .pt-nav__item,
  .pt-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .pt-nav__item:hover,
  .pt-nav__link:hover,
  .pt-nav__item.is-on {
    color: var(--pt-negro);
  }

  .pt-nav__link--dest {
    color: var(--pt-negro);
    background: #fff;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
  }

  .pt-mega[hidden] {
    display: none;
  }

  .pt-mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: #fff;
    box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.35);
    z-index: 90;
  }

  .pt-mega__panel[hidden] {
    display: none;
  }

  .pt-mega__panel {
    padding-block: 1.75rem;
  }

  .pt-mega__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 2rem;
  }

  .pt-mega__cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .pt-mega__col h3 {
    color: var(--pt-naranja);
    font-size: 0.9rem;
    margin-bottom: 0.9rem;
  }

  .pt-mega__col ul {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .pt-mega__col a {
    font-size: 0.82rem;
    color: var(--pt-texto);
  }

  .pt-mega__col a:hover {
    color: var(--pt-naranja);
  }

  .pt-mega__banners {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pt-mega__banner {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  .pt-mega__banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pt-mega__banner-tag {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    background: var(--pt-negro);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
  }

  .pt-mega__banner-t {
    position: absolute;
    inset: auto 0 0 0;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.65), transparent);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 1.2rem 0.7rem 0.5rem;
  }

  .pt-mega-overlay[hidden] {
    display: none;
  }

  .pt-mega-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
    z-index: 80;
  }

  .pt-cart-overlay[hidden] {
    display: none;
  }

  .pt-cart-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 140;
  }

  .pt-cart[hidden] {
    display: none;
  }

  .pt-cart {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(400px, 92vw);
    background: #fff;
    z-index: 150;
    display: flex;
    flex-direction: column;
    box-shadow: -20px 0 40px -20px rgba(0, 0, 0, 0.5);
  }

  .pt-cart__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--pt-linea);
  }

  .pt-cart__head small {
    font-size: 0.75rem;
    color: var(--pt-gris);
    font-weight: 700;
  }

  .pt-cart__body {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pt-cart__vacio[hidden] {
    display: none;
  }

  .pt-cart__vacio {
    color: var(--pt-gris);
    font-size: 0.88rem;
  }

  .pt-cart__foot {
    border-top: 1px solid var(--pt-linea);
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .pt-cart__total {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .pt-cart__pagar {
    width: 100%;
  }

  @media (max-width: 900px) {
    .pt-buscar {
      order: 3;
      flex-basis: 100%;
      max-width: none;
    }
    .pt-hdr__row {
      flex-wrap: wrap;
    }
    .pt-nav__row {
      gap: 1rem;
      overflow-x: auto;
      flex-wrap: nowrap;
    }
    .pt-mega__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
