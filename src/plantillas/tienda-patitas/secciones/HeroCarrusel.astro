---
import { heroSlides } from '../datos/patitas.js';

interface Slide { kicker: string; titulo: string; sub: string; pct: string; img: string }
const slides = heroSlides as Slide[];
---

<section class="pt-hero" id="hero">
  <div class="pt-hero__track" id="pt-hero-track">
    {slides.map((s: Slide, i: number) => (
      <div class="pt-hero__slide">
        <img src={s.img} alt={s.titulo} loading={i === 0 ? 'eager' : 'lazy'} />
        <div class="pt-hero__overlay"></div>
        <div class="pt-wrap pt-hero__inner">
          <div class="pt-hero__tx">
            <span class="pt-hero__kicker">{s.kicker}</span>
            <h1>{s.titulo}</h1>
            <p>{s.sub}</p>
            <a href="#ofertas" class="pt-btn pt-btn--naranja">Comprar ahora</a>
          </div>
          <span class="pt-hero__pct">{s.pct}</span>
        </div>
      </div>
    ))}
  </div>

  <button type="button" class="pt-hero__flecha pt-hero__flecha--prev" id="pt-hero-prev" aria-label="Anterior">‹</button>
  <button type="button" class="pt-hero__flecha pt-hero__flecha--next" id="pt-hero-next" aria-label="Siguiente">›</button>

  <div class="pt-hero__dots" id="pt-hero-dots">
    {slides.map((_s: Slide, i: number) => (
      <button type="button" class={`pt-hero__dot${i === 0 ? ' is-on' : ''}`} data-idx={i} aria-label={`Ir a slide ${i + 1}`}></button>
    ))}
  </div>
</section>

<script>
  const track = document.getElementById('pt-hero-track');
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('#pt-hero-dots .pt-hero__dot'));
  const prev = document.getElementById('pt-hero-prev');
  const next = document.getElementById('pt-hero-next');
  const total = dots.length;
  let idx = 0;
  let timer: ReturnType<typeof setInterval> | undefined;

  function ir(n: number) {
    idx = (n + total) % total;
    if (track) track.style.transform = `translateX(-${idx * 100}%)`;
    dots.forEach((d, i) => d.classList.toggle('is-on', i === idx));
  }

  function play() {
    timer = setInterval(() => ir(idx + 1), 6500);
  }

  function pause() {
    if (timer) clearInterval(timer);
  }

  prev?.addEventListener('click', () => { ir(idx - 1); pause(); play(); });
  next?.addEventListener('click', () => { ir(idx + 1); pause(); play(); });
  dots.forEach((d) => d.addEventListener('click', () => { ir(Number(d.dataset.idx)); pause(); play(); }));

  const hero = document.getElementById('hero');
  hero?.addEventListener('mouseenter', pause);
  hero?.addEventListener('mouseleave', play);

  play();
</script>

<style>
  .pt-hero {
    position: relative;
    overflow: hidden;
  }

  .pt-hero__track {
    display: flex;
    transition: transform 0.6s ease;
  }

  .pt-hero__slide {
    position: relative;
    min-width: 100%;
    height: clamp(380px, 52vw, 560px);
  }

  .pt-hero__slide img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pt-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(20, 14, 10, 0.78) 0%, rgba(20, 14, 10, 0.3) 50%, rgba(20, 14, 10, 0.05) 78%);
  }

  .pt-hero__inner {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .pt-hero__tx {
    color: #fff;
    max-width: 34ch;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .pt-hero__kicker {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--pt-crema);
  }

  .pt-hero__tx h1 {
    font-size: clamp(1.6rem, 3.6vw, 2.7rem);
    font-weight: 700;
    line-height: 1.15;
    color: #fff;
  }

  .pt-hero__tx p {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.9);
    max-width: 34ch;
  }

  .pt-hero__tx .pt-btn {
    align-self: flex-start;
    margin-top: 0.3rem;
  }

  .pt-hero__pct {
    font-family: var(--pt-font-titulo);
    font-size: clamp(3rem, 9vw, 6.5rem);
    font-weight: 800;
    color: var(--pt-naranja);
    line-height: 1;
    -webkit-text-stroke: 2px #fff;
  }

  .pt-hero__flecha {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    color: var(--pt-negro);
    font-size: 1.4rem;
    display: grid;
    place-items: center;
    z-index: 5;
  }

  .pt-hero__flecha--prev {
    left: 1rem;
  }

  .pt-hero__flecha--next {
    right: 1rem;
  }

  .pt-hero__dots {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
    z-index: 5;
  }

  .pt-hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
  }

  .pt-hero__dot.is-on {
    background: var(--pt-naranja);
    width: 22px;
    border-radius: 4px;
  }

  @media (max-width: 720px) {
    .pt-hero__inner {
      justify-content: center;
      text-align: center;
    }
    .pt-hero__tx {
      max-width: 100%;
      align-items: center;
    }
    .pt-hero__pct {
      display: none;
    }
  }
</style>
