---
import { financiamiento } from '../datos/patitas.js';
import Icono from '../componentes/Icono.astro';
---

<section class="pt-financia">
  <div class="pt-wrap pt-financia__fila">
    <div class="pt-financia__tx">
      <span class="pt-financia__ico"><Icono name="carrito" size={22} /></span>
      <div>
        <b>{financiamiento.titulo}</b>
        <span>{financiamiento.texto}</span>
      </div>
    </div>
    <a href="#ofertas" class="pt-btn pt-btn--naranja">Más información</a>
  </div>
</section>

<style>
  .pt-financia {
    background: var(--pt-morado);
  }

  .pt-financia__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 1.3rem;
  }

  .pt-financia__tx {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: #fff;
  }

  .pt-financia__ico {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .pt-financia__tx b {
    display: block;
    font-family: var(--pt-font-titulo);
    font-size: 1.05rem;
  }

  .pt-financia__tx span {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.85);
  }
</style>
