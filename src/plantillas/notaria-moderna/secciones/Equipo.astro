---
import { equipo, marca } from '../datos/notaria.js';

interface Persona { n: string; mail: string; wsp?: string; anexo?: string }
interface Area { area: string; personas: Persona[] }
const areas = equipo as Area[];
---

<section class="nm-seccion nm-eq" id="equipo" aria-labelledby="nm-eq-titulo">
  <div class="nm-wrap nm-eq__wrap">
    <header class="nm-eq__cab">
      <span class="nm-kicker">Directorio por áreas</span>
      <h2 class="nm-titulo" id="nm-eq-titulo">Nuestro equipo está listo para ayudarte a resolver tus dudas y consultas</h2>
      <p class="nm-lead">Si tiene alguna consulta o reclamo, comuníquese con nuestra central telefónica <b>{marca.tel}</b> o directamente con el área específica mediante su anexo, WhatsApp o correo. Aquí encontrará la lista completa:</p>
    </header>

    <div class="nm-eq__acord">
      {areas.map((a, i) => (
        <div class={`nm-eq__item${i === 0 ? ' is-open' : ''}`}>
          <h3>
            <button type="button" class="nm-eq__btn" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`nm-eq-${i}`}>
              {a.area}
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4.5 6 8.5l4-4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
            </button>
          </h3>
          <div class="nm-eq__panel" id={`nm-eq-${i}`} hidden={i !== 0}>
            {a.personas.map((p) => (
              <div class="nm-eq__persona">
                <p class="nm-eq__nombre">{p.n}</p>
                <ul class="nm-eq__datos">
                  <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1" /><path d="m3 6 9 7 9-7" /></svg>
                    <a href={`mailto:${p.mail}`}>{p.mail}</a>
                  </li>
                  {p.wsp && (
                    <li>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 0 1-11.8 7L4 20l1.1-4A8 8 0 1 1 20 12Z" /></svg>
                      {p.wsp}
                    </li>
                  )}
                  {p.anexo && (
                    <li>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
                      Central, anexo {p.anexo}
                    </li>
                  )}
                </ul>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.nm-eq__btn').forEach((btn) =>
    btn.addEventListener('click', () => {
      const item = btn.closest('.nm-eq__item');
      const panel = document.getElementById(btn.getAttribute('aria-controls') ?? '');
      if (!item || !panel) return;
      const abrir = !item.classList.contains('is-open');
      document.querySelectorAll('.nm-eq__item.is-open').forEach((o) => {
        o.classList.remove('is-open');
        o.querySelector('.nm-eq__btn')?.setAttribute('aria-expanded', 'false');
        const p = o.querySelector<HTMLElement>('.nm-eq__panel');
        if (p) p.hidden = true;
      });
      item.classList.toggle('is-open', abrir);
      btn.setAttribute('aria-expanded', String(abrir));
      panel.hidden = !abrir;
    }),
  );
</script>

<style>
  .nm-eq {
    background: var(--nm-papel);
  }

  .nm-eq__wrap {
    max-width: 920px;
  }

  .nm-eq__cab {
    text-align: center;
    margin-bottom: 2.4rem;
  }

  .nm-eq__cab .nm-lead {
    margin: 0 auto;
    font-size: 0.93rem;
  }

  .nm-eq__cab b {
    color: var(--nm-tinta);
    font-weight: 500;
  }

  .nm-eq__acord {
    display: grid;
    gap: 10px;
  }

  .nm-eq__btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    text-align: left;
    padding: 1rem 1.25rem;
    font-family: var(--nm-sans);
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--nm-tinta);
    background: #e6e6e3;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .nm-eq__btn:hover {
    background: #dcdcd8;
  }

  .nm-eq__btn svg {
    width: 12px;
    height: 12px;
    transition: transform 0.2s ease;
  }

  .nm-eq__item.is-open .nm-eq__btn {
    background: var(--nm-tinta);
    color: #fff;
  }

  .nm-eq__item.is-open .nm-eq__btn svg {
    transform: rotate(180deg);
  }

  .nm-eq__panel {
    display: grid;
    gap: 10px;
    padding-top: 10px;
  }

  .nm-eq__persona {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    background: #fff;
    border: 1px solid rgba(141, 180, 58, 0.6);
    padding: 1.3rem 1.8rem;
  }

  .nm-eq__nombre {
    font-family: var(--nm-serif);
    font-size: 1.3rem;
    color: var(--nm-tinta);
    padding-right: 1.5rem;
    border-right: 2px solid rgba(141, 180, 58, 0.6);
  }

  .nm-eq__datos {
    display: grid;
    gap: 0.35rem;
    font-size: 0.86rem;
  }

  .nm-eq__datos li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    word-break: break-word;
  }

  .nm-eq__datos a:hover {
    color: var(--nm-tinta);
    text-decoration: underline;
  }

  .nm-eq__datos svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    fill: none;
    stroke: var(--nm-suave);
    stroke-width: 1.5;
  }

  @media (max-width: 620px) {
    .nm-eq__persona {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.8rem;
      padding: 1.1rem 1.2rem;
    }

    .nm-eq__nombre {
      border-right: 0;
      padding-right: 0;
      padding-bottom: 0.6rem;
      border-bottom: 2px solid rgba(141, 180, 58, 0.6);
    }
  }
</style>
