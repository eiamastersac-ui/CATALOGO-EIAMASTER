---
import { compromiso, img, marca } from '../datos/notaria.js';

const iconos: Record<string, string> = {
  Experiencia: 'M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6Z M8.8 12l2.2 2.2 4.3-4.4',
  'Seguridad jurídica': 'M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6Z M9 11V9.5a3 3 0 0 1 6 0V11 M8.5 11h7v5h-7Z',
  'Trabajo en equipo': 'M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6Z M9.5 10.5a1.5 1.5 0 1 0 0-.1 M14.5 10.5a1.5 1.5 0 1 0 0-.1 M7.5 15.5c.6-1.5 1.6-2.2 2-2.2h5c.4 0 1.4.7 2 2.2',
  Compromiso: 'M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6Z M12 16s-3.5-2.1-3.5-4.4a1.9 1.9 0 0 1 3.5-1 1.9 1.9 0 0 1 3.5 1C15.5 13.9 12 16 12 16Z',
};
---

<section class="nm-seccion nm-cp" id="notaria" aria-labelledby="nm-cp-titulo">
  <div class="nm-wrap nm-cp__grid">
    <div>
      <span class="nm-kicker">La Notaría</span>
      <h2 class="nm-titulo" id="nm-cp-titulo">{compromiso.titulo}</h2>
      <p class="nm-cp__txt">{compromiso.texto}</p>
      <ul class="nm-check nm-cp__lista">
        {(compromiso.lista as string[]).map((l) => <li>{l}</li>)}
      </ul>

      <figure class="nm-cp__notario">
        <img src={img('notario', 200)} alt="" loading="lazy" />
        <figcaption>
          <b>{marca.notario}</b>
          <span>Notario de Lima · Colegio de Notarios de Lima (demo)</span>
        </figcaption>
      </figure>
    </div>

    <ul class="nm-cp__valores">
      {(compromiso.valores as string[]).map((v) => (
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={iconos[v]} /></svg>
          <h3>{v}</h3>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .nm-cp {
    background: var(--nm-papel);
  }

  .nm-cp__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .nm-cp__txt {
    color: var(--nm-texto);
    margin-bottom: 1.5rem;
  }

  .nm-cp__lista {
    font-size: 0.92rem;
    margin-bottom: 2rem;
  }

  .nm-cp__notario {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--nm-linea);
  }

  .nm-cp__notario img {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 20%;
  }

  .nm-cp__notario figcaption {
    display: grid;
    line-height: 1.35;
  }

  .nm-cp__notario b {
    font-family: var(--nm-serif);
    font-weight: 400;
    font-size: 1.15rem;
    color: var(--nm-tinta);
  }

  .nm-cp__notario span {
    font-size: 0.8rem;
    color: var(--nm-suave);
  }

  .nm-cp__valores {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .nm-cp__valores li {
    background: #fff;
    aspect-ratio: 16 / 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    text-align: center;
    padding: 1rem;
    box-shadow: 0 20px 40px -28px rgba(31, 42, 48, 0.35);
    transition: transform 0.25s ease;
  }

  .nm-cp__valores li:hover {
    transform: translateY(-4px);
  }

  .nm-cp__valores svg {
    width: 38px;
    height: 38px;
    fill: none;
    stroke: var(--nm-acento);
    stroke-width: 1.3;
  }

  .nm-cp__valores h3 {
    font-size: 1.2rem;
  }

  @media (max-width: 860px) {
    .nm-cp__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 420px) {
    .nm-cp__valores {
      gap: 0.8rem;
    }

    .nm-cp__valores li {
      aspect-ratio: 1;
    }

    .nm-cp__valores h3 {
      font-size: 1.02rem;
    }
  }
</style>
