---
import { kardexDemo, pasosKardex } from '../datos/notaria.js';

const demo = JSON.stringify({ items: kardexDemo, pasos: pasosKardex });
const ejemplos = (kardexDemo as { kardex: string; doc: string }[]).map((k) => k.kardex);
---

<section class="nm-kx" id="kardex" aria-labelledby="nm-kx-titulo">
  <div class="nm-wrap nm-kx__grid">
    <div class="nm-kx__txt">
      <span class="nm-kicker nm-kx__kicker">Consulta tu Kardex</span>
      <h2 id="nm-kx-titulo">Consulte el estado de su trámite notarial de manera gratuita</h2>
      <p>Seleccione el tipo de búsqueda y digite el número. Luego haga clic en <b>Buscar</b> y podrá visualizar el resultado al instante. Ponemos a su disposición el servicio de consultas en línea para el control de todos sus servicios notariales, sin costo adicional.</p>
      <p class="nm-kx__demo">Pruebe con los Kardex de demostración: {ejemplos.map((e, i) => (<><button type="button" data-ej={e}>{e}</button>{i < ejemplos.length - 1 ? ', ' : ''}</>))}</p>
    </div>

    <form class="nm-kx__panel" id="nm-kx-form" novalidate>
      <fieldset class="nm-kx__modo">
        <legend class="nm-kx__sr">Buscar por</legend>
        <label><input type="radio" name="modo" value="kardex" checked /><span></span>Por número de <b>Kardex</b></label>
        <label><input type="radio" name="modo" value="doc" /><span></span>Por DNI (o) RUC</label>
      </fieldset>

      <label class="nm-kx__sr" for="nm-kx-num">Número a consultar</label>
      <input id="nm-kx-num" class="nm-kx__input" type="text" inputmode="numeric" autocomplete="off" placeholder="Ingrese el número aquí" maxlength="11" />

      <div class="nm-kx__teclado" aria-label="Teclado numérico">
        {['1', '2', '3', '4', '5', '6', '7', '8', '9'].map((n) => (
          <button type="button" data-tecla={n}>{n}</button>
        ))}
        <button type="button" data-tecla="borrar" aria-label="Borrar último dígito">
          <svg viewBox="0 0 20 16" aria-hidden="true"><path d="M7 2h11v12H7L2 8Z M10 5.5l5 5M15 5.5l-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
        </button>
        <button type="button" data-tecla="0">0</button>
        <button type="button" data-tecla="guion" aria-label="Guion">-</button>
      </div>

      <button type="submit" class="nm-btn nm-btn--acento nm-kx__buscar">
        Buscar
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
      </button>
    </form>
  </div>

  <div class="nm-kx__res">
    <div class="nm-wrap">
      <h3>Resultado de búsqueda</h3>
      <p class="nm-kx__res-sub" id="nm-kx-sub">Aún no ha realizado ninguna consulta.</p>
      <div class="nm-kx__res-lista" id="nm-kx-res" aria-live="polite"></div>
    </div>
  </div>

  <script is:inline type="application/json" id="nm-kx-data" set:html={demo} />
</section>

<script>
  interface Item { kardex: string; doc: string; fecha: string; acto: string; estado: string; paso: number }
  const data = JSON.parse(document.getElementById('nm-kx-data')?.textContent ?? '{}') as { items: Item[]; pasos: string[] };
  const form = document.getElementById('nm-kx-form') as HTMLFormElement | null;
  const input = document.getElementById('nm-kx-num') as HTMLInputElement | null;
  const res = document.getElementById('nm-kx-res');
  const sub = document.getElementById('nm-kx-sub');

  form?.querySelectorAll<HTMLButtonElement>('[data-tecla]').forEach((b) =>
    b.addEventListener('click', () => {
      if (!input) return;
      const t = b.dataset.tecla;
      if (t === 'borrar') input.value = input.value.slice(0, -1);
      else if (input.value.length < 11) input.value += t === 'guion' ? '-' : t;
      input.focus();
    }),
  );

  input?.addEventListener('input', () => {
    input.value = input.value.replace(/[^0-9-]/g, '');
  });

  const modo = () => (form?.querySelector<HTMLInputElement>('input[name="modo"]:checked')?.value ?? 'kardex');

  form?.querySelectorAll<HTMLInputElement>('input[name="modo"]').forEach((r) =>
    r.addEventListener('change', () => {
      if (input) {
        input.placeholder = r.value === 'doc' ? 'Ingrese su DNI o RUC' : 'Ingrese el número aquí';
        input.value = '';
      }
    }),
  );

  const tarjeta = (it: Item) => {
    const card = document.createElement('article');
    card.className = 'nm-res-card';
    const top = document.createElement('div');
    top.className = 'nm-res-card__top';
    top.innerHTML = `<span>Kardex: <b></b></span><span>Fecha: <b></b></span>`;
    const b = top.querySelectorAll('b');
    b[0].textContent = it.kardex;
    b[1].textContent = it.fecha;
    const h = document.createElement('h4');
    h.textContent = it.acto;
    const est = document.createElement('span');
    est.className = 'nm-res-card__estado';
    est.textContent = it.estado;
    const pasos = document.createElement('div');
    pasos.className = 'nm-pasos';
    data.pasos.forEach((p, i) => {
      const s = document.createElement('span');
      s.textContent = p;
      if (i < it.paso) s.className = 'is-on';
      pasos.appendChild(s);
    });
    card.append(top, h, est, pasos);
    return card;
  };

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!input || !res || !sub) return;
    const q = input.value.trim();
    res.innerHTML = '';
    if (!q) {
      sub.textContent = 'Digite un número para consultar.';
      input.focus();
      return;
    }
    const m = modo();
    const hallados = data.items.filter((it) => (m === 'doc' ? it.doc === q : it.kardex.replace('-', '') === q.replace('-', '')));
    if (hallados.length) {
      sub.textContent = `${hallados.length} resultado${hallados.length > 1 ? 's' : ''} para "${q}".`;
      hallados.forEach((it) => res.appendChild(tarjeta(it)));
    } else {
      sub.textContent = `Sin resultados para "${q}".`;
      const v = document.createElement('p');
      v.className = 'nm-res-vacio';
      v.textContent = 'No encontramos trámites con ese número. Verifique el dato o comuníquese con Caja / Archivo para mayor información.';
      res.appendChild(v);
    }
    document.querySelector('.nm-kx__res')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });

  document.querySelectorAll<HTMLButtonElement>('.nm-kx__demo [data-ej]').forEach((b) =>
    b.addEventListener('click', () => {
      const r = form?.querySelector<HTMLInputElement>('input[value="kardex"]');
      if (r) r.checked = true;
      if (input) input.value = b.dataset.ej ?? '';
      form?.requestSubmit();
    }),
  );
</script>

<style>
  .nm-kx {
    scroll-margin-top: 70px;
  }

  .nm-kx__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-top: clamp(3.5rem, 7vw, 5rem);
    padding-bottom: clamp(3.5rem, 7vw, 5rem);
  }

  .nm-kx {
    background: var(--nm-tinta);
    color: rgba(255, 255, 255, 0.86);
  }

  .nm-kx__kicker {
    color: rgba(255, 255, 255, 0.7);
  }

  .nm-kx h2 {
    color: #fff;
    font-size: clamp(1.8rem, 3.6vw, 2.5rem);
    margin-bottom: 1rem;
    max-width: 20ch;
  }

  .nm-kx__txt p {
    max-width: 56ch;
    font-size: 0.95rem;
  }

  .nm-kx__txt b {
    color: #fff;
  }

  .nm-kx__demo {
    margin-top: 1.1rem;
    font-size: 0.85rem !important;
    color: rgba(255, 255, 255, 0.7);
  }

  .nm-kx__demo button {
    color: #fff;
    text-decoration: underline;
    text-decoration-color: var(--nm-acento);
    text-underline-offset: 3px;
    font-variant-numeric: tabular-nums;
  }

  .nm-kx__panel {
    background: var(--nm-tinta-2);
    padding: 1.6rem;
    border-radius: 4px;
    box-shadow: 0 30px 50px -30px rgba(0, 0, 0, 0.7);
    display: grid;
    gap: 1rem;
  }

  .nm-kx__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .nm-kx__modo {
    border: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.6rem;
    font-size: 0.84rem;
    color: #fff;
  }

  .nm-kx__modo label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }

  .nm-kx__modo input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .nm-kx__modo span {
    width: 17px;
    height: 17px;
    border: 1.5px solid #fff;
    display: grid;
    place-items: center;
  }

  .nm-kx__modo input:checked + span {
    background: var(--nm-acento);
    border-color: var(--nm-acento);
  }

  .nm-kx__modo input:checked + span::after {
    content: "";
    width: 8px;
    height: 4px;
    border: solid #fff;
    border-width: 0 0 2px 2px;
    transform: rotate(-45deg) translate(1px, -1px);
  }

  .nm-kx__modo input:focus-visible + span {
    outline: 2px solid var(--nm-acento);
    outline-offset: 2px;
  }

  .nm-kx__input {
    width: 100%;
    background: #fff;
    border: 0;
    border-radius: 2px;
    padding: 0.8rem 0.9rem;
    font-size: 1rem;
    color: var(--nm-tinta-2);
    letter-spacing: 0.06em;
    text-align: center;
  }

  .nm-kx__teclado {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .nm-kx__teclado button {
    height: 42px;
    background: var(--nm-tinta);
    color: #fff;
    font-weight: 500;
    border-radius: 2px;
    display: grid;
    place-items: center;
    transition: background 0.15s ease;
  }

  .nm-kx__teclado button:hover {
    background: #3b5a6b;
  }

  .nm-kx__teclado button:active {
    background: var(--nm-acento);
  }

  .nm-kx__teclado svg {
    width: 20px;
    height: 16px;
  }

  .nm-kx__buscar {
    width: 100%;
  }

  .nm-kx__res {
    background: var(--nm-papel);
    color: var(--nm-texto);
    padding: 2.6rem 0 3rem;
  }

  .nm-kx__res h3 {
    font-size: 1.6rem;
    margin-bottom: 0.3rem;
  }

  .nm-kx__res-sub {
    font-size: 0.9rem;
    color: var(--nm-suave);
    margin-bottom: 1.2rem;
  }

  .nm-kx__res-lista {
    display: grid;
    gap: 1rem;
    max-width: 720px;
  }

  @media (max-width: 860px) {
    .nm-kx__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .nm-kx__panel {
      max-width: 420px;
      width: 100%;
    }
  }
</style>
