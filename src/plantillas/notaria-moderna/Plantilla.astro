---
import './estilos.css';

import Cabecera from './secciones/Cabecera.astro';
import Hero from './secciones/Hero.astro';
import TramitesLinea from './secciones/TramitesLinea.astro';
import Servicios from './secciones/Servicios.astro';
import Requisitos from './secciones/Requisitos.astro';
import Kardex from './secciones/Kardex.astro';
import CitaBanda from './secciones/CitaBanda.astro';
import Compromiso from './secciones/Compromiso.astro';
import Pagos from './secciones/Pagos.astro';
import Contacto from './secciones/Contacto.astro';
import Equipo from './secciones/Equipo.astro';
import Testimonios from './secciones/Testimonios.astro';
import PiePagina from './secciones/PiePagina.astro';
import CitaModal from './secciones/CitaModal.astro';
---

<div class="tpl-notaria-moderna">
  <Cabecera />
  <main>
    <Hero />
    <TramitesLinea />
    <Servicios />
    <Requisitos />
    <Kardex />
    <CitaBanda />
    <Compromiso />
    <Pagos />
