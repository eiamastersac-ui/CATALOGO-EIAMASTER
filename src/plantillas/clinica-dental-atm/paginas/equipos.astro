---
import Marco from '../componentes/Marco.astro';
import { equipos } from '../datos/clinica.js';

export const titulo = 'Venta de Equipos | tu tienda.com';
export const descripcion = 'Tecnología de precisión para el diagnóstico y tratamiento funcional craneomandibular.';
---

<Marco>
  <section class="am-eq-hero">
    <div class="am-wrap">
      <span class="am-pill">{equipos.kicker}</span>
      <h1>{equipos.titulo}</h1>
      <p>{equipos.sub}</p>
    </div>
  </section>

  <section class="am-seccion am-wrap am-eq-intro">
    <div class="am-eq-intro__foto am-reveal">
      <img src={equipos.intro.img} alt={equipos.intro.titulo} loading="lazy" />
    </div>
    <div class="am-eq-intro__texto am-reveal am-reveal--2">
      <h2>{equipos.intro.titulo}</h2>
      <p>{equipos.intro.d1}</p>
      <p>{equipos.intro.d2}</p>
      <a href="#contacto-equipos" class="am-btn am-btn--cian">Solicitar información</a>
    </div>
  </section>

  <section class="am-seccion am-wrap am-eq-cta" id="contacto-equipos">
    <h2 class="am-titulo am-centro">¿Quieres equipar tu consultorio?</h2>
    <p class="am-sub am-centro">Escríbenos por WhatsApp y te asesoramos sobre la tecnología de precisión que mejor se adapta a tu clínica.</p>
    <div class="am-eq-cta__acciones">
      <a href="/plantillas/clinica-dental-atm/#top" class="am-btn am-btn--navy">Volver al inicio</a>
    </div>
  </section>
</Marco>

<style>
  .am-eq-hero {
    background: var(--am-navy);
    padding-block: clamp(3rem, 7vw, 4.5rem);
    text-align: center;
  }

  .am-eq-hero h1 {
    color: #fff;
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    margin-bottom: 0.9rem;
  }

  .am-eq-hero p {
    color: rgba(255, 255, 255, 0.82);
    max-width: 40rem;
    margin-inline: auto;
  }

  .am-eq-intro {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  .am-eq-intro__foto {
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }

  .am-eq-intro__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .am-eq-intro__texto h2 {
    color: var(--am-cian-oscuro);
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 1.1rem;
  }

  .am-eq-intro__texto p {
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .am-eq-intro__texto .am-btn {
    margin-top: 0.75rem;
  }

  .am-eq-cta {
    background: var(--am-crema);
    border-radius: 20px;
    text-align: center;
    padding-block: clamp(2.5rem, 6vw, 3.5rem);
  }

  .am-eq-cta__acciones {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }

  @media (max-width: 780px) {
    .am-eq-intro {
      grid-template-columns: 1fr;
    }

    .am-eq-intro__foto {
      max-width: 22rem;
      margin-inline: auto;
    }
  }
</style>
