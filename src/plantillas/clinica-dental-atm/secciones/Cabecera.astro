---
import { marca, nav, base } from '../datos/clinica.js';

interface ItemNav {
  t: string;
  href: string;
  externo?: boolean;
}
const lista = nav as ItemNav[];
---

<div class="am-hdr-barra"></div>
<header class="am-hdr" id="cabecera">
  <div class="am-wrap am-hdr__fila">
    <a href={`${base}/#top`} class="am-logo">
      <span class="am-logo__marca">{marca.nombre}</span>
      <span class="am-logo__sub">{marca.sub}</span>
    </a>

    <nav class="am-nav" id="am-nav" aria-label="Navegación principal">
      {lista.map((item) => (
        <a href={item.externo ? `${base}${item.href}` : item.href.startsWith('#') ? `${base}/${item.href}` : item.href} class="am-nav__link">{item.t}</a>
      ))}
    </nav>

    <div class="am-hdr__acc">
      <a href={`${base}/#contacto`} class="am-btn am-btn--navy">Contáctanos</a>
      <button type="button" class="am-hdr__burger" id="am-burger" aria-label="Abrir menú" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const burger = document.getElementById('am-burger');
  const nav = document.getElementById('am-nav');

  burger?.addEventListener('click', () => {
    const abierto = nav?.classList.toggle('is-abierto');
    burger.setAttribute('aria-expanded', String(!!abierto));
  });

  nav?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      nav.classList.remove('is-abierto');
      burger?.setAttribute('aria-expanded', 'false');
    }),
  );
</script>

<style>
  .am-hdr-barra {
    height: 4px;
    background: linear-gradient(90deg, var(--am-cian), var(--am-navy));
  }

  .am-hdr {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    background: #fff;
    box-shadow: 0 1px 0 var(--am-linea);
  }

  .am-hdr__fila {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: var(--am-hdr-h);
  }

  .am-logo {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    flex-shrink: 0;
  }

  .am-logo__marca {
    font-weight: 800;
    font-size: 1.2rem;
    color: var(--am-tinta);
  }

  .am-logo__sub {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--am-cian-oscuro);
  }

  .am-nav {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-inline: auto;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .am-nav__link {
    color: var(--am-tinta);
    padding: 0.5rem 0;
  }

  .am-nav__link:hover {
    color: var(--am-cian-oscuro);
  }

  .am-hdr__acc {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .am-hdr__burger {
    display: none;
    flex-direction: column;
    gap: 4px;
    width: 24px;
  }

  .am-hdr__burger span {
    height: 2px;
    background: var(--am-tinta);
    border-radius: 2px;
  }

  @media (max-width: 900px) {
    .am-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: #fff;
      border-bottom: 2px solid var(--am-linea);
      padding: 0.5rem clamp(1.1rem, 4vw, 2rem) 1rem;
    }

    .am-nav.is-abierto {
      display: flex;
    }

    .am-nav__link {
      padding-block: 0.75rem;
      border-top: 1px solid var(--am-linea);
    }

    .am-hdr__burger {
      display: flex;
    }
  }
</style>
