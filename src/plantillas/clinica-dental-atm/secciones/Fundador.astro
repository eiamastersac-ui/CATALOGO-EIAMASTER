---
import { fundador } from '../datos/clinica.js';
import Icono from '../componentes/Icono.astro';

interface Destacado {
  t: string;
  icono: string;
}
const destacados = fundador.destacados as Destacado[];
---

<section class="am-fundador">
  <div class="am-wrap am-fundador__grid">
    <div class="am-fundador__texto am-reveal">
      <span class="am-pill">{fundador.kicker}</span>
      <h2 class="am-titulo">{fundador.nombre}</h2>
      <p class="am-fundador__cargo">{fundador.cargo}</p>
      <p class="am-fundador__bio">{fundador.bio}</p>

      <ul class="am-fundador__destacados">
        {destacados.map((d: Destacado) => (
          <li>
            <span class="am-fundador__ico"><Icono nombre={d.icono} size={18} /></span>
            {d.t}
          </li>
        ))}
      </ul>
    </div>

    <div class="am-fundador__foto am-reveal am-reveal--2">
      <img src={fundador.img} alt={fundador.nombre} loading="lazy" />
    </div>
  </div>
</section>

<style>
  .am-fundador {
    background: var(--am-crema);
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .am-fundador__grid {
    display: grid;
    grid-template-columns: 1fr 0.7fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  .am-fundador__cargo {
    color: var(--am-cian-oscuro);
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 1.25rem;
  }

  .am-fundador__bio {
    font-size: 0.95rem;
    margin-bottom: 1.75rem;
    max-width: 42ch;
  }

  .am-fundador__destacados {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .am-fundador__destacados li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-weight: 600;
    color: var(--am-tinta);
    font-size: 0.94rem;
  }

  .am-fundador__ico {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--am-cian-suave);
    color: var(--am-cian-oscuro);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .am-fundador__foto {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: #fff;
  }

  .am-fundador__foto::after {
    content: "";
    position: absolute;
    inset: -10px -10px auto auto;
    width: 100%;
    height: 100%;
    border: 3px solid var(--am-cian);
    border-radius: 16px;
    z-index: -1;
  }

  .am-fundador__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 780px) {
    .am-fundador__grid {
      grid-template-columns: 1fr;
    }

    .am-fundador__foto {
      order: -1;
      max-width: 18rem;
      margin-inline: auto;
    }
  }
</style>
