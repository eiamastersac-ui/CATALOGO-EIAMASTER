---
import { nosotros } from '../datos/clinica.js';
---

<section class="am-seccion am-wrap am-nosotros" id="nosotros">
  <div class="am-nosotros__texto am-reveal">
    <span class="am-pill">{nosotros.kicker}</span>
    <h2 class="am-titulo">{nosotros.titulo}</h2>
    <p>{nosotros.p1}</p>
    <p>{nosotros.p2}</p>
  </div>

  <div class="am-nosotros__foto am-reveal am-reveal--2">
    <img src={nosotros.img} alt="Consulta en tu tienda.com" loading="lazy" />
  </div>
</section>

<style>
  .am-nosotros {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  .am-nosotros__texto p {
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .am-nosotros__foto {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }

  .am-nosotros__foto::after {
    content: "";
    position: absolute;
    inset: -10px -10px auto auto;
    width: 100%;
    height: 100%;
    border: 3px solid var(--am-cian);
    border-radius: 16px;
    z-index: -1;
  }

  .am-nosotros__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 780px) {
    .am-nosotros {
      grid-template-columns: 1fr;
    }

    .am-nosotros__foto {
      order: -1;
      max-width: 22rem;
      margin-inline: auto;
    }
  }
</style>
