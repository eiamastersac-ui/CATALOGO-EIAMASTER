---
import { marca, nav, etiquetaSub } from '../datos/tienda.js';
import Icono from '../componentes/Icono.astro';

type Item = { t: string; ico?: string; href: string; destacado?: boolean; sub?: string[] };
---

<header class="cs-hdr" id="cs-cabecera">
  <div class="cs-hdr__top">
    <div class="cs-wrap cs-hdr__fila">
      <a href="#top" class="cs-logo" aria-label={`${marca.nombre} ${marca.sub} — inicio`}>
        <span class="cs-logo__caja">{marca.nombre.toUpperCase()}</span>
        <span class="cs-logo__sub"><i></i>DE {marca.sub.toUpperCase()}<i></i></span>
      </a>

      <form class="cs-buscar" id="cs-buscar" role="search">
        <button type="submit" class="cs-buscar__btn" aria-label="Buscar"><Icono nombre="lupa" size={20} /></button>
        <input
          type="search"
          id="cs-buscar-q"
          placeholder="Buscar Packs, Bombines , Escudos..."
          aria-label="Buscar productos"
          autocomplete="off"
        />
      </form>

      <div class="cs-hdr__acc">
        <a href="#cs-pie" class="cs-hdr__icono">
          <Icono nombre="pedido" size={22} />
          <span>Rastrear pedido</span>
        </a>
        <button type="button" class="cs-hdr__carrito" id="cs-carrito-btn" aria-label="Carrito">
          <Icono nombre="carrito" size={28} />
          <b class="cs-badge" data-cs-badge>0</b>
        </button>
      </div>
    </div>
  </div>

  <nav class="cs-nav" aria-label="Categorías">
    <ul class="cs-wrap cs-nav__lista">
      {
        nav.map((n: Item) => (
          <li class={`cs-nav__item ${n.sub ? 'tiene-sub' : ''}`}>
            <a
              href={n.href}
              class={`cs-nav__link ${n.destacado ? 'is-destacado' : ''}`}
              aria-haspopup={n.sub ? 'true' : undefined}
              aria-expanded={n.sub ? 'false' : undefined}
            >
              {n.ico && <span class="cs-nav__emoji">{n.ico}</span>}
              {n.t.toUpperCase()}
              {n.sub && <Icono nombre="caret" size={16} />}
            </a>
            {n.sub && (
              <ul class="cs-drop">
                {n.sub.map((s: string) => (
                  <li>
                    <a href={n.href}>{etiquetaSub(s)}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const items = document.querySelectorAll<HTMLElement>('.tpl-cerrajero-seguridad .cs-nav__item.tiene-sub');

  const cerrarTodos = (excepto?: HTMLElement) => {
    items.forEach((it) => {
      if (it === excepto) return;
      it.classList.remove('is-abierto');
      it.querySelector('.cs-nav__link')?.setAttribute('aria-expanded', 'false');
    });
  };

  items.forEach((it) => {
    const link = it.querySelector<HTMLAnchorElement>('.cs-nav__link');
    it.addEventListener('mouseenter', () => {
      cerrarTodos(it);
      it.classList.add('is-abierto');
      link?.setAttribute('aria-expanded', 'true');
    });
    it.addEventListener('mouseleave', () => {
      it.classList.remove('is-abierto');
      link?.setAttribute('aria-expanded', 'false');
    });
    link?.addEventListener('click', (e) => {
      // primer click abre el desplegable; segundo navega al ancla
      if (!it.classList.contains('is-abierto')) {
        e.preventDefault();
        cerrarTodos(it);
        it.classList.add('is-abierto');
        link.setAttribute('aria-expanded', 'true');
      }
    });
    it.querySelectorAll('.cs-drop a').forEach((a) => a.addEventListener('click', () => cerrarTodos()));
  });

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement | null;
    if (!t?.closest('.cs-nav__item.tiene-sub')) cerrarTodos();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') cerrarTodos();
  });

  /* ---- buscador demo: filtra las tarjetas de producto ---- */
  const form = document.getElementById('cs-buscar') as HTMLFormElement | null;
  const q = document.getElementById('cs-buscar-q') as HTMLInputElement | null;
  const info = document.getElementById('cs-busqueda-info');

  const filtrar = (texto: string) => {
    const term = texto.trim().toLowerCase();
    const tarjetas = document.querySelectorAll<HTMLElement>('.tpl-cerrajero-seguridad [data-cs-nombre]');
    let n = 0;
    tarjetas.forEach((c) => {
      const ok = !term || (c.dataset.csNombre ?? '').includes(term);
      c.classList.toggle('cs-oculto-busqueda', !ok);
      if (ok) n++;
    });
    document.querySelectorAll<HTMLElement>('.tpl-cerrajero-seguridad [data-cs-fila]').forEach((f) => {
      const visibles = f.querySelectorAll('[data-cs-nombre]:not(.cs-oculto-busqueda)').length;
      f.classList.toggle('cs-oculto-busqueda', !!term && visibles === 0);
    });
    if (info) {
      info.hidden = !term;
      const span = info.querySelector('[data-cs-info-txt]');
      if (span) span.textContent = n ? `${n} resultado${n === 1 ? '' : 's'} para “${texto.trim()}”` : `Sin resultados para “${texto.trim()}”`;
    }
    return n;
  };

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    filtrar(q?.value ?? '');
    document.getElementById('cs-busqueda-info')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  q?.addEventListener('input', () => {
    if (!q.value.trim()) filtrar('');
  });
  document.getElementById('cs-busqueda-limpiar')?.addEventListener('click', () => {
    if (q) q.value = '';
    filtrar('');
  });
</script>

<style>
  .cs-hdr {
    position: sticky;
    top: 0;
    z-index: 300;
  }

  .cs-hdr__top {
    background: var(--cs-navy);
    color: #fff;
  }

  .cs-hdr__fila {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
    height: 72px;
  }

  /* logo tipo "placa" negra con filetes blancos, como el original */
  .cs-logo {
    display: inline-flex;
    flex-direction: column;
    align-items: stretch;
    background: #000;
    border: 2px solid #fff;
    outline: 2px solid #000;
    padding: 3px 10px 2px;
    line-height: 1;
  }

  .cs-logo__caja {
    font-family: var(--cs-display);
    font-size: 1.62rem;
    letter-spacing: 0.02em;
    color: #fff;
    text-align: center;
  }

  .cs-logo__sub {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.56rem;
    font-weight: 900;
    letter-spacing: 0.34em;
    color: #fff;
    margin-top: 3px;
  }

  .cs-logo__sub i {
    flex: 1;
    height: 2px;
    background: #fff;
  }

  .cs-buscar {
    justify-self: center;
    width: min(390px, 100%);
    display: flex;
    align-items: center;
    background: #fff;
    border-radius: 999px;
    height: 42px;
    padding-inline: 14px 18px;
    color: var(--cs-navy);
  }

  .cs-buscar__btn {
    display: grid;
    place-items: center;
    color: var(--cs-navy);
  }

  .cs-buscar input {
    flex: 1;
    border: 0;
    outline: 0;
    background: transparent;
    padding-left: 1.4rem;
    font-size: 0.93rem;
    color: var(--cs-texto);
    min-width: 0;
  }

  .cs-buscar input::placeholder {
    color: #6b7280;
  }

  .cs-buscar:focus-within {
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.55);
  }

  .cs-hdr__acc {
    display: flex;
    align-items: center;
    gap: 2.2rem;
  }

  .cs-hdr__icono {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .cs-hdr__icono:hover,
  .cs-hdr__carrito:hover {
    color: var(--cs-naranja);
  }

  .cs-hdr__carrito {
    position: relative;
    color: #fff;
    display: grid;
    place-items: center;
  }

  .cs-badge {
    position: absolute;
    top: -6px;
    right: -9px;
    min-width: 17px;
    height: 17px;
    padding-inline: 4px;
    border-radius: 999px;
    background: var(--cs-naranja);
    color: var(--cs-navy-2);
    font-size: 0.66rem;
    font-weight: 800;
    display: grid;
    place-items: center;
    transition: transform 0.2s ease;
  }

  .cs-badge.is-pulso {
    transform: scale(1.35);
  }

  /* --- barra de navegacion gris --- */
  .cs-nav {
    background: var(--cs-gris-nav);
  }

  .cs-nav__lista {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.4rem 1.9rem;
    height: 54px;
    list-style: none;
  }

  .cs-nav__item {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .cs-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--cs-navy-2);
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .cs-nav__link:hover,
  .cs-nav__item.is-abierto > .cs-nav__link:not(.is-destacado) {
    color: var(--cs-naranja-txt);
  }

  .cs-nav__link.is-destacado {
    background: var(--cs-naranja);
    border-radius: 999px;
    padding: 0.2rem 0.9rem 0.2rem 1.1rem;
    gap: 6px;
  }

  .cs-nav__link.is-destacado:hover {
    background: var(--cs-naranja-2);
    color: var(--cs-navy-2);
  }

  .cs-nav__emoji {
    font-size: 0.85rem;
  }

  .cs-drop {
    position: absolute;
    top: 100%;
    left: -12px;
    min-width: 250px;
    background: #fff;
    border-radius: 0 0 8px 8px;
    box-shadow: 0 16px 30px -14px rgba(21, 33, 46, 0.45);
    padding: 0.4rem 0;
    display: none;
    z-index: 5;
    border-top: 3px solid var(--cs-naranja);
  }

  .cs-nav__item.is-abierto .cs-drop {
    display: block;
  }

  .cs-drop a {
    display: block;
    padding: 0.55rem 1.1rem;
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--cs-navy);
    white-space: nowrap;
  }

  .cs-drop a:hover {
    background: var(--cs-hielo);
    color: var(--cs-naranja-txt);
  }

  @media (max-width: 1080px) {
    .cs-nav__lista {
      gap: 1.1rem;
    }
    .cs-nav__link {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 899px) {
    .cs-nav {
      display: none;
    }
    .cs-hdr__fila {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0.7rem;
      height: auto;
      padding-block: 0.8rem;
    }
    .cs-hdr__acc {
      display: none;
    }
    .cs-buscar {
      width: 100%;
      max-width: none;
    }
  }
</style>
