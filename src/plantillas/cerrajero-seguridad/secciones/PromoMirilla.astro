---
import { mirilla, img } from '../datos/tienda.js';
import Icono from '../componentes/Icono.astro';
---

<section class="cs-mir" aria-labelledby="cs-mir-t">
  <div class="cs-mir__caja">
    <div class="cs-mir__txt">
      <p class="cs-mir__kicker">{mirilla.kicker.toUpperCase()}</p>
      <h2 id="cs-mir-t" class="cs-mir__titulo">
        Sal de casa y <em>Vigila tu puerta desde el móvil</em> antes de que entren
      </h2>
      <p class="cs-mir__p">
        A diferencia de una alarma, con tu mirilla digital <b>sabes al instante si alguien ronda tu puerta</b> antes de
        que entren.<br />La primera medida de protección ante el intento de robo y okupación.
      </p>
      <ul class="cs-mir__lista">
        {
          mirilla.lista.map(([fuerte, resto]: string[]) => (
            <li>
              <span class="cs-mir__check" aria-hidden="true">
                <Icono nombre="check" size={13} />
              </span>
              <span>
                <b>{fuerte}</b>
                {resto}
              </span>
            </li>
          ))
        }
      </ul>
      <div class="cs-mir__cta">
        <a href="#destacado" class="cs-btn cs-btn--navy">Vigila tu casa este otoño →</a>
        <span class="cs-mir__envio">🚚 Envío gratis 24h</span>
      </div>
    </div>

    <figure class="cs-mir__media">
      <div class="cs-mir__pantalla">
        <img src={img('cerraduraSmart', 900, 640)} alt="Cerradura inteligente controlada desde el móvil" loading="eager" />
      </div>
      <figcaption class="cs-mir__alerta">
        <span class="cs-mir__punto" aria-hidden="true"></span>
        Alguien en tu puerta
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .cs-mir {
    padding: 20px 10px 0;
    background: #fff;
  }

  .cs-mir__caja {
    background: var(--cs-crema);
    border: 1px solid var(--cs-crema-borde);
    border-radius: 16px;
    box-shadow: 0 10px 30px -22px rgba(21, 33, 46, 0.35);
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    align-items: center;
    gap: 2.5rem;
    padding: 2.4rem clamp(1.2rem, 9vw, 130px);
    max-width: 1420px;
    margin-inline: auto;
  }

  .cs-mir__kicker {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.28em;
    color: var(--cs-naranja-txt);
    margin-bottom: 0.9rem;
  }

  .cs-mir__titulo {
    font-weight: 900;
    color: var(--cs-navy);
    font-size: clamp(1.55rem, 2.4vw, 1.95rem);
    line-height: 1.2;
    margin-bottom: 1.1rem;
  }

  .cs-mir__titulo em {
    color: var(--cs-naranja-2);
    font-style: italic;
  }

  .cs-mir__p {
    color: #243447;
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 1.2rem;
  }

  .cs-mir__p b {
    color: var(--cs-navy);
    font-weight: 800;
  }

  .cs-mir__lista {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-bottom: 1.6rem;
    font-size: 0.92rem;
    color: #243447;
  }

  .cs-mir__lista li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .cs-mir__lista b {
    color: var(--cs-navy);
    font-weight: 800;
  }

  .cs-mir__check {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--cs-naranja-2);
    color: #fff;
    display: grid;
    place-items: center;
  }

  .cs-mir__cta {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    flex-wrap: wrap;
  }

  .cs-mir__envio {
    font-size: 0.85rem;
    font-weight: 700;
    color: #4b5563;
  }

  /* media: foto dentro de un marco tipo "pantalla" negra, como el monitor de la mirilla */
  .cs-mir__media {
    position: relative;
    justify-self: center;
    width: min(440px, 100%);
    margin: 0;
  }

  .cs-mir__pantalla {
    background: #111;
    border-radius: 14px;
    padding: 12px;
    box-shadow: 0 24px 40px -22px rgba(0, 0, 0, 0.55);
  }

  .cs-mir__pantalla img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 6px;
  }

  .cs-mir__alerta {
    position: absolute;
    top: 6px;
    right: -26px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--cs-navy);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    box-shadow: 0 10px 20px -10px rgba(0, 0, 0, 0.5);
  }

  .cs-mir__punto {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #e11d48;
    animation: cs-latido 1.4s ease-in-out infinite;
  }

  @keyframes cs-latido {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cs-mir__punto {
      animation: none;
    }
  }

  @media (max-width: 860px) {
    .cs-mir__caja {
      grid-template-columns: 1fr;
      padding: 1.4rem 1.2rem 1.6rem;
      gap: 1.6rem;
    }
    .cs-mir__media {
      order: -1;
    }
    .cs-mir__alerta {
      right: 8px;
    }
    .cs-mir__cta .cs-btn {
      width: 100%;
    }
  }
</style>
