---
import { protecciones } from '../datos/tienda.js';
import IconoProteccion from '../componentes/IconoProteccion.astro';
import Icono from '../componentes/Icono.astro';
---

<section class="cs-prot" aria-labelledby="cs-prot-t">
  <div class="cs-wrap">
    <header class="cs-centro">
      <h2 id="cs-prot-t" class="cs-prot__titulo">SEGURIDAD al MÁXIMO NIVEL</h2>
      <p class="cs-sub">Todos nuestros bombines disponen de protecciones contra los últimos métodos de robo</p>
      <p class="cs-prot__pill">PROTECCIONES INCLUIDAS</p>
    </header>

    <ul class="cs-prot__grid">
      {
        protecciones.map((p: { id: string; t: string }) => (
          <li class="cs-prot__card">
            <IconoProteccion id={p.id} />
            <span>{p.t}</span>
          </li>
        ))
      }
    </ul>

    <div class="cs-instala">
      <p class="cs-instala__txt">
        <b>Instálalo tú</b> <em>y ahórrate el dinero del cerrajero</em>
      </p>
      <ul class="cs-instala__chips">
        <li>✓ Kits completos</li>
        <li>✓ En 15 minutos</li>
        <li class="is-on">✓ Sin ser manitas</li>
      </ul>
      <div class="cs-instala__acc">
        <button type="button" class="cs-instala__yt" id="cs-ahorro-toggle" aria-expanded="false" aria-controls="cs-ahorro">
          <span class="cs-instala__ytico"><Icono nombre="youtube" size={30} /></span>
          Ver tutoriales
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .cs-prot {
    padding: 3.4rem 0 1.5rem;
    background: #fff;
  }

  .cs-prot__titulo {
    font-weight: 400;
    color: var(--cs-navy);
    font-size: clamp(1.4rem, 2.6vw, 1.75rem);
  }

  .cs-prot__pill {
    display: inline-block;
    margin-top: 1.4rem;
    background: #dbeafe;
    color: #1d4f86;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.35rem 0.8rem;
    border-radius: 3px;
  }

  .cs-prot__grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 10px;
    margin-top: 1.4rem;
  }

  .cs-prot__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.8rem 0.4rem 1rem;
    border: 1px solid var(--cs-linea);
    border-radius: 3px;
    background: #fff;
    font-size: 0.85rem;
    color: var(--cs-navy);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .cs-prot__card:hover {
    border-color: #9fb7d3;
    box-shadow: 0 0 0 1px #9fb7d3, 0 10px 18px -14px rgba(25, 51, 79, 0.6);
    transform: translateY(-2px);
  }

  .cs-prot__card :global(svg) {
    width: 100%;
    max-width: 84px;
    height: auto;
  }

  /* franja "Instálalo tú" */
  .cs-instala {
    margin-top: 2.6rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    background: var(--cs-crema);
    border: 1px solid var(--cs-crema-borde);
    border-left: 4px solid var(--cs-navy);
    border-radius: 6px;
    padding: 0.9rem 1.4rem;
  }

  .cs-instala__txt {
    font-size: 1.12rem;
    color: var(--cs-navy);
  }

  .cs-instala__txt b {
    font-weight: 900;
  }

  .cs-instala__txt em {
    font-weight: 800;
    color: var(--cs-naranja-2);
  }

  .cs-instala__chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .cs-instala__chips li {
    padding: 0.4rem 0.8rem;
    border: 1px solid #d6d3c4;
    background: #fff;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--cs-navy);
  }

  .cs-instala__chips li.is-on {
    background: var(--cs-naranja);
    border-color: var(--cs-naranja);
  }

  .cs-instala__acc {
    margin-left: auto;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .cs-instala__yt {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--cs-navy);
  }

  .cs-instala__ytico {
    color: #e10600;
    display: grid;
  }

  @media (max-width: 900px) {
    .cs-prot__grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .cs-instala__acc {
      margin-left: 0;
    }
  }

  @media (max-width: 420px) {
    .cs-prot__grid {
      gap: 6px;
    }
    .cs-prot__card {
      font-size: 0.72rem;
    }
  }
</style>
