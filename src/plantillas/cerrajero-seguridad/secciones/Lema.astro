---
import { lema } from '../datos/tienda.js';
---

<!-- Banner navy del original: lema a la izquierda, pastilla + lista a la derecha
     (no es un hero de foto a sangre: es una banda de color solido de ~190px) -->
<section class="cs-lema" aria-label="Nuestra filosofía">
  <div class="cs-wrap cs-lema__grid">
    <h1 class="cs-lema__titulo">
      <span>{lema.a}</span>
      <span>{lema.b}</span>
    </h1>
    <div class="cs-lema__der">
      <p class="cs-lema__pill">{lema.pill.toUpperCase()}</p>
      <ul>
        {
          lema.lineas.map((l: { ico: string; t: string }) => (
            <li>
              {l.ico && <span aria-hidden="true">{l.ico}</span>}
              {l.t}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .cs-lema {
    background: var(--cs-navy);
    color: #fff;
  }

  .cs-lema__grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: 2rem;
    min-height: 188px;
    padding-block: 1.6rem;
  }

  .cs-lema__titulo {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-weight: 400;
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    line-height: 1.3;
    text-align: center;
  }

  .cs-lema__titulo span:first-child {
    color: var(--cs-naranja);
  }

  .cs-lema__der {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .cs-lema__pill {
    background: #1d4466;
    border: 1px solid #2a5a82;
    padding: 0.45rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .cs-lema__der ul {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 1.05rem;
  }

  .cs-lema__der li span {
    margin-right: 0.35rem;
  }

  @media (max-width: 760px) {
    .cs-lema__grid {
      grid-template-columns: 1fr;
      gap: 1.2rem;
      padding-block: 2rem 1.8rem;
    }
    .cs-lema__der ul {
      font-size: 0.98rem;
    }
  }
</style>
