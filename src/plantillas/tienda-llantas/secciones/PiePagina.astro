---
import { marca, navPrincipal, footerLegal, tiendas } from '../datos/llantas.js';

interface Link { t: string; href: string }
---

<footer class="ll-pie" id="encuentranos">
  <div class="ll-wrap ll-pie__grid">
    <div class="ll-pie__marca">
      <a href="#top" class="ll-pie__logo">
        <svg viewBox="0 0 40 40" aria-hidden="true">
          <circle cx="20" cy="20" r="16" fill="none" stroke="currentColor" stroke-width="6" stroke-dasharray="5 2.5"></circle>
          <circle cx="20" cy="20" r="6" fill="currentColor"></circle>
        </svg>
        <span>tienda.com</span>
      </a>
      <p>{marca.descripcion}</p>
      <div class="ll-pie__redes" aria-label="Redes sociales">
        <a href="#" aria-label="Facebook">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M14 8V6.5c0-.8.2-1.3 1.4-1.3H17V2.2C16.7 2.1 15.7 2 14.6 2 12.2 2 10.6 3.5 10.6 6.1V8H8v3.3h2.6V22H14V11.3h2.7L17 8z"></path></svg>
        </a>
        <a href="#" aria-label="Instagram">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle></svg>
        </a>
        <a href="#" aria-label="TikTok">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 3c.3 2.2 1.6 3.6 3.8 3.8v3a7 7 0 0 1-3.8-1.2v6.2A5.8 5.8 0 1 1 10.7 9v3.1a2.7 2.7 0 1 0 2.7 2.7V3z"></path></svg>
        </a>
      </div>
    </div>

    <nav class="ll-pie__col" aria-label="Navegacion del pie">
      <h3>Navegacion</h3>
      {navPrincipal.map((n: Link) => <a href={n.href}>{n.t}</a>)}
    </nav>

    <div class="ll-pie__col">
      <h3>Legal</h3>
      {footerLegal.map((t: string) => <a href="#">{t}</a>)}
      <a href="#" class="ll-pie__libro">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 5c3-1.5 7-1.5 10 1 3-2.5 7-2.5 10-1v14c-3-1.5-7-1.5-10 1-3-2.5-7-2.5-10-1z"></path><path d="M12 6v14"></path></svg>
        <span>Libro de<br />reclamaciones</span>
      </a>
    </div>

    <div class="ll-pie__col ll-pie__contacto">
      <h3>Contactanos</h3>
      <p><svg viewBox="0 0 24 24"><rect x="7" y="2" width="10" height="20" rx="2"></rect><path d="M11 18h2"></path></svg>{marca.tel}</p>
      <p><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>{marca.correo}</p>
      <p><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>{marca.horario}</p>

      <h3 class="ll-pie__h-tiendas">Nuestras tiendas</h3>
      {tiendas.map((t: string) => (
        <p><svg viewBox="0 0 24 24"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>{t}</p>
      ))}
    </div>
  </div>

  <div class="ll-pie__base">
    <div class="ll-wrap">
      © 2026 tienda.com Llantas · Maqueta demo. Todos los derechos reservados.
    </div>
  </div>
</footer>

<style>
  .ll-pie {
    background: var(--ll-negro);
    color: #fff;
    border-top: 1px solid var(--ll-linea-osc);
  }

  .ll-pie__grid {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 1fr 1.3fr;
    gap: 2rem;
    padding-block: 3.5rem 3rem;
  }

  .ll-pie__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--ll-titulos);
    font-style: italic;
    font-weight: 800;
    font-size: 1.55rem;
    text-transform: uppercase;
  }

  .ll-pie__logo svg {
    width: 28px;
    height: 28px;
    color: var(--ll-rojo);
  }

  .ll-pie__marca p {
    margin-top: 1rem;
    font-size: 0.84rem;
    max-width: 34ch;
    color: rgba(255, 255, 255, 0.85);
  }

  .ll-pie__redes {
    display: flex;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .ll-pie__redes a:hover {
    color: var(--ll-rojo);
  }

  .ll-pie__col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.82rem;
  }

  .ll-pie__col h3 {
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .ll-pie__col > a {
    color: rgba(255, 255, 255, 0.85);
    width: fit-content;
  }

  .ll-pie__col > a:hover {
    color: var(--ll-rojo);
  }

  .ll-pie__col:nth-child(2) a {
    text-transform: uppercase;
  }

  .ll-pie__col > a.ll-pie__libro {
    margin-top: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #fff;
    color: var(--ll-negro);
    border-radius: 6px;
    padding: 0.45rem 0.7rem;
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .ll-pie__contacto p {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .ll-pie__contacto svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 2px;
    fill: none;
    stroke: var(--ll-rojo);
    stroke-width: 2;
  }

  .ll-pie__h-tiendas {
    margin-top: 0.9rem;
  }

  .ll-pie__base {
    border-top: 1px solid var(--ll-linea-osc);
    padding-block: 1.1rem;
    font-size: 0.74rem;
    color: rgba(255, 255, 255, 0.6);
  }

  @media (max-width: 960px) {
    .ll-pie__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 540px) {
    .ll-pie__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
