---
import './estilos.css';

import Cabecera from './secciones/Cabecera.astro';
import HeroCarrusel from './secciones/HeroCarrusel.astro';
import BuscadorMedida from './secciones/BuscadorMedida.astro';
import TiposVehiculo from './secciones/TiposVehiculo.astro';
import Marcas from './secciones/Marcas.astro';
import Destacados from './secciones/Destacados.astro';
import Catalogo from './secciones/Catalogo.astro';
import Servicios from './secciones/Servicios.astro';
import Nosotros from './secciones/Nosotros.astro';
import Delivery from './secciones/Delivery.astro';
import PiePagina from './secciones/PiePagina.astro';
import ChatBot from './secciones/ChatBot.astro';
---

<div class="tpl-tienda-llantas">
  <Cabecera />
  <main>
    <HeroCarrusel />
    <BuscadorMedida />
    <TiposVehiculo />
    <Marcas />
    <Destacados />
    <Catalogo />
    <Servicios />
    <Nosotros />
    <Delivery />
  </main>
  <PiePagina />
  <ChatBot />
</div>
