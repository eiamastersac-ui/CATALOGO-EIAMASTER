---
// Escudo + marca "tienda.com / FÚTBOL". Variante clara para fondos oscuros.
interface Props {
  claro?: boolean;
  grande?: boolean;
}
const { claro = false, grande = false } = Astro.props as Props;
---

<span class:list={['tf-logo', { 'tf-logo--claro': claro, 'tf-logo--grande': grande }]}>
  <svg class="tf-logo__escudo" viewBox="0 0 40 46" aria-hidden="true">
    <path d="M3 3h34v21c0 10-7.6 16.7-17 19.5C10.6 40.7 3 34 3 24Z" fill="var(--tf-escudo-fondo)" stroke="var(--tf-escudo-linea)" stroke-width="3" stroke-linejoin="round"></path>
    <path d="M7.5 7h5v15h-5ZM15 7h4.5v15H15Zm6.5 0H26v15h-4.5ZM28 7h4.5v15H28Z" fill="#20a057"></path>
    <circle cx="20" cy="30.5" r="8.2" fill="var(--tf-escudo-fondo)" stroke="var(--tf-escudo-linea)" stroke-width="2"></circle>
    <path d="M20 27l3.3 2.4-1.3 3.9h-4l-1.3-3.9Z" fill="var(--tf-escudo-linea)"></path>
    <path d="M20 27v-4.4M23.3 29.4l4.4-1.2M22 33.3l2.6 3.6M18 33.3l-2.6 3.6M16.7 29.4l-4.4-1.2" stroke="var(--tf-escudo-linea)" stroke-width="1.6"></path>
  </svg>
  <span class="tf-logo__txt">
    <b>tienda.com</b>
    <small>FÚTBOL</small>
  </span>
</span>
