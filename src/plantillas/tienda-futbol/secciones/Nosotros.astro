---
import { nosotros, IMG, u, marca } from '../datos/escuela.js';
---

<section class="tf-seccion tf-nos" id="nosotros">
  <div class="tf-wrap tf-nos__grid">
    <figure class="tf-nos__foto tf-reveal">
      <span class="tf-nos__palabra" aria-hidden="true">FÚTBOL</span>
      <img src={u(IMG.plantel, 900, 560)} alt="Plantel formativo con su entrenador" loading="lazy" width="900" height="560" />
      <figcaption>Desde {marca.fundada}</figcaption>
    </figure>

    <div class="tf-nos__texto tf-reveal">
      <h2>{nosotros.titulo}</h2>
      <p>{nosotros.texto}</p>
      <a href="#cursos" class="tf-btn">{nosotros.boton}</a>
    </div>
  </div>
</section>

<style>
  .tf-nos__grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 70px;
    align-items: center;
    max-width: 980px;
  }

  .tf-nos__foto {
    position: relative;
    text-align: center;
  }

  .tf-nos__palabra {
    display: block;
    font-family: var(--tf-display);
    font-weight: 800;
    font-size: clamp(4.2rem, 9vw, 6.6rem);
    line-height: 0.85;
    letter-spacing: -0.02em;
    color: var(--tf-tinta);
    position: relative;
    z-index: 0;
  }

  .tf-nos__foto img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto; /* anula el alto del atributo height */
    aspect-ratio: 16 / 10;
    object-fit: cover;
    margin-top: -30px;
    filter: grayscale(1) contrast(1.08);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 22%, #000 88%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 22%, #000 88%, transparent 100%);
  }

  .tf-nos__foto figcaption {
    font-family: var(--tf-display);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--tf-verde);
    margin-top: 6px;
  }

  .tf-nos__texto h2 {
    font-size: clamp(1.9rem, 3vw, 2.2rem);
    color: var(--tf-verde);
    margin-bottom: 18px;
  }

  .tf-nos__texto p {
    text-align: justify;
    color: var(--tf-bosque);
    margin-bottom: 26px;
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .tf-nos__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .tf-nos__texto {
      text-align: center;
    }
    .tf-nos__texto p {
      text-align: left;
    }
  }
</style>
