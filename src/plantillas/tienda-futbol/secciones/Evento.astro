---
import { evento, u, marca } from '../datos/escuela.js';
---

<section class="tf-evento" id="eventos">
  <h2 class="tf-titulo tf-evento__cab tf-reveal">Ultimo <em>evento</em></h2>

  <div class="tf-evento__banda">
    <img src={u(evento.img, 2000, 800)} alt="" loading="lazy" class="tf-evento__img" />
    <div class="tf-evento__velo"></div>
    <div class="tf-wrap tf-evento__contenido tf-reveal">
      <h3>{evento.titulo}</h3>
      <p class="tf-evento__dirigido">DIRIGIDO A:</p>
      <ul>
        {evento.dirigido.map((d: string) => <li>{d}</li>)}
      </ul>
      <a class="tf-btn" href={marca.whatsapp} target="_blank" rel="noopener">Más información</a>
    </div>
  </div>
</section>

<style>
  .tf-evento {
    scroll-margin-top: var(--tf-hdr-h);
  }

  .tf-evento__cab {
    padding: 60px 20px 30px;
  }

  .tf-evento__banda {
    position: relative;
    overflow: hidden;
    background: var(--tf-tinta);
  }

  .tf-evento__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  /* Velo tinta -> verde bosque del banner real (deja ver la luz del estadio) */
  .tf-evento__velo {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(4, 29, 27, 0.9) 0%, rgba(4, 29, 27, 0.62) 45%, rgba(10, 63, 29, 0.38) 100%);
  }

  .tf-evento__contenido {
    position: relative;
    padding-top: 58px;
    padding-bottom: 46px;
    color: var(--tf-blanco);
  }

  .tf-evento__contenido h3 {
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    color: var(--tf-blanco);
    margin-bottom: 18px;
  }

  .tf-evento__dirigido {
    font-family: var(--tf-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--tf-verde);
    margin-bottom: 18px;
  }

  .tf-evento__contenido ul {
    list-style: disc;
    padding-left: 40px;
    margin-bottom: 30px;
  }

  .tf-evento__contenido li {
    font-size: 0.98rem;
    line-height: 1.5;
    margin-bottom: 4px;
  }

  @media (max-width: 640px) {
    .tf-evento__cab {
      padding-top: 48px;
    }
    .tf-evento__contenido ul {
      padding-left: 20px;
    }
  }
</style>
