    border-radius: 8px;
    padding: 1rem 1.1rem 0.9rem;
    text-align: center;
    font-size: 0.74rem;
    line-height: 1.45;
    color: var(--pc-texto);
  }

  .pc-cookies a {
    font-weight: 700;
    text-decoration: underline;
  }

  .pc-cookies__acc {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.8rem;
  }

  .pc-cookies__acc button {
    padding: 0.3rem 1.3rem;
    border: 1px solid var(--pc-tinta);
    border-radius: 999px;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .pc-cookies__acc button:hover {
    background: var(--pc-tinta);
    color: #fff;
  }

  @media (max-width: 520px) {
