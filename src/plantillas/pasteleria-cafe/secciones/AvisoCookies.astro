<!-- aviso de cookies como el del original (esquina inferior izquierda). Demo:
     solo se oculta, no guarda nada. -->
<div class="pc-cookies" id="pc-cookies" role="region" aria-label="Aviso de cookies">
  <p>
    Para brindarle una experiencia de compra personalizada, nuestro sitio utiliza cookies.
    Al continuar usando este sitio, usted acepta nuestra <a href="#pie">política de cookies.</a>
  </p>
  <div class="pc-cookies__acc">
    <button type="button" data-cookies>Rechazar</button>
    <button type="button" data-cookies>Aceptar</button>
  </div>
</div>

<script>
  const aviso = document.getElementById('pc-cookies');
  aviso?.querySelectorAll('[data-cookies]').forEach((b) =>
    b.addEventListener('click', () => {
      if (aviso) aviso.hidden = true;
    }),
  );
</script>

<style>
