---
import Icono from '../componentes/Icono.astro';
---

<!-- widget flotante de WhatsApp (en el original abre una burbuja "Hola ¿En que podemos ayudarte?") -->
<div class="pc-wa">
  <div class="pc-wa__panel" id="pc-wa-panel" hidden>
    <div class="pc-wa__cab">
      <span><Icono nombre="whatsapp" size={20} /> WhatsApp</span>
      <button type="button" id="pc-wa-cerrar" aria-label="Cerrar chat"><Icono nombre="cerrar" size={14} grosor={2.4} /></button>
    </div>
    <div class="pc-wa__cuerpo">
      <p class="pc-wa__burbuja">Hola<br />¿En qué podemos ayudarte?</p>
    </div>
    <div class="pc-wa__pie">
      <a href="#top" class="pc-wa__abrir" id="pc-wa-abrir">Abrir chat <Icono nombre="enviar" size={18} /></a>
    </div>
  </div>
  <button type="button" class="pc-wa__btn" id="pc-wa-btn" aria-label="Chatear por WhatsApp" aria-expanded="false" aria-controls="pc-wa-panel">
    <Icono nombre="whatsapp" size={30} />
  </button>
</div>

<script>
  const panel = document.getElementById('pc-wa-panel');
  const btn = document.getElementById('pc-wa-btn');
  const toggle = (ver: boolean) => {
    if (!panel) return;
    panel.hidden = !ver;
    btn?.setAttribute('aria-expanded', String(ver));
  };
  btn?.addEventListener('click', () => toggle(!!panel?.hidden));
  document.getElementById('pc-wa-cerrar')?.addEventListener('click', () => toggle(false));
  document.getElementById('pc-wa-abrir')?.addEventListener('click', (e: MouseEvent) => {
    e.preventDefault();
    toggle(false);
    document.dispatchEvent(new CustomEvent('pc:toast', { detail: { txt: 'Demo: aquí se abriría WhatsApp con la tienda.' } }));
  });
</script>

<style>
  .pc-wa {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 250;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }

  .pc-wa__btn {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: var(--pc-wa);
    color: #fff;
    display: grid;
    place-items: center;
    box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.45);
    transition: transform 0.2s ease;
  }

  .pc-wa__btn:hover {
    transform: scale(1.06);
  }

  .pc-wa__btn :global(svg path:last-child) {
    fill: var(--pc-wa);
  }

  .pc-wa__panel {
    width: min(320px, calc(100vw - 32px));
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 18px 44px -16px rgba(0, 0, 0, 0.45);
    animation: pc-wa-in 0.25s ease;
  }

  @keyframes pc-wa-in {
    from { opacity: 0; transform: translateY(10px); }
  }

  .pc-wa__cab {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--pc-wa);
    color: #fff;
    padding: 0.7rem 0.9rem;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .pc-wa__cab span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .pc-wa__cab span :global(svg path:last-child) {
    fill: var(--pc-wa);
  }

  .pc-wa__cab button {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.18);
    color: #fff;
    display: grid;
    place-items: center;
  }

  .pc-wa__cuerpo {
    padding: 1.2rem 1rem;
    background: #f7f5f2;
  }

  .pc-wa__burbuja {
    display: inline-block;
    background: #fff;
    border-radius: 0 12px 12px 12px;
    padding: 0.7rem 0.9rem;
    font-size: 0.85rem;
    box-shadow: 0 2px 8px -4px rgba(0, 0, 0, 0.25);
  }

  .pc-wa__pie {
    padding: 0.8rem 1rem;
    display: flex;
    justify-content: flex-end;
  }

  .pc-wa__abrir {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--pc-wa);
    color: #fff;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .pc-wa {
      right: 16px;
      bottom: 16px;
    }
  }
</style>
