---
import { marca, nav, categoriasMenu, busquedasPopulares } from '../datos/pasteleria.js';
import Icono from '../componentes/Icono.astro';

interface NavItem { t: string; href: string; icono: string; activo?: boolean }
interface CatItem { t: string; icono?: string; tab: string }
const items = nav as NavItem[];
const cats = categoriasMenu as CatItem[];
---

<header class="pc-hdr" id="pc-cabecera">
  <div class="pc-hdr__top">
    <div class="pc-wrap pc-hdr__row">
      <button type="button" class="pc-hdr__burger" id="pc-burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="pc-movil">
        <Icono nombre="menu" size={24} grosor={2} />
      </button>

      <a href="#top" class="pc-logo" aria-label={`${marca.nombre} ${marca.sub} — inicio`}>
        <span>{marca.nombre}</span>
        <span>{marca.sub.toLowerCase()}</span>
      </a>

      <form class="pc-buscar" id="pc-buscar" role="search" autocomplete="off">
        <input type="search" id="pc-buscar-input" placeholder="Buscar productos..." aria-label="Buscar productos" />
        <button type="submit" aria-label="Buscar"><Icono nombre="buscar" size={20} grosor={1.5} /></button>
        <div class="pc-buscar__pop" id="pc-buscar-pop" hidden>
          <p>Búsquedas populares:</p>
          <div>
            {busquedasPopulares.map((b: string) => (
              <button type="button" class="pc-buscar__chip" data-q={b}>{b}</button>
            ))}
          </div>
        </div>
      </form>

      <div class="pc-acc">
        <button type="button" class="pc-acc__btn pc-acc__lupa" id="pc-lupa" aria-label="Buscar" aria-expanded="false">
          <Icono nombre="buscar" size={23} grosor={1.5} />
        </button>
        <button type="button" class="pc-acc__btn" id="pc-abrir-carrito" aria-label="Abrir carrito">
          <span class="pc-acc__ico">
            <Icono nombre="carrito" size={27} grosor={1.4} />
            <b class="pc-acc__badge" data-badge="carrito" hidden>0</b>
          </span>
          <span class="pc-acc__txt">Carrito</span>
        </button>
        <button type="button" class="pc-acc__btn" id="pc-ver-favs" aria-label="Ver favoritos">
          <span class="pc-acc__ico">
            <Icono nombre="corazon" size={27} grosor={1.4} />
            <b class="pc-acc__badge" data-badge="favs" hidden>0</b>
          </span>
          <span class="pc-acc__txt">Favoritos</span>
        </button>
      </div>
    </div>
  </div>

  <div class="pc-hdr__nav" id="pc-movil">
    <div class="pc-wrap pc-hdr__navrow">
      <div class="pc-cats">
        <button type="button" class="pc-cats__btn" id="pc-cats-btn" aria-expanded="false" aria-controls="pc-cats-panel">
          <Icono nombre="lista" size={16} grosor={1.8} />
          Nuestras categorías
        </button>
        <ul class="pc-cats__panel" id="pc-cats-panel" hidden>
          {cats.map((c: CatItem) => (
            <li>
              <a href="#recomendados" data-tab={c.tab}>
                <span class="pc-cats__ico"><Icono nombre={c.icono ?? 'asterisco'} size={14} /></span>
                {c.t}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <nav aria-label="Navegación principal">
        <ul class="pc-nav">
          {items.map((n: NavItem) => (
            <li>
              <a href={n.href} class={n.activo ? 'is-activo' : ''}>
                <span class="pc-nav__ico"><Icono nombre={n.icono} size={18} /></span>
                {n.t}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  const hdr = document.getElementById('pc-cabecera');
  const burger = document.getElementById('pc-burger');
  const movil = document.getElementById('pc-movil');
  const catsBtn = document.getElementById('pc-cats-btn');
  const catsPanel = document.getElementById('pc-cats-panel');
  const form = document.getElementById('pc-buscar') as HTMLFormElement | null;
  const input = document.getElementById('pc-buscar-input') as HTMLInputElement | null;
  const pop = document.getElementById('pc-buscar-pop');
  const lupa = document.getElementById('pc-lupa');

  const alScroll = () => hdr?.classList.toggle('is-scroll', window.scrollY > 10);
  window.addEventListener('scroll', alScroll, { passive: true });
  alScroll();

  /* --- menu movil --- */
  const cerrarMovil = () => {
    movil?.classList.remove('is-abierto');
    burger?.setAttribute('aria-expanded', 'false');
  };
  burger?.addEventListener('click', () => {
    const abierto = !!movil?.classList.toggle('is-abierto');
    burger.setAttribute('aria-expanded', String(abierto));
  });

  /* --- desplegable "Nuestras categorias" --- */
  const toggleCats = (abrir: boolean) => {
    if (!catsPanel) return;
    catsPanel.hidden = !abrir;
    catsBtn?.setAttribute('aria-expanded', String(abrir));
  };
  catsBtn?.addEventListener('click', (e: MouseEvent) => {
    e.stopPropagation();
    toggleCats(!!catsPanel?.hidden);
  });
  catsPanel?.querySelectorAll<HTMLAnchorElement>('a[data-tab]').forEach((a) =>
    a.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('pc:tab', { detail: { tab: a.dataset.tab } }));
      toggleCats(false);
      cerrarMovil();
    }),
  );
  movil?.querySelectorAll('.pc-nav a').forEach((a) => a.addEventListener('click', cerrarMovil));

  /* --- buscador: sugerencias + filtro del catalogo --- */
  const togglePop = (ver: boolean) => {
    if (pop) pop.hidden = !ver;
  };
  input?.addEventListener('focus', () => togglePop(true));
  pop?.querySelectorAll<HTMLButtonElement>('[data-q]').forEach((b) =>
    b.addEventListener('click', () => {
      if (input) input.value = b.dataset.q ?? '';
      form?.requestSubmit();
    }),
  );
  form?.addEventListener('submit', (e: SubmitEvent) => {
    e.preventDefault();
    document.dispatchEvent(new CustomEvent('pc:buscar', { detail: { q: input?.value.trim() ?? '' } }));
    togglePop(false);
    input?.blur();
    hdr?.classList.remove('is-buscando');
    lupa?.setAttribute('aria-expanded', 'false');
  });
  lupa?.addEventListener('click', () => {
    const abierto = !!hdr?.classList.toggle('is-buscando');
    lupa.setAttribute('aria-expanded', String(abierto));
    if (abierto) input?.focus();
  });

  /* --- carrito / favoritos: los maneja Carrito.astro y Catalogo.astro --- */
  document.getElementById('pc-abrir-carrito')?.addEventListener('click', () =>
    document.dispatchEvent(new CustomEvent('pc:abrir-carrito')),
  );
  document.getElementById('pc-ver-favs')?.addEventListener('click', () =>
    document.dispatchEvent(new CustomEvent('pc:ver-favs')),
  );

  /* badges */
  document.addEventListener('pc:badge', ((e: CustomEvent<{ tipo: string; n: number }>) => {
    const b = document.querySelector<HTMLElement>(`.tpl-pasteleria-cafe [data-badge="${e.detail.tipo}"]`);
    if (!b) return;
    b.textContent = String(e.detail.n);
    b.hidden = e.detail.n === 0;
    b.classList.remove('is-pop');
    void b.offsetWidth;
    b.classList.add('is-pop');
  }) as EventListener);

  /* cerrar con click afuera / Escape */
  document.addEventListener('click', (e: MouseEvent) => {
    const t = e.target as HTMLElement;
    if (!t.closest('.pc-cats')) toggleCats(false);
    if (!t.closest('.pc-buscar')) togglePop(false);
  });
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key !== 'Escape') return;
    toggleCats(false);
    togglePop(false);
    cerrarMovil();
  });
</script>

<style>
  .pc-hdr {
    position: sticky;
    top: 0;
    z-index: 200;
    background: var(--pc-blanco);
    transition: box-shadow 0.2s ease;
  }

  .pc-hdr.is-scroll {
    box-shadow: 0 6px 18px -14px rgba(0, 0, 0, 0.35);
  }

  .pc-hdr__top {
    border-bottom: 1px solid var(--pc-linea);
  }

  .pc-hdr__row {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 124px;
  }

  .pc-hdr__burger {
    display: none;
    width: 40px;
    height: 40px;
    place-items: center;
    color: var(--pc-tinta);
  }

  /* logo: wordmark coral en 2 lineas, como el del original */
  .pc-logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--pc-font);
    font-weight: 500;
    font-size: 2.45rem;
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: var(--pc-coral);
    flex-shrink: 0;
    width: 250px;
  }

  .pc-buscar {
    position: relative;
    flex: 1;
    max-width: 680px;
    margin-inline: auto;
  }

  .pc-buscar input {
    width: 100%;
    height: 44px;
    border: none;
    border-radius: 999px;
    background: var(--pc-panel);
    padding: 0 3rem 0 1.3rem;
    font-size: 0.86rem;
    outline: none;
  }

  .pc-buscar input::placeholder {
    color: var(--pc-gris);
  }

  .pc-buscar input:focus {
    box-shadow: 0 0 0 2px var(--pc-coral-suave);
  }

  .pc-buscar > button {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    color: var(--pc-tinta);
  }

  .pc-buscar__pop {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 8px);
    background: var(--pc-blanco);
    border-radius: 12px;
    box-shadow: 0 16px 40px -18px rgba(0, 0, 0, 0.35);
    padding: 1rem 1.1rem;
    z-index: 5;
  }

  .pc-buscar__pop p {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--pc-gris);
    margin-bottom: 0.6rem;
  }

  .pc-buscar__pop div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .pc-buscar__chip {
    font-size: 0.78rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--pc-linea);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .pc-buscar__chip:hover {
    border-color: var(--pc-coral);
    color: var(--pc-coral);
  }

  .pc-acc {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-shrink: 0;
  }

  .pc-acc__btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    color: var(--pc-tinta);
    font-size: 0.8rem;
    transition: color 0.2s ease;
  }

  .pc-acc__btn:hover {
    color: var(--pc-coral);
  }

  .pc-acc__lupa {
    display: none;
  }

  .pc-acc__ico {
    position: relative;
    display: grid;
  }

  .pc-acc__badge {
    position: absolute;
    top: -6px;
    right: -9px;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--pc-coral);
    color: #fff;
    font-size: 0.64rem;
    font-weight: 700;
    line-height: 17px;
    text-align: center;
  }

  .pc-acc__badge.is-pop {
    animation: pc-pop 0.35s ease;
  }

  @keyframes pc-pop {
    50% { transform: scale(1.35); }
  }

  /* --- fila 2: boton de categorias + menu --- */
  .pc-hdr__nav {
    border-bottom: 1px solid var(--pc-linea);
  }

  .pc-hdr__navrow {
    display: flex;
    align-items: center;
    gap: 2.4rem;
    min-height: 52px;
  }

  .pc-cats {
    position: relative;
  }

  .pc-cats__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    height: 52px;
    padding: 0 2rem;
    min-width: 280px;
    justify-content: center;
    background: var(--pc-coral);
    color: #fff;
    border-radius: 999px 999px 999px 999px;
    font-weight: 700;
    font-size: 0.86rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    transition: background 0.2s ease;
  }

  .pc-cats__btn:hover,
  .pc-cats__btn[aria-expanded="true"] {
    background: var(--pc-coral-osc);
  }

  .pc-cats__panel {
    position: absolute;
    top: calc(100% + 1px);
    left: 0;
    width: 500px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem 0.85rem;
    padding: 1.2rem 1.1rem;
    background: var(--pc-blanco);
    border: 1px solid var(--pc-linea);
    border-radius: 0 0 8px 8px;
    box-shadow: 0 18px 40px -22px rgba(0, 0, 0, 0.4);
    z-index: 10;
  }

  .pc-cats__panel a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--pc-linea);
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--pc-texto);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .pc-cats__panel a:hover {
    border-color: var(--pc-coral);
    color: var(--pc-coral);
  }

  .pc-cats__ico {
    color: var(--pc-coral);
    display: grid;
  }

  .pc-nav {
    display: flex;
    align-items: center;
    gap: 2.6rem;
  }

  .pc-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 0.86rem;
    text-transform: uppercase;
    color: var(--pc-tinta);
    padding-block: 0.6rem;
    transition: color 0.2s ease;
  }

  .pc-nav__ico {
    color: var(--pc-coral);
    display: grid;
  }

  .pc-nav a::after {
    content: "";
    position: absolute;
    left: 1.6rem;
    right: 0;
    bottom: 2px;
    height: 2px;
    border-radius: 2px;
    background: var(--pc-coral);
    transform: scaleX(0);
    transition: transform 0.2s ease;
  }

  .pc-nav a.is-activo::after,
  .pc-nav a:hover::after {
    transform: scaleX(1);
  }

  /* --- movil --- */
  @media (max-width: 900px) {
    .pc-hdr__row {
      min-height: 68px;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .pc-hdr__burger {
      display: grid;
      margin-left: -8px;
    }

    .pc-logo {
      font-size: 1.35rem;
      width: auto;
      margin-right: auto;
    }

    .pc-acc {
      gap: 0.7rem;
    }

    .pc-acc__lupa {
      display: flex;
    }

    .pc-acc__txt {
      display: none;
    }

    /* el buscador baja a su propia fila al tocar la lupa */
    .pc-buscar {
      display: none;
      order: 5;
      flex-basis: 100%;
      max-width: none;
      margin: 0 0 0.8rem;
    }

    .pc-hdr.is-buscando .pc-buscar {
      display: block;
    }

    .pc-buscar input {
      height: 42px;
      font-size: 16px;
    }

    .pc-hdr__nav {
      display: none;
      max-height: calc(100svh - 70px);
      overflow-y: auto;
    }

    .pc-hdr__nav.is-abierto {
      display: block;
    }

    .pc-hdr__navrow {
      flex-direction: column;
      align-items: stretch;
      gap: 0.4rem;
      padding-block: 1rem;
    }

    .pc-cats__btn {
      width: 100%;
    }

    .pc-cats__panel {
      position: static;
      width: auto;
      grid-template-columns: 1fr;
      box-shadow: none;
      border: none;
      padding: 0.8rem 0 0.4rem;
      gap: 0.5rem;
    }

    .pc-cats__panel a {
      padding: 0.65rem 0.8rem;
    }

    .pc-nav {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .pc-nav a {
      padding: 0.85rem 0.2rem;
      border-bottom: 1px solid var(--pc-linea);
      width: 100%;
    }

    .pc-nav a::after {
      display: none;
    }
  }
</style>
