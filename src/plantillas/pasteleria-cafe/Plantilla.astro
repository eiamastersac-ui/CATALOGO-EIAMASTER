---
import './estilos.css';

import Cabecera from './secciones/Cabecera.astro';
import Hero from './secciones/Hero.astro';
import Categorias from './secciones/Categorias.astro';
import Catalogo from './secciones/Catalogo.astro';
import Promos from './secciones/Promos.astro';
import Blog from './secciones/Blog.astro';
import PiePagina from './secciones/PiePagina.astro';
import Carrito from './secciones/Carrito.astro';
import WhatsApp from './secciones/WhatsApp.astro';
import AvisoCookies from './secciones/AvisoCookies.astro';
---

<div class="tpl-pasteleria-cafe">
  <span id="top"></span>
  <Cabecera />
  <main>
    <Hero />
    <Categorias />
    <Catalogo />
    <Promos />
    <Blog />
  </main>
  <PiePagina />
  <Carrito />
  <WhatsApp />
  <AvisoCookies />
</div>
