---
import './estilos.css';

import Cabecera from './secciones/Cabecera.astro';
import Hero from './secciones/Hero.astro';
import Intro from './secciones/Intro.astro';
import Servicios from './secciones/Servicios.astro';
import Confianza from './secciones/Confianza.astro';
import Tecnologia from './secciones/Tecnologia.astro';
import Marcas from './secciones/Marcas.astro';
import Cuando from './secciones/Cuando.astro';
import Riesgos from './secciones/Riesgos.astro';
import Repuestos from './secciones/Repuestos.astro';
import Noticias from './secciones/Noticias.astro';
import Vehiculos from './secciones/Vehiculos.astro';
import PiePagina from './secciones/PiePagina.astro';
import CitaModal from './secciones/CitaModal.astro';
import ChatWhatsapp from './secciones/ChatWhatsapp.astro';
---

<div class="tpl-taller-cedea">
  <Cabecera />
  <main>
    <Hero />
    <Intro />
    <Servicios />
    <Confianza />
    <Tecnologia />
    <Marcas />
    <Cuando />
    <Riesgos />
    <Repuestos />
    <Noticias />
