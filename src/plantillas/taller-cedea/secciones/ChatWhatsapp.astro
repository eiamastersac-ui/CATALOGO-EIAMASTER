---
import { marca } from '../datos/taller.js';
---

<div class="tc-wa" id="tc-wa">
  <section class="tc-wa__panel" id="tc-wa-panel" hidden aria-label="Chat con el taller">
    <header class="tc-wa__head">
      <span class="tc-wa__ava" aria-hidden="true">T</span>
      <div>
        <b>{marca.nombre} {marca.sub}</b>
        <small>Responde en minutos</small>
      </div>
      <button type="button" class="tc-wa__x" id="tc-wa-x" aria-label="Cerrar chat">&times;</button>
    </header>
    <div class="tc-wa__body" id="tc-wa-body">
      <p class="tc-chat__msg tc-chat__msg--bot">Hola, somos el taller de {marca.nombre}. ¿En qué te podemos ayudar hoy?</p>
    </div>
    <form class="tc-wa__form" id="tc-wa-form">
      <input type="text" id="tc-wa-input" placeholder="Escribe un mensaje" aria-label="Mensaje" autocomplete="off" />
      <button type="submit" aria-label="Enviar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M3 20.5 21 12 3 3.5 3 10l12 2-12 2z" /></svg>
      </button>
    </form>
    <p class="tc-wa__demo">Demo · respuestas automáticas</p>
  </section>

  <button type="button" class="tc-wa__toggle" id="tc-wa-toggle" aria-label="Abrir chat" aria-expanded="false">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3Z"/></svg>
  </button>
</div>

<script>
  import { chatCanned } from '../datos/taller.js';

  const panel = document.getElementById('tc-wa-panel');
  const toggle = document.getElementById('tc-wa-toggle');
  const cerrarBtn = document.getElementById('tc-wa-x');
  const body = document.getElementById('tc-wa-body');
  const form = document.getElementById('tc-wa-form');
  const input = document.getElementById('tc-wa-input') as HTMLInputElement | null;
  let paso = 0;

  function abrir(v: boolean) {
    if (!panel || !toggle) return;
    panel.hidden = !v;
    toggle.setAttribute('aria-expanded', String(v));
    if (v) input?.focus();
  }

  function push(texto: string, quien: 'bot' | 'yo') {
    if (!body) return;
    const p = document.createElement('p');
    p.className = `tc-chat__msg tc-chat__msg--${quien}`;
    p.textContent = texto;
    body.appendChild(p);
    body.scrollTop = body.scrollHeight;
  }

  toggle?.addEventListener('click', () => abrir(panel?.hidden ?? true));
  cerrarBtn?.addEventListener('click', () => abrir(false));

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.tpl-taller-cedea [data-wa]');
    if (!btn) return;
    abrir(true);
    if (input) input.value = btn.dataset.wa || '';
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const txt = (input?.value || '').trim();
    if (!txt) return;
    push(txt, 'yo');
    if (input) input.value = '';
    const resp = chatCanned[Math.min(paso, chatCanned.length - 1)];
    paso++;
    window.setTimeout(() => push(resp, 'bot'), 650);
  });
</script>

<style>
  .tc-wa {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 150;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }

  .tc-wa__toggle {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: var(--tc-acento);
    color: #fff;
    display: grid;
    place-items: center;
    box-shadow: 0 10px 24px -8px rgba(0, 0, 0, 0.45);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .tc-wa__toggle:hover {
    transform: scale(1.06);
    background: var(--tc-acento-osc);
  }

  .tc-wa__panel {
    width: min(340px, calc(100vw - 2.5rem));
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 24px 50px -20px rgba(0, 0, 0, 0.55);
    display: flex;
    flex-direction: column;
  }

  .tc-wa__panel[hidden] {
    display: none;
  }

  .tc-wa__head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    background: var(--tc-tinta);
    color: #fff;
    padding: 0.85rem 1rem;
  }

  .tc-wa__head div {
    display: grid;
    line-height: 1.25;
    flex: 1;
  }

  .tc-wa__head b {
    font-size: 0.9rem;
  }

  .tc-wa__head small {
    font-size: 0.72rem;
    opacity: 0.75;
  }

  .tc-wa__ava {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #fff;
    color: var(--tc-tinta);
    font-weight: 900;
    display: grid;
    place-items: center;
  }

  .tc-wa__x {
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
  }

  .tc-wa__body {
    height: 260px;
    overflow-y: auto;
    background: #ece8e1;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tc-wa__form {
    display: flex;
    gap: 0.5rem;
    padding: 0.6rem;
    border-top: 1px solid var(--tc-linea);
  }

  .tc-wa__form input {
    flex: 1;
    min-width: 0;
    border: 1px solid var(--tc-linea);
    border-radius: 999px;
    padding: 0.55rem 0.9rem;
    font-size: 0.87rem;
    outline: none;
  }

  .tc-wa__form button {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--tc-acento);
    color: #fff;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .tc-wa__demo {
    font-size: 0.68rem;
    text-align: center;
    color: var(--tc-suave);
    padding-bottom: 0.5rem;
  }
</style>
