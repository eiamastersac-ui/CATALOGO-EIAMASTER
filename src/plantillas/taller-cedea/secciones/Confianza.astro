---
import Acordeon from '../componentes/Acordeon.astro';
import { confianza } from '../datos/taller.js';
---

<section class="tc-seccion tc-conf" id="confianza">
  <div class="tc-wrap tc-conf__grid">
    <div>
      <h2 class="tc-titulo">
        {confianza.titulo[0]}<b>{confianza.titulo[1]}</b>{confianza.titulo[2]}
      </h2>
      <Acordeon items={confianza.items} id="tc-conf" />
    </div>

    <div class="tc-conf__media">
      <figure><img src={confianza.imgs[0]} alt="Sala de diagnóstico del taller" loading="lazy" /></figure>
      <figure><img src={confianza.imgs[1]} alt="Técnico trabajando en el taller" loading="lazy" /></figure>
      <a href="#contacto" class="tc-btn tc-btn--tinta">{confianza.cta}</a>
    </div>
  </div>
</section>

<style>
  .tc-conf__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .tc-conf .tc-titulo {
    margin-bottom: 1.5rem;
  }

  .tc-conf__media {
    display: grid;
    gap: 0.9rem;
    position: sticky;
    top: 96px;
  }

  .tc-conf__media figure {
    aspect-ratio: 16 / 10;
    border-radius: var(--tc-radio);
    overflow: hidden;
    background: var(--tc-papel);
  }

  .tc-conf__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tc-conf__media .tc-btn {
    justify-self: center;
  }

  @media (max-width: 860px) {
    .tc-conf__grid {
      grid-template-columns: 1fr;
    }

    .tc-conf__media {
      position: static;
      grid-template-columns: 1fr 1fr;
    }

    .tc-conf__media .tc-btn {
      grid-column: 1 / -1;
    }
  }
</style>
