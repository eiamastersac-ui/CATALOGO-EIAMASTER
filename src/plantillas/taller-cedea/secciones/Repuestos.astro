---
import { repuestos } from '../datos/taller.js';
---

<section class="tc-seccion tc-rep" id="repuestos">
  <div class="tc-wrap tc-rep__grid">
    <div class="tc-rep__tx">
      <span class="tc-kicker tc-rep__kicker">Almacén propio</span>
      <h2>{repuestos.titulo}</h2>
      <p>{repuestos.p1}</p>
      <p>{repuestos.p2}</p>
      <p>{repuestos.p3}</p>
      <ul class="tc-rep__chips">
        {repuestos.categorias.map((c: string) => <li>{c}</li>)}
      </ul>
    </div>

    <div class="tc-rep__media">
      <figure><img src={repuestos.img} alt="Repuestos de suspensión y piezas en almacén" loading="lazy" /></figure>
      <button type="button" class="tc-btn tc-btn--acento" data-wa="Hola, necesito cotizar un repuesto.">
        {repuestos.cta}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3Z"/></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .tc-rep {
    background: var(--tc-tinta);
    color: rgba(255, 255, 255, 0.86);
  }

  .tc-rep__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .tc-rep__tx {
    display: grid;
    gap: 1rem;
  }

  .tc-rep__kicker {
    color: rgba(255, 255, 255, 0.8);
  }

  .tc-rep h2 {
    color: #fff;
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
    font-weight: 700;
  }

  .tc-rep__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }

  .tc-rep__chips li {
    font-size: 0.8rem;
    font-weight: 500;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
  }

  .tc-rep__media {
    display: grid;
    gap: 1rem;
    justify-items: center;
  }

  .tc-rep__media figure {
    width: 100%;
    aspect-ratio: 4 / 3.2;
    border-radius: var(--tc-radio);
    overflow: hidden;
    background: var(--tc-tinta-2);
  }

  .tc-rep__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 860px) {
    .tc-rep__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
