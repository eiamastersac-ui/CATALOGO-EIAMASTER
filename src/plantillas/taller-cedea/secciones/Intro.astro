---
import { intro } from '../datos/taller.js';
---

<section class="tc-seccion tc-intro" id="taller">
  <div class="tc-wrap tc-intro__grid">
    <div class="tc-intro__tx">
      <span class="tc-kicker">{intro.kicker}</span>
      <h2 class="tc-titulo">{intro.titulo}</h2>
      <p>{intro.parrafo}</p>
      <ul class="tc-check tc-intro__lista">
        {intro.lista.map((l: string) => <li>{l}</li>)}
      </ul>
      <p>{intro.cierre}</p>
    </div>

    <div class="tc-intro__media">
      <figure class="tc-intro__foto tc-intro__foto--a">
        <img src={intro.imgs[0]} alt="Camioneta sobre elevador en el taller" loading="lazy" />
      </figure>
      <figure class="tc-intro__foto tc-intro__foto--b">
        <img src={intro.imgs[1]} alt="Área de trabajo del taller con herramientas" loading="lazy" />
      </figure>
      <button type="button" class="tc-btn tc-btn--tinta tc-intro__cta" data-cita>Agenda tu Servicio Mecánico</button>
    </div>
  </div>
</section>

<style>
  .tc-intro__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .tc-intro__tx {
    display: grid;
    gap: 1rem;
    color: var(--tc-texto);
  }

  .tc-intro__tx .tc-titulo {
    margin-bottom: 0;
  }

  .tc-intro__lista {
    padding: 0.4rem 0;
    font-weight: 500;
    color: var(--tc-tinta);
  }

  .tc-intro__media {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }

  .tc-intro__foto {
    border-radius: var(--tc-radio);
    overflow: hidden;
    background: var(--tc-papel);
  }

  .tc-intro__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tc-intro__foto--a {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 10;
  }

  .tc-intro__foto--b {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 8;
  }

  .tc-intro__cta {
    grid-column: 1 / -1;
    justify-self: center;
    margin-top: 0.4rem;
  }

  @media (max-width: 860px) {
    .tc-intro__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
