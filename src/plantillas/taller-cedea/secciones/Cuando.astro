---
import Acordeon from '../componentes/Acordeon.astro';
import { cuando } from '../datos/taller.js';
---

<section class="tc-seccion tc-cuando" id="cuando">
  <div class="tc-wrap tc-cuando__grid">
    <div>
      <h2 class="tc-titulo">{cuando.titulo[0]}<b>{cuando.titulo[1]}</b></h2>
      <p class="tc-cuando__intro">{cuando.texto}</p>
      <Acordeon items={cuando.items} id="tc-cuando" />
    </div>

    <div class="tc-cuando__media">
      <figure>
        <img src={cuando.img} alt="Manos de mecánico con herramientas" loading="lazy" />
        <figcaption>
          <b>Revisión de 30 puntos</b>
          <span>Frenos, dirección, fluidos, batería y escaneo electrónico.</span>
        </figcaption>
      </figure>
      <button type="button" class="tc-btn tc-btn--acento" data-cita>{cuando.cta}</button>
    </div>
  </div>
</section>

<style>
  .tc-cuando__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .tc-cuando__intro {
    color: var(--tc-suave);
    margin-bottom: 1.6rem;
  }

  .tc-cuando__media {
    display: grid;
    gap: 1rem;
    justify-items: center;
  }

  .tc-cuando__media figure {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3.4;
    border-radius: var(--tc-radio);
    overflow: hidden;
    background: var(--tc-papel);
  }

  .tc-cuando__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tc-cuando__media figcaption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    right: 1rem;
    max-width: 300px;
    background: #fff;
    border-left: 3px solid var(--tc-acento);
    border-radius: 4px;
    padding: 0.75rem 0.9rem;
    display: grid;
    gap: 0.15rem;
  }

  .tc-cuando__media figcaption b {
    color: var(--tc-tinta);
    font-size: 0.95rem;
  }

  .tc-cuando__media figcaption span {
    font-size: 0.8rem;
    color: var(--tc-suave);
    line-height: 1.4;
  }

  @media (max-width: 860px) {
    .tc-cuando__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
